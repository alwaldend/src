load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map", "al_terraform_test_map")

package(transitive_visibility = "//third_party:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//third_party/images:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_PROVIDERS = [
    "@terraform_provider_yandex_cloud_yandex//:provider",
]

_CONFIGS = ["//third_party:al"]

_DATA = glob(["*.tf"]) + [
    "//projects/tf_modules/tf_backend",
]

al_terraform_binary_map(
    name = "tf",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = {"tf": ""},
    providers = _PROVIDERS,
)

al_terraform_test_map(
    name = "tf_test",
    configs = _CONFIGS,
    data = _DATA,
    providers = _PROVIDERS,
)
