load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//third_party:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//third_party/images:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_terraform_package(
    name = "tf",
    configs = ["//third_party:al"],
    data = glob(["*.tf"]) + [
        "//projects/tf_modules/tf_backend",
    ],
    plugin_labels = {"tf": ""},
    providers = [
        "@terraform_provider_yandex_cloud_yandex//:provider",
    ],
    tests_name = "tf_test",
    tests_use_al = True,
)
