load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//third_party:transitive_consumers")

alias(
    name = "glab",
    actual = "@com_gitlab_gitlab_org_cli//:glab_binary",
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//third_party:__pkg__"],
)
