binary_toolchain_extension = use_extension(
    "@rules_binary_toolchain//main/bzl:binary_toolchain_extension.bzl",
    "binary_toolchain_extension",
)
binary_toolchain_extension.toolchains(
    archives = {
        "gitea": ["linux_x86_64"],
    },
    lock = "//third_party/com_gitea_gitea:binary_toolchain.json",
    toolchains_map = {
        "gitea": "com_gitea_gitea",
    },
)

register_toolchains(
    "@com_gitea_gitea//:all",
)

use_repo(
    binary_toolchain_extension,
    "com_gitea_gitea",
    "com_gitea_gitea_linux_x86_64",
)
