load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_al//:defs.bzl", "al_binary_run_map", "al_config", "al_plugin_call", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_yc_account", "infra_yc_auth", "infra_yc_bucket_auth")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//third_party:transitive_consumers")

# External toolchains and reusable build APIs also consume this tree.
package_group(
    name = "transitive_consumers",
    packages = ["public"],
)

al_vault_auth(
    name = "auth",
    approle = "src_third_party",
    extends = "//tools/al:auth",
)

al_plugin_call(
    name = "forgejo_login",
    labels = {"forgejo": "1"},
    plugin = "forgejo_login",
)

vault_tf_backend(
    name = "tf_backend_tf",
    labels = {"tf": "main"},
    path = "alwaldend.com/vault1/approles/src_third_party/tf_backend/tf",
)

infra_yc_bucket_auth(
    name = "yc_bucket_auth",
    labels = {
        "rclone": "1",
        "tf": "main",
    },
    path = "yandex.cloud/org1/folders/src-third-party/account_static_key",
)

infra_yc_auth(
    name = "yc_auth",
    labels = {"tf": "main"},
    path = "yandex.cloud/org1/folders/src-third-party/account_iam_key",
)

infra_yc_account(
    name = "yc_account",
    labels = {"tf": "main"},
    path = "yandex.cloud/org1/folders/src-third-party/account",
)

al_config(
    name = "al",
    configs = [
        ":auth",
        ":forgejo_login",
        ":tf_backend_tf",
        ":yc_account",
        ":yc_auth",
        ":yc_bucket_auth",
        "//infra:al",
    ],
    visibility = ["//third_party:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

write_file(
    name = "publish_helm_script",
    out = "publish_helm_script.sh",
    content = [
        "#!/usr/bin/env sh",
        "set -eu",
        'for chart in "${@}"; do',
        'echo "Uploading ${chart}" >&2',
        'curl -H "Authorization: Bearer ${FORGEJO_API_TOKEN}" --fail -X POST --upload-file "${1}" "${FORGEJO_HOST}/api/packages/alwaldend/helm/api/charts"',
        "done",
    ],
    is_executable = True,
)

al_binary_run_map(
    name = "publish_helm",
    args = {
        "io_goharbor_helm_harbor": [
            "$(rootpath publish_helm_script)",
            "$(rootpath //third_party/io_goharbor_helm_harbor)",
        ],
    },
    configs = [
        ":al",
    ],
    data = [
        ":publish_helm_script",
        "//third_party/io_goharbor_helm_harbor",
    ],
    plugin_labels = {"forgejo": ""},
)
