load("@rules_docs//docs:defs.bzl", "docs_filegroup")

exports_files([
    "Cargo.lock",
    "anki.BUILD.bazel",
    "native.bzl",
])

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//third_party:__pkg__"],
)

package_group(
    name = "native_build_consumers",
    packages = ["//projects/anki_grpc/cmd/anki_grpc"],
)

package_group(
    name = "schema_consumers",
    packages = [
        "//projects/anki_as_code/...",
        "//projects/anki_grpc/pkg/backend",
        "//projects/anki_grpc/test/transport",
    ],
)

alias(
    name = "protos",
    actual = "@com_github_ankitects_anki//:protos",
    visibility = [":schema_consumers"],
)

alias(
    name = "decks",
    actual = "@com_github_ankitects_anki//:decks",
    visibility = [":schema_consumers"],
)

alias(
    name = "notetypes",
    actual = "@com_github_ankitects_anki//:notetypes",
    visibility = [":schema_consumers"],
)

alias(
    name = "descriptors",
    actual = "@com_github_ankitects_anki//:descriptors",
    visibility = [":native_build_consumers"],
)

alias(
    name = "native",
    actual = "@com_github_ankitects_anki//:anki",
    visibility = [":native_build_consumers"],
)

alias(
    name = "proto_gen",
