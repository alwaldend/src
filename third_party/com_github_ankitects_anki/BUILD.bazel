load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load(":schemas.bzl", "ANKI_SCHEMAS")

exports_files([
    "Cargo.lock",
    "anki.BUILD.bazel",
    "chrono_wasi.patch",
    "fsrs_wasi.patch",
    "native.bzl",
    "schemas.bzl",
    "wasi.patch",
])

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//third_party:__pkg__"],
)

package_group(
    name = "native_build_consumers",
    packages = [
        "//projects/anki_grpc/internal/backend",
        "//projects/anki_grpc/test/wasm",
    ],
)

package_group(
    name = "descriptor_consumers",
    packages = [
        "//projects/anki_as_code/internal/rpc",
        "//projects/anki_grpc/internal/backend",
    ],
)

package_group(
    name = "schema_consumers",
    packages = [
        "//projects/anki_as_code/...",
        "//projects/anki_grpc/pkg/ankiclient",
        "//projects/anki_grpc/test/transport",
        "//projects/anki_grpc/test/wasm",
    ],
)

alias(
    name = "protos",
    actual = "@com_github_ankitects_anki//:protos",
    visibility = [":schema_consumers"],
)

alias(
    name = "descriptors",
    actual = "@com_github_ankitects_anki//:descriptors",
    visibility = [":descriptor_consumers"],
)

alias(
    name = "native",
    actual = "@com_github_ankitects_anki//:anki",
    visibility = [":native_build_consumers"],
)

alias(
    name = "proto_gen",
    actual = "@com_github_ankitects_anki//:anki_proto_gen",
    visibility = [":native_build_consumers"],
)

alias(
    name = "prost_reflect",
    actual = "@com_github_ankitects_anki_crates//:prost-reflect",
    visibility = [":native_build_consumers"],
)

[
    alias(
        name = name,
        actual = "@com_github_ankitects_anki//:" + name,
        visibility = [":schema_consumers"],
    )
    for name in ANKI_SCHEMAS
]
