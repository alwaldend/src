binary_toolchain_extension = use_extension(
    "@rules_binary_toolchain//main/bzl:binary_toolchain_extension.bzl",
    "binary_toolchain_extension",
)
binary_toolchain_extension.toolchains(
    archives = {
        "vault": ["linux_x86_64"],
    },
    lock = "//third_party/com_hashicorp_vault:binary_toolchain.json",
    toolchains_map = {
        "vault": "com_hashicorp_vault",
    },
)

register_toolchains(
    "@com_hashicorp_vault//:all",
)

use_repo(
    binary_toolchain_extension,
    "com_hashicorp_vault",
    "com_hashicorp_vault_linux_x86_64",
)
