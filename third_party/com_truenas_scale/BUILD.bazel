load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//third_party:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//third_party:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

alias(
    name = "com_truenas_scale",
    actual = "@com_truenas_scale//file:file",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "iso_flash",
    actual = "@com_truenas_scale_flash//:iso_flash",
    visibility = ["//:__subpackages__"],
)
