load("@rules_docs//docs:defs.bzl", "docs_filegroup")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//third_party:__pkg__"],
)

alias(
    name = "org_xcp_ng",
    actual = "@org_xcp_ng//file:file",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "iso_flash",
    actual = "@org_xcp_ng_flash//:iso_flash",
    visibility = ["//:__subpackages__"],
)
