load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/emscripten/pkg:defs.bzl", "emscripten_toolchain")

exports_files(
    ["archive.BUILD.bazel"],
    visibility = ["//:__subpackages__"],
)

emscripten_toolchain(
    name = "linux_x86_64",
    emcc = "@com_github_emscripten_core_emsdk//:emscripten/emcc.py",
    sdk = "@com_github_emscripten_core_emsdk//:sdk",
)

toolchain(
    name = "linux_x86_64_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":linux_x86_64",
    toolchain_type = "//tools/emscripten:toolchain_type",
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//third_party:__pkg__"],
)
