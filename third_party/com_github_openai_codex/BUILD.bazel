load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//third_party:transitive_consumers")

exports_files(["codex.BUILD.bazel"])

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//third_party:__pkg__"],
)

alias(
    name = "review-agent",
    actual = "@com_github_openai_codex//:review-agent",
    visibility = [
        "//.agents:skill_discovery",
        "//tools/agents/evals/review-agent:__pkg__",
    ],
)

alias(
    name = "linux_archive",
    actual = "@com_github_openai_codex_linux_x86_64//file",
    visibility = ["//infra/local_inference/ansible:__pkg__"],
)
