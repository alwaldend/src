load("//third_party:artifact_mirror.bzl", "third_party_artifact_mirror")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//third_party:transitive_consumers")

exports_files(
    ["artifacts.json"],
    visibility = ["//infra/flux/tf:__pkg__"],
)

third_party_artifact_mirror(inventory = "artifacts.json")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//third_party:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

alias(
    name = "io_fluxcd_flux",
    actual = "@io_fluxcd_flux//:flux_binary",
    visibility = ["//:__subpackages__"],
)
