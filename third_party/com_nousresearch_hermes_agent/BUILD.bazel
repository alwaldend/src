load("@rules_docs//docs:defs.bzl", "docs_filegroup")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//third_party:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

alias(
    name = "com_nousresearch_hermes_agent",
    actual = "@com_nousresearch_hermes_agent//file",
    visibility = ["//:__subpackages__"],
)
