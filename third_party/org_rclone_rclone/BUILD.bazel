load("@org_rclone_rclone//:defs.bzl", "rclone_binary")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//third_party:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

rclone_binary(
    name = "rclone",
    visibility = ["//:__subpackages__"],
)
