binary_toolchain_extension = use_extension(
    "@rules_binary_toolchain//main/bzl:binary_toolchain_extension.bzl",
    "binary_toolchain_extension",
)
binary_toolchain_extension.toolchains(
    lock = "//third_party/com_github_hermeticbuild_qemu:binary_toolchain.json",
    toolchains_map = {"qemu": "com_github_hermeticbuild_qemu"},
)
register_toolchains("@com_github_hermeticbuild_qemu//:all")
use_repo(binary_toolchain_extension, "com_github_hermeticbuild_qemu")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "com_github_hermeticbuild_qemu_data",
    urls = ["https://github.com/hermeticbuild/qemu-prebuilt/releases/download/11.0.0.1/qemu-system-data-linux-amd64-11.0.0.1.tar.gz"],
    integrity = "sha256-J+WgSjLVZ4Pr+CdxQOxSME3SN2+XocAcNpgr0ijzfPw=",
    build_file_content = "exports_files(glob([\"share/qemu/**\"]))",
)
