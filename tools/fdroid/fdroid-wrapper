#!/usr/bin/env bash
set -euo pipefail

FDROIDSERVER_VERSION=2.4.5

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
CACHE_DIR="$WORKSPACE_ROOT/out/fdroid-wrapper"
VENV_DIR="$CACHE_DIR/venv"

mkdir -p "$CACHE_DIR"

if [ ! -x "$VENV_DIR/bin/fdroid" ]; then
    echo "provisioning fdroidserver ${FDROIDSERVER_VERSION}..."
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install --disable-pip-version-check "fdroidserver==${FDROIDSERVER_VERSION}"
fi

if [ -z "${ANDROID_HOME:-}" ] && [ -d "$HOME/Android/Sdk" ]; then
    export ANDROID_HOME="$HOME/Android/Sdk"
fi

if [ -z "${JAVA_HOME:-}" ] && [ -x "$WORKSPACE_ROOT/out/gradle-wrapper/jdk21/bin/java" ]; then
    export JAVA_HOME="$WORKSPACE_ROOT/out/gradle-wrapper/jdk21"
    export PATH="$JAVA_HOME/bin:$PATH"
fi

exec "$VENV_DIR/bin/fdroid" "$@"
