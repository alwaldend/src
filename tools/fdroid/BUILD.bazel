load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
)

go_binary(
    name = "fdroid_wrapper",
    embed = [":fdroid_lib"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "fdroid_lib",
    srcs = [
        "doc.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/tools/fdroid",
    visibility = ["//visibility:private"],
    deps = ["@com_github_spf13_cobra//:cobra"],
)
