load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")

alias(
    name = "systemd_run",
    actual = "//cmd/systemd_run",
    visibility = ["//visibility:public"],
)

build_test(
    name = "build_test",
    targets = ["//test:probe"],
