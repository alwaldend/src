load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    prefix = "content/docs/tools/rules_promptfoo_gazelle",
    visibility = ["//visibility:public"],
)

build_test(
    name = "build_test",
    targets = [
        ":docs",
        "//tools/rules_promptfoo_gazelle/gazelle",
        "//tools/rules_promptfoo_gazelle/gazelle:gazelle_promptfoo",
    ],
)
