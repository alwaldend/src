{
    "schema": "agents.alwaldend.com/operations/v1alpha1",
    "owner": "tools.repo-delivery",
    "provider": "github.forge",
    "definition": "tools/repo_delivery/cmd/repo_delivery/command.go",
    "operations": [
        {
            "id": "repo-delivery.prepare",
            "selector": "prepare",
            "classification": "classified",
            "effects": ["history.write", "source.write", "task_state.write"],
            "inputs": ["task paths", "message", "expected head"],
            "outputs": ["commit", "preparation receipt"],
            "information": ["public"],
            "credentialUse": "none",
            "networkUse": "read-only forge inspection",
            "environmentSelector": "selected Git worktree",
            "authorityGate": "explicit implementation and task path scope",
            "preflight": "fresh repository and provider inspection",
            "verification": "clean exact commit and receipt",
            "cost": "task-path-bounded",
            "cacheability": "not_cacheable",
            "cancellation": "process context"
        },
        {
            "id": "repo-delivery.validate",
            "selector": "validate",
            "classification": "classified",
            "effects": [
                "code.execute",
                "credential.consume",
                "network.read",
                "source.read",
                "task_state.write"
            ],
            "inputs": [
                "preparation receipt",
                "explicit Bazel validation plan",
                "clean prepared candidate"
            ],
            "outputs": [
                "candidate-bound check results",
                "restricted check logs"
            ],
            "information": ["public", "secret", "personal"],
            "credentialUse": "selected Bazel toolchain and remote-cache configuration",
            "networkUse": "Bazel dependency and cache reads; build actions follow repository sandbox policy",
            "environmentSelector": "plan-selected workspaces in the receipt-bound Git worktree",
            "authorityGate": "explicit validation plan; no arbitrary shell or run targets",
            "preflight": "receipt lock, exact clean candidate, complete required checks and gap decisions",
            "verification": "passing checks, unchanged candidate and plan, digest-bound logs",
            "cost": "bounded sequential checks with per-check deadlines and output limits",
            "cacheability": "not_cacheable",
            "cancellation": "failed validation state; no publication"
        },
        {
            "id": "repo-delivery.continue",
            "selector": "continue",
            "classification": "classified",
            "effects": [
                "credential.consume",
                "history.write",
                "network.read",
                "remote.write",
                "source.write",
                "task_state.write"
            ],
            "inputs": [
                "preparation receipt",
                "recorded passing validation",
                "explicit publish flag for publication"
            ],
            "outputs": [
                "readiness or verification status",
                "remote ref and pull request only when publication is requested"
            ],
            "information": ["public", "secret"],
            "credentialUse": "Git and forge credentials for publication or verification",
            "networkUse": "read-only verification; Git and forge write only with --publish",
            "environmentSelector": "receipt-bound repository and exact validated candidate",
            "authorityGate": "explicit --publish plus passing bound results for publication; other continuation only inspects or verifies",
            "preflight": "receipt lock, candidate, plan, results, logs, and inherited-environment agreement",
            "verification": "remote ref and PR match exact candidate; rebase requires fresh validation",
            "cost": "one guarded publication or bounded verification",
            "cacheability": "not_cacheable",
            "cancellation": "persist attempted state before mutation; verification-only continuation after uncertainty"
        },
        {
            "id": "repo-delivery.publish",
            "selector": "publish",
            "classification": "classified",
            "effects": ["credential.consume", "network.read", "remote.write"],
            "inputs": ["preparation receipt", "validated head"],
            "outputs": ["remote ref", "pull request"],
            "information": ["public", "secret"],
            "credentialUse": "Git and forge credentials",
            "networkUse": "Git and forge write",
            "environmentSelector": "receipt-bound repository",
            "authorityGate": "explicit delivery authority and exact receipt",
            "preflight": "fresh base, feature ref, and PR expectations",
            "verification": "remote ref and PR match receipt",
            "cost": "one guarded publication",
            "cacheability": "not_cacheable",
            "cancellation": "process context with guarded retry"
        },
        {
            "id": "repo-delivery.review-mutate",
            "selector": "review",
            "classification": "classified",
            "effects": ["credential.consume", "network.read", "remote.write"],
            "inputs": [
                "review inventory",
                "one-shot mutation receipt",
                "goal or delivery ref",
                "defect identity"
            ],
            "outputs": [
                "comment or thread disposition",
                "joined durable review receipt"
            ],
            "information": ["public", "secret"],
            "credentialUse": "forge credentials",
            "networkUse": "forge write",
            "environmentSelector": "exact pull request",
            "authorityGate": "explicit review mutation and exact guards",
            "preflight": "reinspect bounded review inventory",
            "verification": "post-mutation inventory",
            "cost": "one bounded forge mutation",
            "cacheability": "not_cacheable",
            "cancellation": "one-shot receipt is consumed on attempt"
        }
    ],
    "removedAliases": []
}
