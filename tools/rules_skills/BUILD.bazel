load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")
load("//tools/rules_skills/skill:defs.bzl", "skill_library")

skill_library(
    name = "root_skill_fixture",
    testonly = True,
    srcs = ["README.md"],
    tags = ["manual"],
    visibility = ["//tools/rules_skills/tests/analysis:__pkg__"],
)

build_test(
    name = "build_test",
    targets = [
        "//tools/rules_skills/examples/example-skill:skill",
        "//tools/rules_skills/cmd/skill_validator:skill_validator",
        "//tools/rules_skills/skill:defs",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    prefix = "content/docs/tools/rules_skills",
    visibility = ["//visibility:public"],
)
