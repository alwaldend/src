load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")
load("//tools/rules_openspec/rules:defs.bzl", "openspec_validate_test", "openspec_workspace")

package(transitive_visibility = "//tools:transitive_consumers")

openspec_workspace(
    name = "source",
    srcs = glob(
        [
            "specs/**/*.md",
            "changes/**",
        ],
        allow_empty = True,
    ),
    config = "config.yaml",
    visibility = ["//visibility:public"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(
        [
            "*.md",
            "specs/**/*.md",
        ],
        allow_empty = True,
    ),
    prefix = "content/docs/tools/rules_skills/openspec",
    preserve_paths = True,
    visibility = ["//tools/rules_skills:__pkg__"],
)

openspec_validate_test(
    name = "validate_test",
    source = ":source",
)
