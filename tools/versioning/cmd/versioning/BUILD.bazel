load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "versioning_lib",
    srcs = [
        "bazel.go",
        "command.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/tools/versioning/cmd/versioning",
    visibility = ["//visibility:private"],
    deps = ["//tools/versioning/internal/versioning"],
)

exports_files(
    ["versioning.sh"],
    visibility = ["//:__subpackages__"],
)

go_binary(
    name = "versioning",
    embed = [":versioning_lib"],
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "versioning_test",
    size = "small",
    srcs = ["command_test.go"],
    embed = [":versioning_lib"],
)
