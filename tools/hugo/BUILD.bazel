load("@rules_docs//docs:defs.bzl", "docs_filegroup")

alias(
    name = "hugo",
    actual = "@com_alwaldend_src_tools_hugo//:hugo_binary",
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = [
        "//tools/hugo/main/bzl:docs",
    ],
)
