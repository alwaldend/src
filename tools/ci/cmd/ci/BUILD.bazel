load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(transitive_visibility = "//tools:transitive_consumers")

go_library(
    name = "ci_lib",
    srcs = [
        "doc.go",
        "forgejo_logs.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/tools/ci/cmd/ci",
    visibility = ["//visibility:private"],
    deps = ["@com_github_spf13_cobra//:cobra"],
)

go_binary(
    name = "ci",
    embed = [":ci_lib"],
    visibility = ["//tools/ci:__pkg__"],
)

go_test(
    name = "ci_e2e_test",
    size = "small",
    srcs = ["e2e_test.go"],
    data = [":ci"],
    env = {"CI_BINARY": "$(rlocationpath :ci)"},
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["@rules_go//go/runfiles"],
)
