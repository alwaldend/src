load("@rules_docs//docs:defs.bzl", "docs_filegroup")

alias(
    name = "cloc",
    actual = "//third_party/com_github_aldanial_cloc:cloc",
    visibility = ["//:__subpackages__"],
)

genrule(
    name = "list",
    srcs = [":cloc"],
    outs = ["list.sh"],
    cmd = """
cat - >$(execpath :list.sh) <<EOF
#!/usr/bin/env sh
set -eu
root="\\$${BUILD_WORKSPACE_DIRECTORY}"
git --git-dir "\\$${root}/.git" ls-files | xargs "-I{}" echo "\\$${root}/{}" >files.txt
$(execpath :cloc) --list-file files.txt
EOF
chmod u+x $(execpath :list.sh)
""",
    executable = True,
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
)
