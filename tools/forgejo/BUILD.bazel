load("@rules_al//:defs.bzl", "al_binary_run_map")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

_BIN = "$(rootpath //third_party/org_codeberg_forgejo_bin)"

al_binary_run_map(
    name = "forgejo",
    args = {
        "": [_BIN],
    },
    configs = ["//tools/al:config"],
    data = [
        "//third_party/org_codeberg_forgejo_bin",
    ],
    plugin_labels = {"forgejo_login": ""},
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
