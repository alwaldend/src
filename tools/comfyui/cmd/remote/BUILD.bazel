load("@rules_go//go:def.bzl", "go_binary", "go_test")

package(transitive_visibility = "//tools:transitive_consumers")

go_binary(
    name = "remote",
    srcs = [
        "doc.go",
        "main.go",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_github_spf13_cobra//:cobra",
        "@rules_go//go/runfiles",
    ],
)

go_test(
    name = "remote_test",
    size = "small",
    srcs = [
        "doc.go",
        "main_test.go",
    ],
    data = [
        ":remote",
        "//tools/comfyui/cli:comfy",
    ],
    env = {
        "BRIDGE_BINARY": "$(rlocationpath :remote)",
        "CLI_BINARY": "$(rlocationpath //tools/comfyui/cli:comfy)",
    },
    deps = [
        "@org_golang_x_net//websocket",
        "@rules_go//go/runfiles",
    ],
)
