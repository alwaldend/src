load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python/uv:lock.bzl", "lock")
load("@rules_systemd//systemd:defs.bzl", "systemd_run")

package(transitive_visibility = "//tools:transitive_consumers")

exports_files(
    ["uv.lock"],
    visibility = ["//:__pkg__"],
)

_SERVER_ARGS = [
    "--server",
    "$(rlocationpath //third_party/com_github_comfy_org_comfyui:comfyui)",
    "--threads",
    "12",
]

_SD_TURBO_MODEL_ARGS = [
    "--model",
    "checkpoints/sd_turbo.safetensors=$(rlocationpath //third_party/co_huggingface_stabilityai_sd_turbo:checkpoint)",
]

_Z_IMAGE_MEMORY_LIMIT_GIB = 44

_Z_IMAGE_LIMIT_ARGS = [
    "--memory-limit-gib",
    str(_Z_IMAGE_MEMORY_LIMIT_GIB),
]

_Z_IMAGE_SCOPE_PROPERTIES = {
    "MemoryHigh": "40G",
    "MemoryMax": "{}G".format(_Z_IMAGE_MEMORY_LIMIT_GIB),
    "MemorySwapMax": "0",
}

_Z_IMAGE_MODEL_ARGS = [
    "--model",
    "diffusion_models/z_image_turbo_bf16.safetensors=$(rlocationpath //third_party/co_huggingface_comfy_org_z_image_turbo:diffusion_model)",
    "--model",
    "text_encoders/qwen_3_4b.safetensors=$(rlocationpath //third_party/co_huggingface_comfy_org_z_image_turbo:text_encoder)",
    "--model",
    "vae/ae.safetensors=$(rlocationpath //third_party/co_huggingface_comfy_org_z_image_turbo:vae)",
]

_SD_TURBO_DATA = [
    "//third_party/co_huggingface_stabilityai_sd_turbo:checkpoint",
    "//third_party/com_github_comfy_org_comfyui:comfyui",
]

_Z_IMAGE_DATA = [
    "//third_party/co_huggingface_comfy_org_z_image_turbo:diffusion_model",
    "//third_party/co_huggingface_comfy_org_z_image_turbo:text_encoder",
    "//third_party/co_huggingface_comfy_org_z_image_turbo:vae",
    "//third_party/com_github_comfy_org_comfyui:comfyui",
]

py_binary(
    name = "comfyui",
    srcs = ["cmd/serve/main.py"],
    args = _SERVER_ARGS + _SD_TURBO_MODEL_ARGS,
    data = _SD_TURBO_DATA,
    main = "cmd/serve/main.py",
    python_version = "3.13.13",
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_alwaldend_src_comfyui_pip//comfyui_frontend_package",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "benchmark",
    srcs = ["cmd/benchmark/main.py"],
    args = [
        "--launcher",
        "$(rlocationpath :comfyui)",
    ] + _SERVER_ARGS + _SD_TURBO_MODEL_ARGS,
    data = [":comfyui"] + _SD_TURBO_DATA,
    main = "cmd/benchmark/main.py",
    python_version = "3.13.13",
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_alwaldend_src_comfyui_pip//pillow",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "z_image_turbo_bin",
    srcs = ["cmd/serve/main.py"],
    data = _Z_IMAGE_DATA,
    main = "cmd/serve/main.py",
    python_version = "3.13.13",
    tags = ["manual"],
    deps = [
        "@com_alwaldend_src_comfyui_pip//comfyui_frontend_package",
        "@rules_python//python/runfiles",
    ],
)

systemd_run(
    name = "z_image_turbo",
    arguments = _SERVER_ARGS + _Z_IMAGE_MODEL_ARGS + _Z_IMAGE_LIMIT_ARGS + [
        "--directory",
        "out/comfyui/z-image-session",
    ],
    binary = ":z_image_turbo_bin",
    data = _Z_IMAGE_DATA,
    properties = _Z_IMAGE_SCOPE_PROPERTIES,
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
)

py_binary(
    name = "z_image_turbo_benchmark_bin",
    srcs = ["cmd/benchmark/main.py"],
    data = [":z_image_turbo_bin"] + _Z_IMAGE_DATA,
    main = "cmd/benchmark/main.py",
    python_version = "3.13.13",
    tags = ["manual"],
    deps = [
        "@com_alwaldend_src_comfyui_pip//pillow",
        "@rules_python//python/runfiles",
    ],
)

systemd_run(
    name = "z_image_turbo_benchmark",
    arguments = [
        "--launcher",
        "$(rlocationpath :z_image_turbo_bin)",
        "--profile",
        "z-image-turbo",
    ] + _SERVER_ARGS + _Z_IMAGE_MODEL_ARGS + _Z_IMAGE_LIMIT_ARGS,
    binary = ":z_image_turbo_benchmark_bin",
    data = [":z_image_turbo_bin"] + _Z_IMAGE_DATA,
    properties = _Z_IMAGE_SCOPE_PROPERTIES,
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
)

lock(
    name = "uv_lock",
    srcs = ["pyproject.toml"],
    out = "uv.lock",
    python_version = "3.13.13",
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//tools:__pkg__"],
)
