load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

js_binary(
    name = "render",
    data = [
        "//tools:node_modules/puppeteer",
        "@com_google_chrome_headless_shell//:chrome_headless_shell_binary",
    ],
    entry_point = "main.mjs",
    visibility = ["//tools/drawio:__pkg__"],
)

docs_filegroup(
    name = "docs",
    srcs = [],
    visibility = ["//tools/drawio:__pkg__"],
)

js_test(
    name = "render_test",
    size = "medium",
    args = [
        "$(rootpath //tools/drawio:webapp)",
        "$(rootpath @com_google_chrome_headless_shell//:chrome_headless_shell_binary)",
        "$(rootpath @com_github_liberationfonts_liberation_fonts//:LiberationSans-Regular.ttf)",
    ],
    data = [
        "main.mjs",
        "//tools:node_modules/puppeteer",
        "//tools/drawio:webapp",
        "@com_github_liberationfonts_liberation_fonts//:LiberationSans-Regular.ttf",
        "@com_github_liberationfonts_liberation_fonts//:fonts",
        "@com_google_chrome_headless_shell//:chrome_headless_shell_binary",
    ],
    entry_point = "main_test.mjs",
    no_copy_to_bin = [
        "@com_github_liberationfonts_liberation_fonts//:fonts",
        "@com_github_liberationfonts_liberation_fonts//:LiberationSans-Regular.ttf",
    ],
)
