load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//projects/al:defs.bzl", "al_config", "al_inject")

package(transitive_visibility = "//tools:transitive_consumers")

al_inject(
    name = "cleanup",
    testonly = True,
    labels = {"test": "cleanup"},
    res_env = {"AL_TEST_SECRET_PATH": {
        "value": "{{ index .Last.Files 0 }}",
        "deps": ["fixture"],
    }},
    res_file = {"fixture": {"value": "synthetic command cleanup fixture"}},
)

al_inject(
    name = "invalid_template",
    testonly = True,
    extends = ":cleanup",
    labels = {"test": "cleanup"},
    res_env = {"AL_TEST_SECRET_PATH": {
        "value": "{{",
        "deps": ["fixture"],
    }},
)

al_config(
    name = "cleanup_config",
    testonly = True,
    configs = [
        ":cleanup",
    ],
)

al_config(
    name = "cleanup_failure_config",
    testonly = True,
    configs = [
        ":cleanup_config",
        ":invalid_template",
    ],
)

go_test(
    name = "command_test",
    size = "medium",
    srcs = [
        "command_test.go",
        "doc.go",
    ],
    data = [
        ":cleanup_config",
        ":cleanup_failure_config",
        "//projects/al",
    ],
    env = {
        "AL_BINARY": "$(rlocationpath //projects/al:al)",
        "CLEANUP_CONFIG": "$(rlocationpath :cleanup_config)",
        "CLEANUP_FAILURE_CONFIG": "$(rlocationpath :cleanup_failure_config)",
    },
    deps = [
        "//projects/al/pkg/al",
        "@org_golang_google_protobuf//encoding/protojson",
        "@rules_go//go/runfiles",
    ],
)

go_library(
    name = "command",
    srcs = ["doc.go"],
    importpath = "git.alwaldend.com/alwaldend/src/tools/al/test/command",
    visibility = ["//visibility:public"],
)
