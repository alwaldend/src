load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_al//:defs.bzl", "al_binary_run", "al_config")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary_map")

package(transitive_visibility = "//tools:transitive_consumers")

al_config(
    name = "config",
    srcs = ["//:al.lua"],
    data = [
        "//:al_lib.lua",
        "//data/ssl/alwaldend.com:ica_servers",
    ],
    visibility = ["//:__subpackages__"],
)

terraform_binary_map(
    name = "tf",
    chdir = ".",
    visibility = ["//:__pkg__"],
    wrapper = al_binary_run,
    wrapper_kwargs = {"configs": [":config"]},
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//tools:__pkg__"],
)

native_binary(
    name = "install",
    src = "//tools/file_installer/cmd/install_binary",
    args = [
        "--source",
        "$(rootpath @rules_al//:al)",
        "--name",
        "al",
    ],
    data = ["@rules_al//:al"],
    visibility = ["//:__subpackages__"],
)
