load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_java//java:defs.bzl", "java_binary")

package(transitive_visibility = "//tools:transitive_consumers")

java_binary(
    name = "openapi_generator",
    main_class = "org.openapitools.codegen.OpenAPIGenerator",
    visibility = ["//:__subpackages__"],
    runtime_deps = ["//third_party/org_openapitools_openapi_generator:cli"],
)

exports_files(
    [
        "defs.bzl",
        "logback.xml",
    ],
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//tools:__pkg__"],
    deps = ["//tools/openapi_generator/openspec:docs"],
)
