load("@aspect_rules_lint//format:defs.bzl", "format_multirun", "format_test")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_multirun//:defs.bzl", "command", "multirun")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_binary(
    name = "buf",
    srcs = ["tool_adapter.sh"],
    data = ["//tools/buf"],
)

sh_binary(
    name = "taplo",
    srcs = ["tool_adapter.sh"],
    data = ["//tools/taplo"],
)

java_binary(
    name = "java_format",
    jvm_flags = [
        "--add-exports jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED",
        "--add-exports jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED",
        "--add-exports jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED",
        "--add-exports jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED",
        "--add-exports jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED",
    ],
    main_class = "com.google.googlejavaformat.java.Main",
    runtime_deps = ["@google-java-format//jar"],
)

java_binary(
    name = "ktfmt",
    main_class = "com.facebook.ktfmt.cli.Main",
    runtime_deps = ["@ktfmt//jar"],
)

sh_binary(
    name = "go_module_quality",
    srcs = ["go_module_quality.sh"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_binary(
    name = "lua_quality",
    srcs = ["lua_quality.sh"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_binary(
    name = "qt_xml_quality",
    srcs = ["qt_xml_quality.sh"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

_LUA_DATA = [
    "//tools/selene",
    "//tools/selene:repo.yml",
    "//tools/selene:selene.toml",
    "//tools/stylua",
    "//tools/stylua:stylua_config",
]

_LUA_ENV = {
    "SELENE_CONFIG_RLOCATION": "$(rlocationpath //tools/selene:selene.toml)",
    "SELENE_RLOCATION": "$(rlocationpath //tools/selene)",
    "STYLUA_CONFIG_RLOCATION": "$(rlocationpath //tools/stylua:stylua_config)",
    "STYLUA_RLOCATION": "$(rlocationpath //tools/stylua)",
}

_GO_MODULE_DATA = ["//tools/go"]

_GO_MODULE_ENV = {
    "GO_RLOCATION": "$(rlocationpath //tools/go)",
}

command(
    name = "format_go_modules",
    arguments = ["fix"],
    command = ":go_module_quality",
    data = _GO_MODULE_DATA,
    description = "Formatting Go module and workspace files...",
    environment = _GO_MODULE_ENV,
)

command(
    name = "check_go_modules",
    arguments = ["check"],
    command = ":go_module_quality",
    data = _GO_MODULE_DATA,
    description = "Checking Go module and workspace files...",
    environment = _GO_MODULE_ENV,
)

command(
    name = "format_lua",
    arguments = ["fix"],
    command = ":lua_quality",
    data = _LUA_DATA,
    description = "Formatting Lua with StyLua...",
    environment = _LUA_ENV,
)

command(
    name = "check_lua",
    arguments = ["check"],
    command = ":lua_quality",
    data = _LUA_DATA,
    description = "Checking Lua with StyLua and Selene...",
    environment = _LUA_ENV,
)

_QT_XML_DATA = ["//tools/prettier:prettier_xml"]

_QT_XML_ENV = {
    "PRETTIER_XML_RLOCATION": "$(rlocationpath //tools/prettier:prettier_xml)",
}

command(
    name = "format_qt_xml",
    arguments = ["fix"],
    command = ":qt_xml_quality",
    data = _QT_XML_DATA,
    description = "Formatting Qt XML with Prettier XML...",
    environment = _QT_XML_ENV,
)

command(
    name = "check_qt_xml",
    arguments = ["check"],
    command = ":qt_xml_quality",
    data = _QT_XML_DATA,
    description = "Checking Qt XML with Prettier XML...",
    environment = _QT_XML_ENV,
)

sh_test(
    name = "go_module_quality_test",
    srcs = ["go_module_quality.sh"],
    args = ["check"],
    data = _GO_MODULE_DATA + ["//:MODULE.bazel"],
    env = _GO_MODULE_ENV | {
        "WORKSPACE_MARKER": "$(location //:MODULE.bazel)",
    },
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "lua_quality_test",
    srcs = ["lua_quality.sh"],
    args = ["check"],
    data = _LUA_DATA + ["//:MODULE.bazel"],
    env = _LUA_ENV | {
        "WORKSPACE_MARKER": "$(location //:MODULE.bazel)",
    },
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "qt_xml_quality_test",
    srcs = ["qt_xml_quality.sh"],
    args = ["check"],
    data = _QT_XML_DATA + ["//:MODULE.bazel"],
    env = _QT_XML_ENV | {
        "WORKSPACE_MARKER": "$(location //:MODULE.bazel)",
    },
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

format_multirun(
    name = "format_core",
    c = "@llvm_toolchain//:clang-format",
    cc = "@llvm_toolchain//:clang-format",
    css = "//tools/prettier",
    go = "@aspect_rules_lint//format:gofumpt",
    html = "//tools/prettier",
    java = ":java_format",
    javascript = "//tools/prettier",
    kotlin = ":ktfmt",
    markdown = "//tools/prettier",
    protocol_buffer = ":buf",
    python = "@aspect_rules_lint//format:ruff",
    rust = "@rules_rust//tools/upstream_wrapper:rustfmt",
    shell = "//tools/shfmt",
    sql = "//tools/prettier:prettier_sql",
    starlark = "//tools/buildifier",
    starlark_check_args = [
        "-lint=warn",
        "-mode=check",
        "-warnings=-bzl-visibility,-function-docstring-args,-function-docstring-header,-module-docstring,-name-conventions,-no-effect,-print,-unnamed-macro,-unsorted-dict-items,-unused-variable",
    ],
    starlark_fix_args = [
        "-lint=fix",
        "-mode=fix",
    ],
    terraform = "//tools/terraform",
    toml = ":taplo",
    visibility = [
        "//:__pkg__",
        "//:__subpackages__",
    ],
    xml = "//tools/prettier:prettier_xml",
    yaml = "//tools/prettier",
    yaml_check_args = [
        "--check",
        "--log-level=warn",
    ],
    yaml_fix_args = [
        "--write",
        "--log-level=warn",
    ],
)

format_test(
    name = "repo_format_test",
    size = "large",
    timeout = "long",
    c = "@llvm_toolchain//:clang-format",
    cc = "@llvm_toolchain//:clang-format",
    css = "//tools/prettier",
    fix_target = ":format_core",
    go = "@aspect_rules_lint//format:gofumpt",
    html = "//tools/prettier",
    java = ":java_format",
    javascript = "//tools/prettier",
    kotlin = ":ktfmt",
    markdown = "//tools/prettier",
    no_sandbox = True,
    protocol_buffer = ":buf",
    python = "@aspect_rules_lint//format:ruff",
    rust = "@rules_rust//tools/upstream_wrapper:rustfmt",
    shell = "//tools/shfmt",
    sql = "//tools/prettier:prettier_sql",
    starlark = "//tools/buildifier",
    starlark_check_args = [
        "-lint=warn",
        "-mode=check",
        "-warnings=-bzl-visibility,-function-docstring-args,-function-docstring-header,-module-docstring,-name-conventions,-no-effect,-print,-unnamed-macro,-unsorted-dict-items,-unused-variable",
    ],
    terraform = "//tools/terraform",
    toml = ":taplo",
    visibility = [
        "//:__pkg__",
        "//:__subpackages__",
    ],
    workspace = "//:MODULE.bazel",
    xml = "//tools/prettier:prettier_xml",
    yaml = "//tools/prettier",
    yaml_check_args = [
        "--check",
        "--log-level=warn",
    ],
)

multirun(
    name = "format",
    buffer_output = True,
    commands = [
        ":format_core",
        ":format_go_modules",
        ":format_lua",
        ":format_qt_xml",
    ],
    jobs = 3,
    keep_going = True,
    visibility = ["//:__pkg__"],
)

multirun(
    name = "format.check",
    buffer_output = True,
    commands = [
        ":check_go_modules",
        ":format_core.check",
        ":check_lua",
        ":check_qt_xml",
    ],
    jobs = 3,
    keep_going = True,
    visibility = ["//:__pkg__"],
)

test_suite(
    name = "repo_quality_test",
    tests = [
        ":go_module_quality_test",
        ":lua_quality_test",
        ":qt_xml_quality_test",
        ":repo_format_test",
    ],
)

test_suite(
    name = "repo_quality_test_public",
    tests = [":repo_quality_test"],
    visibility = ["//:__pkg__"],
)

alias(
    name = "check",
    actual = ":format.check",
    visibility = [
        "//:__pkg__",
        "//:__subpackages__",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//tools:__pkg__"],
)
