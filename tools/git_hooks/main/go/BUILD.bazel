load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_lib",
    srcs = [
        "hooks.go",
        "main.go",
    ],
    embedsrcs = ["precommit.sh"],
    importpath = "git.alwaldend.com/alwaldend/src/tools/git_hooks/main/go",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "go",
    embed = [":go_lib"],
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "go_test",
    size = "small",
    srcs = ["hooks_test.go"],
    embed = [":go_lib"],
)
