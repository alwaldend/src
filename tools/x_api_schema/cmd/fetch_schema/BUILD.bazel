load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(transitive_visibility = "//tools:transitive_consumers")

go_binary(
    name = "fetch_schema",
    embed = [":fetch_schema_lib"],
    visibility = ["//third_party/com_x_api_openapi:__pkg__"],
)

go_test(
    name = "fetch_schema_test",
    srcs = ["main_test.go"],
    data = [":fetch_schema"],
    env = {"FETCH_SCHEMA_BINARY": "$(rlocationpath :fetch_schema)"},
    deps = ["@rules_go//go/runfiles"],
)

go_library(
    name = "fetch_schema_lib",
    srcs = [
        "doc.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/tools/x_api_schema/cmd/fetch_schema",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/x_sdk/pkg/oauth1",
        "//tools/go/pkg/sensitiveerr",
        "@com_github_spf13_cobra//:cobra",
    ],
)
