load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

go_library(
    name = "workspace_check_lib",
    srcs = ["main.go"],
    importpath = "git.alwaldend.com/alwaldend/src/tools/agents/cmd/workspace_check",
    visibility = ["//visibility:private"],
    deps = [
        "//tools/agents/catalog/v1alpha1",
    ],
)

go_binary(
    name = "workspace_check",
    embed = [":workspace_check_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "workspace_check_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":workspace_check_lib"],
    deps = ["//tools/agents/catalog/v1alpha1"],
)

sh_binary(
    name = "workspace_check_update",
    srcs = ["update.sh"],
    data = [":workspace_check"],
    env = {
        "WORKSPACE_CHECK_RLOCATION": "$(rlocationpath :workspace_check)",
    },
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "workspace_check_check",
    srcs = ["check.sh"],
    data = [
        ":workspace_check",
        "//:MODULE.bazel",
        "//tools/agents/catalogs:workspace-check.json",
        "//tools/agents/catalogs:workspace-check.md",
    ],
    env = {
        "WORKSPACE_CHECK_RLOCATION": "$(rlocationpath :workspace_check)",
        "WORKSPACE_MARKER": "$(location //:MODULE.bazel)",
    },
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
