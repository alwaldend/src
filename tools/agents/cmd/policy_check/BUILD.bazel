load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

go_library(
    name = "policy_check_lib",
    srcs = ["main.go"],
    importpath = "git.alwaldend.com/alwaldend/src/tools/agents/cmd/policy_check",
    visibility = ["//visibility:private"],
    deps = [
        "//tools/agents/catalog/v1alpha1",
    ],
)

go_binary(
    name = "policy_check",
    embed = [":policy_check_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "policy_check_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":policy_check_lib"],
    deps = ["//tools/agents/catalog/v1alpha1"],
)

sh_binary(
    name = "policy_update",
    srcs = ["update.sh"],
    data = [":policy_check"],
    env = {
        "POLICY_CHECK_RLOCATION": "$(rlocationpath :policy_check)",
    },
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "policy_check_check",
    srcs = ["check.sh"],
    data = [
        ":policy_check",
        "//:AGENTS.md",
        "//:CODEOWNERS",
        "//:MODULE.bazel",
        "//tools/agents/catalogs:policy.json",
        "//tools/agents/catalogs:policy.md",
    ],
    env = {
        "POLICY_CHECK_RLOCATION": "$(rlocationpath :policy_check)",
        "WORKSPACE_MARKER": "$(location //:MODULE.bazel)",
    },
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
