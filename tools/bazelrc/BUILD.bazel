load("@bazelrc-preset.bzl", "bazelrc_preset")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(transitive_visibility = "//tools:transitive_consumers")

bazelrc_preset(
    name = "preset",
    extra_presets = {
        "announce_rc": [],
        "curses": [],
        "module_mirrors": [],
        "remote_download_outputs": [],
        "show_progress_rate_limit": [],
        "terminal_columns": [],
    },
    strict = True,
)

sh_test(
    name = "agent_environment_test",
    size = "small",
    srcs = ["agent_environment_test.sh"],
    args = ["$(rootpath :project.bazelrc)"],
    data = ["project.bazelrc"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
