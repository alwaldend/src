docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    prefix = "content/docs/tools/rules_template",
    visibility = ["//visibility:public"],
    deps = subpackages(
        include = ["**"],
        allow_empty = True,
        exclude = [
