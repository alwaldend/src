load("//tools/docs:defs.bzl", "docs_filegroup")

alias(
    name = "go",
    actual = "@rules_go//go",
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = [
        "//tools/go/main/bzl:docs",
    ],
)
