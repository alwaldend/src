load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/bzl/rules:al_bzl_library_map.bzl", "al_bzl_library_map")

package(transitive_visibility = "//tools:transitive_consumers")

al_bzl_library_map(
    name = "libs",
    libs = {
        "al_go_repository": [
            "@gazelle//:deps",
            "@gazelle//:def",
            "@gazelle//:extensions",
            "@bazel_tools//tools/build_defs/repo:cache.bzl",
            "@bazel_tools//tools/build_defs/repo:http.bzl",
            "@bazel_tools//tools/build_defs/repo:utils.bzl",
        ],
    },
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools/go:__pkg__"],
    deps = [
        ":libs.stardoc",
    ],
)
