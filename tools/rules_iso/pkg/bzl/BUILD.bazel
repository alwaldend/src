load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(
    default_visibility = ["//visibility:public"],
    transitive_visibility = "//tools:transitive_consumers",
)

filegroup(
    name = "release_sources",
    srcs = ["BUILD.bazel"] + glob(["*.bzl"]),
)

bzl_library(
    name = "iso_flash_binary",
    srcs = ["iso_flash_binary.bzl"],
)

bzl_library(
    name = "iso_flash_repo",
    srcs = ["iso_flash_repo.bzl"],
    deps = [":iso_flash_binary"],
)

bzl_library(
    name = "iso_extension",
    srcs = ["iso_extension.bzl"],
    deps = [":iso_flash_repo"],
)
