load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(transitive_visibility = "//tools:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    prefix = "content/docs/tools/rules_iso",
    visibility = ["//visibility:public"],
)

build_test(
    name = "build_test",
    targets = [
        "//tools/rules_iso/pkg/bzl:iso_extension",
        "//tools/rules_iso/pkg/bzl:iso_flash_binary",
        "//tools/rules_iso/pkg/bzl:iso_flash_repo",
    ],
)

pkg_files(
    name = "release_sources",
    srcs = ["//tools/rules_iso/pkg/bzl:release_sources"],
    strip_prefix = strip_prefix.from_root("tools/rules_iso"),
)

pkg_files(
    name = "release_metadata",
    srcs = [
        "README.md",
        "release.MODULE.bazel",
        "//data/license",
    ],
    renames = {
        "release.MODULE.bazel": "MODULE.bazel",
        "//data/license:license": "LICENSE.txt",
    },
)

pkg_tar(
    name = "release_archive",
    srcs = [
        ":release_metadata",
        ":release_sources",
    ],
    out = "rules_iso.tar.gz",
    extension = "tar.gz",
)
