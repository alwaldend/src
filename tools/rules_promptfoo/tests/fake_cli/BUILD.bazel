load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/rules_promptfoo/promptfoo:defs.bzl", "promptfoo_validate_test")
load(
    "//tools/rules_promptfoo/promptfoo/internal:promptfoo_test.bzl",
    "promptfoo_runner_test",
)
load("//tools/rules_promptfoo/promptfoo/internal:workspace.bzl", "promptfoo_workspace")

package(transitive_visibility = "//tools:build_api_consumers")

sh_binary(
    name = "fake_promptfoo",
    srcs = ["fake_promptfoo.sh"],
)

sh_test(
    name = "cleanup_test",
    srcs = ["cleanup_test.sh"],
    data = [
        ":external_codex_login_launcher",
        ":launcher_test",
        "@bazel_tools//tools/bash/runfiles",
    ],
    env = {
        "PROMPTFOO_LAUNCHER_RUNFILE": "$(rlocationpath :launcher_test)",
        "CODEX_LOGIN_LAUNCHER_RUNFILE": "$(rlocationpath :external_codex_login_launcher)",
    },
)

promptfoo_validate_test(
    name = "launcher_test",
    config = "promptfooconfig.yaml",
    promptfoo = ":fake_promptfoo",
    skills = ["//tools/rules_promptfoo/tests/analysis/fixture-skill:skill"],
)

promptfoo_workspace(
    name = "eval_workspace",
    testonly = True,
    skills = ["//tools/rules_promptfoo/tests/analysis/fixture-skill:skill"],
)

promptfoo_runner_test(
    name = "external_codex_login_launcher",
    command = "eval",
    config = "promptfooconfig.yaml",
    promptfoo = ":fake_promptfoo",
    reuse_codex_login = True,
    tags = ["manual"],
    workspace = ":eval_workspace",
)

promptfoo_runner_test(
    name = "eval_launcher_test",
    command = "eval",
    config = "promptfooconfig.yaml",
    promptfoo = ":fake_promptfoo",
    workspace = ":eval_workspace",
)

promptfoo_runner_test(
    name = "reused_codex_login_launcher_test",
    codex_auth_fixture = "fake_codex_home/auth.json",
    command = "eval",
    config = "promptfooconfig.yaml",
    env = {
        "EXPECT_REUSED_CODEX_LOGIN": "1",
    },
    promptfoo = ":fake_promptfoo",
    reuse_codex_login = True,
    workspace = ":eval_workspace",
)
