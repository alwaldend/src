load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
)

alias(
    name = "replace_section",
    actual = "//tools/replace_section/main/py:replace_section",
    visibility = ["//:__subpackages__"],
)
