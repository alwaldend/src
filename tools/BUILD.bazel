load("@com_alwaldend_src_npm//:defs.bzl", "npm_link_all_packages")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

# Public toolchain types and shared build configuration have no tool artifact
# boundary. Their declaring packages select this group explicitly.
package_group(
    name = "build_api_consumers",
    packages = ["public"],
)

package_group(
    name = "transitive_consumers",
    includes = ["//projects/x_profile_cleaner:credential_consumers"],
    packages = [
        "//",
        "//.agents/...",
        "//data/...",
        "//infra/...",
        "//third_party/...",
        "//tools/...",
        "//users/...",
        # The SDK uses the generator and logging config as execution inputs.
        "//internal/x_sdk",
        # Repository documentation and developer commands.
        "//projects/alwaldend.com/...",
        "//projects/x_article_uploader",
        # Tests and source generation share some packages with product targets.
        "//projects/activitywatch_ingester_android/gradle",
        "//projects/android_launcher/gradle",
        "//projects/anki_as_code",
        "//projects/anki_as_code/docs",
        "//projects/anki_grpc",
        "//projects/bazel_deps_analyzer/docs",
        "//projects/bazel_deps_analyzer/test/...",
        "//projects/dotfiles/bin",
        "//projects/dotfiles/home",
        "//projects/dotfiles/nvim",
        "//projects/mlops_2026",
        "//projects/x_article_uploader/test/...",
        "//projects/x_profile_cleaner/test/...",
        # Explicit release commands, including the aggregate launcher.
        "//projects",
        "//projects/activitywatch_ingester_android/releases",
        "//projects/android_launcher/releases",
        "//projects/anki_grpc/releases",
        "//projects/autoscroll/releases",
        "//projects/ci_platform/releases",
        "//projects/dotfiles/releases",
        "//projects/infinitime/releases",
        "//projects/kustomization/releases",
        "//projects/leetcode_downloader/releases",
        "//projects/nexus_security_plugin/releases",
        "//projects/sri/releases",
        "//projects/tf_modules/releases",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
        exclude = [
            "openspec",
            "rules_*",
        ],
    ) + [
        "@rules_al//:docs",
        "@rules_binary_toolchain//:docs",
        "@rules_dnscontrol//:docs",
        "@rules_docs//:docs",
        "@rules_docs_gazelle//:docs",
        "@rules_hugo//:docs",
        "@rules_iso//:docs",
        "@rules_openspec//:docs",
        "@rules_promptfoo//:docs",
        "@rules_promptfoo_gazelle//:docs",
        "@rules_skill_gazelle//:docs",
        "@rules_skills//:docs",
        "@rules_systemd//:docs",
        "@rules_template//:docs",
        "@rules_terraform//:docs",
    ],
)

npm_link_all_packages(
    name = "node_modules",
)
