load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "install",
    srcs = ["install.sh"],
    args = ["$(rootpath //tools/android_cmdtools:sdkmanager)"],
    data = ["//tools/android_cmdtools:sdkmanager"],
)

pkg_filegroup(
    name = "docs",
    srcs = [":docs_files"],
    visibility = ["//tools:__pkg__"],
)

pkg_files(
    name = "docs_files",
    srcs = glob(["*.md"]),
    prefix = "content/docs/{}".format(package_name()),
)
