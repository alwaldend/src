load("@rules_docs//docs:defs.bzl", "docs_filegroup")

alias(
    name = "mmdc",
    actual = "//tools/mermaid/cmd/mmdc",
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
