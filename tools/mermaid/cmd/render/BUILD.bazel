load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")

# js_binary copies only its entry point, so the sibling module is declared
# through a js_library and consumed as a dependency.
js_library(
    name = "render_lib",
    srcs = [
        "embed_font.mjs",
        "fontconfig.mjs",
        "main.mjs",
        "native.mjs",
        "paint_order.mjs",
    ],
    visibility = ["//tools/mermaid:__subpackages__"],
)

js_binary(
    name = "render",
    data = [
        ":render_lib",
        "//tools:node_modules/@mermaid-js/mermaid-cli",
        "//tools:node_modules/puppeteer",
        "@com_google_chrome_headless_shell//:chrome_headless_shell_binary",
    ],
    entry_point = "main.mjs",
    visibility = ["//tools/mermaid:__subpackages__"],
)

js_test(
    name = "paint_order_test",
    size = "small",
    args = ["$(rootpath @com_google_chrome_headless_shell//:chrome_headless_shell_binary)"],
    data = [
        "paint_order.mjs",
        "//tools:node_modules/puppeteer",
        "@com_google_chrome_headless_shell//:chrome_headless_shell_binary",
    ],
    entry_point = "paint_order_test.mjs",
)
