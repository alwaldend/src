load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@rules_go//go:def.bzl", "go_test")
load("//tools/mermaid:defs.bzl", "mermaid_svg", "mermaid_webp")

# The nested-container source is shared with the mmdc test, which asserts that
# an interactive render applies the same paint order as a build action.
filegroup(
    name = "nested_clusters_mmd",
    srcs = ["nested_clusters.mmd"],
    visibility = ["//tools/mermaid:__subpackages__"],
)

mermaid_svg(
    name = "edge_labels_svg",
    src = "edge_labels.mmd",
    out = "edge_labels.svg",
)

mermaid_svg(
    name = "nested_clusters_svg",
    src = "nested_clusters.mmd",
    out = "nested_clusters.svg",
)

# The smoke fixture is the raster rule's reference diagram. The uploader's
# end-to-end check consumes both renders to prove the raster is a projection of
# the maintained SVG, so this pair is visible across the repository.
mermaid_svg(
    name = "smoke_svg",
    src = "smoke.mmd",
    out = "smoke.svg",
    visibility = ["//visibility:public"],
)

# Mermaid's own defaults, for checking that the plain opt-out really bypasses
# the repository appearance.
mermaid_svg(
    name = "smoke_plain_svg",
    src = "smoke.mmd",
    out = "smoke_plain.svg",
    plain = True,
)

# A raster render of the same source, so a check can compare the raster's
# geometry against the SVG render it was encoded from.
mermaid_webp(
    name = "smoke_webp",
    src = "smoke.mmd",
    out = "smoke.webp",
    visibility = ["//visibility:public"],
)

# The native raster must preserve the consumer's SVG palette, font, and canvas.
# Reuse the site's maintained inputs instead of maintaining a test-only theme.
mermaid_svg(
    name = "edge_labels_native_svg",
    src = "edge_labels.mmd",
    out = "edge-labels-native.svg",
    dark_out = "edge-labels-native.dark.svg",
    label_font = "@com_alwaldend_src_tools_drawio_fonts//:LiberationSans-Regular.ttf",
    native = True,
    palette = "//projects/alwaldend.com/assets:mermaid_palette",
    theme = "//projects/alwaldend.com/pkg/mermaid:theme.json",
)

mermaid_webp(
    name = "edge_labels_native_webp",
    src = "edge_labels.mmd",
    out = "edge-labels-native.webp",
    label_font = "@com_alwaldend_src_tools_drawio_fonts//:LiberationSans-Regular.ttf",
    native = True,
    palette = "//projects/alwaldend.com/assets:mermaid_palette",
    scale = 2,
    theme = "//projects/alwaldend.com/pkg/mermaid:theme.json",
)

mermaid_webp(
    name = "edge_labels_native_dark_webp",
    src = "edge_labels.mmd",
    out = "edge-labels-native.dark.webp",
    color_scheme = "dark",
    label_font = "@com_alwaldend_src_tools_drawio_fonts//:LiberationSans-Regular.ttf",
    native = True,
    palette = "//projects/alwaldend.com/assets:mermaid_palette",
    scale = 2,
    theme = "//projects/alwaldend.com/pkg/mermaid:theme.json",
)

mermaid_webp(
    name = "smoke_cover_webp",
    src = "smoke.mmd",
    out = "smoke-cover.webp",
    aspect_ratio = [
        5,
        2,
    ],
    scale = 3,
)

mermaid_webp(
    name = "edge_labels_native_cover_webp",
    src = "edge_labels.mmd",
    out = "edge-labels-native-cover.webp",
    aspect_ratio = [
        10,
        4,
    ],
    label_font = "@com_alwaldend_src_tools_drawio_fonts//:LiberationSans-Regular.ttf",
    native = True,
    palette = "//projects/alwaldend.com/assets:mermaid_palette",
    scale = 1,
    theme = "//projects/alwaldend.com/pkg/mermaid:theme.json",
)

mermaid_webp(
    name = "edge_labels_native_dark_cover_webp",
    src = "edge_labels.mmd",
    out = "edge-labels-native-dark-cover.webp",
    aspect_ratio = [
        5,
        2,
    ],
    color_scheme = "dark",
    label_font = "@com_alwaldend_src_tools_drawio_fonts//:LiberationSans-Regular.ttf",
    native = True,
    palette = "//projects/alwaldend.com/assets:mermaid_palette",
    scale = 2,
    theme = "//projects/alwaldend.com/pkg/mermaid:theme.json",
)

js_test(
    name = "aspect_ratio_test",
    size = "medium",
    args = [
        "$(rootpath @com_google_chrome_headless_shell//:chrome_headless_shell_binary)",
        "$(rootpath :edge_labels_native_dark_webp)",
        "classic",
        "$(rootpath :smoke_svg)",
        "$(rootpath :smoke_cover_webp)",
        "5",
        "2",
        "3",
        "light",
        "$(rootpath :edge-labels-native.svg)",
        "$(rootpath :edge_labels_native_cover_webp)",
        "10",
        "4",
        "1",
        "dark",
        "$(rootpath :edge-labels-native.dark.svg)",
        "$(rootpath :edge_labels_native_dark_cover_webp)",
        "5",
        "2",
        "2",
    ],
    data = [
        ":edge-labels-native.dark.svg",
        ":edge-labels-native.svg",
        ":edge_labels_native_cover_webp",
        ":edge_labels_native_dark_cover_webp",
        ":edge_labels_native_dark_webp",
        ":smoke_cover_webp",
        ":smoke_svg",
        "//tools:node_modules/puppeteer",
        "//tools/mermaid/cmd/render:render_lib",
        "@com_google_chrome_headless_shell//:chrome_headless_shell_binary",
    ],
    entry_point = "aspect_ratio_test.mjs",
)

js_test(
    name = "native_raster_test",
    size = "medium",
    args = [
        "$(rootpath :edge-labels-native.svg)",
        "$(rootpath :edge_labels_native_webp)",
        "$(rootpath :edge-labels-native.dark.svg)",
        "$(rootpath :edge_labels_native_dark_webp)",
        "$(rootpath //projects/alwaldend.com/assets:mermaid_palette)",
        "$(rootpath @com_google_chrome_headless_shell//:chrome_headless_shell_binary)",
    ],
    data = [
        ":edge-labels-native.dark.svg",
        ":edge-labels-native.svg",
        ":edge_labels_native_dark_webp",
        ":edge_labels_native_webp",
        "//projects/alwaldend.com/assets:mermaid_palette",
        "//tools:node_modules/puppeteer",
        "@com_google_chrome_headless_shell//:chrome_headless_shell_binary",
    ],
    entry_point = "native_raster_test.mjs",
)

go_test(
    name = "renderer_test",
    size = "medium",
    srcs = ["renderer_test.go"],
    args = [
        "-smoke=$(rlocationpath :smoke_svg)",
        "-edges=$(rlocationpath :edge_labels_svg)",
        "-nested=$(rlocationpath :nested_clusters_svg)",
        "-theme=$(rlocationpath //tools/mermaid:theme.json)",
        "-plain=$(rlocationpath :smoke_plain_svg)",
        "-raster=$(rlocationpath :smoke_webp)",
    ],
    data = [
        ":edge_labels_svg",
        ":nested_clusters_svg",
        ":smoke_plain_svg",
        ":smoke_svg",
        ":smoke_webp",
        "//tools/mermaid:theme.json",
    ],
    deps = [
        "//tools/mermaid/test/svgdoc",
        "@rules_go//go/runfiles",
    ],
)
