load("@rules_docs//docs:defs.bzl", "docs_filegroup")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = [
        "//tools/helm/main/bzl:docs",
    ],
)

alias(
    name = "helm",
    actual = "//third_party/sh_helm_helm",
    visibility = ["//:__subpackages__"],
)
