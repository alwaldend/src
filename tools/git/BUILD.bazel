load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/git/rules:al_git_info_file.bzl", "al_git_info_file")

package(transitive_visibility = "//tools:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = [
        "//tools/git/api:docs",
        "//tools/git/rules:docs",
    ],
)

alias(
    name = "git",
    actual = "@com_alwaldend_src_tools_git//:git",
    visibility = ["//:__subpackages__"],
)

al_git_info_file(
    name = "git_info",
    visibility = ["//:__subpackages__"],
)
