register_toolchains("//tools/rules_template/rules:all")

binary_tool_examples = use_extension(
    "//tools/rules_binary_toolchain/rules:binary_toolchain_extension.bzl",
    "binary_toolchain_extension",
    dev_dependency = True,
)
binary_tool_examples.toolchains(
    archives = {"runtime_files_fixture": ["local"]},
    lock = "//tools/rules_binary_toolchain/examples:binary_toolchain.json",
    toolchains = [
        "runtime_files_fixture",
        "trufflehog",
    ],
    toolchains_map = {"buf": "buf_with_custom_name"},
)
use_repo(binary_tool_examples, "buf_with_custom_name", "runtime_files_fixture", "runtime_files_fixture_local", "trufflehog")

register_toolchains(
    "@trufflehog//:all",
    "@buf_with_custom_name//:all",
    "@runtime_files_fixture//:all",
    dev_dependency = True,
)
