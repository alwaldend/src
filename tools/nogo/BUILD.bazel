load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_go//go:def.bzl", "TOOLS_NOGO", "nogo")

package(transitive_visibility = "//tools:build_api_consumers")

# Registered through rules_go's external SDK repository.

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
)

nogo(
    name = "nogo",
    config = "config.json",
    visibility = ["//visibility:public"],  # must have public visibility
    deps = TOOLS_NOGO,
)
