load("@rules_docs//docs:defs.bzl", "docs_filegroup")

docs_filegroup(
    name = "docs",
    srcs = glob(
        [
            "*.md",
            "specs/**/*.md",
        ],
        allow_empty = True,
    ),
    prefix = "content/docs/tools/rules_terraform/openspec",
    preserve_paths = True,
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "source",
    srcs = glob([
        "**/*.md",
        "**/*.yaml",
    ]),
    visibility = ["//visibility:public"],
)
