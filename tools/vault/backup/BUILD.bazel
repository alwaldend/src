load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools/vault:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

go_library(
    name = "backup_lib",
    srcs = [
        "doc.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/tools/vault/backup",
    visibility = ["//:__subpackages__"],
    deps = [
        "//projects/al/pkg/al",
        "//tools/vault/pkg/vaultcmd",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "backup",
    embed = [":backup_lib"],
    visibility = ["//:__subpackages__"],
)
