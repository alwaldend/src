load("@rules_al//:defs.bzl", "al_binary_run")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_go//go:def.bzl", "go_binary", "go_test")

package(transitive_visibility = "//tools:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools/vault:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

go_binary(
    name = "login_bin",
    srcs = [
        "doc.go",
        "main.go",
    ],
    deps = ["@com_github_spf13_cobra//:cobra"],
)

go_test(
    name = "login_test",
    srcs = [
        "doc.go",
        "main_test.go",
    ],
    data = [":login_bin"],
    env = {"LOGIN_BINARY": "$(rlocationpath :login_bin)"},
    deps = ["@rules_go//go/runfiles"],
)

al_binary_run(
    name = "login",
    args = ["$(rootpath :login_bin)"],
    configs = ["//tools/al:config"],
    data = [
        ":login_bin",
        "//tools/vault/injector",
    ],
    run_args = [
        "--plugin_label",
        "vault_env=default_no_auth",
    ],
)
