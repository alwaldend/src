PYTHON_VERSION = "3.14.4"

uv = use_extension("@rules_python//python/uv:uv.bzl", "uv", dev_dependency = True)
uv.configure(version = "0.13.0")
use_repo(uv, "uv")

register_toolchains(
    "@uv//:all",
    dev_dependency = True,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "com_alwaldend_src_bzl_rules_ansible_pip",
    python_version = PYTHON_VERSION,
    uv_lock = "//tools/ansible:uv.lock",
)
pip.parse(
    hub_name = "com_alwaldend_src_tools_ykman_pip",
    python_version = PYTHON_VERSION,
    uv_lock = "//tools/ykman:uv.lock",
)
pip.parse(
    hub_name = "com_alwaldend_src_projects_autoscroll_pip",
    python_version = PYTHON_VERSION,
    uv_lock = "//projects/autoscroll:uv.lock",
)
pip.parse(
    hub_name = "com_alwaldend_src_pip",
    python_version = PYTHON_VERSION,
    uv_lock = "//tools/py:uv.lock",
)
use_repo(
    pip,
    "com_alwaldend_src_bzl_rules_ansible_pip",
    "com_alwaldend_src_pip",
    "com_alwaldend_src_projects_autoscroll_pip",
    "com_alwaldend_src_tools_ykman_pip",
)
