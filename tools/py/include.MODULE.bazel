uv = use_extension("@rules_python//python/uv:uv.bzl", "uv", dev_dependency = True)
uv.configure(version = "0.13.0")
use_repo(uv, "uv")

register_toolchains(
    "@uv//:all",
    dev_dependency = True,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14.4",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.default(pyproject_toml = "//tools/py:python-version.toml")
pip.parse(
    hub_name = "com_alwaldend_src_pip",
    uv_lock = "//tools/py:uv.lock",
)
use_repo(pip, "com_alwaldend_src_pip")
