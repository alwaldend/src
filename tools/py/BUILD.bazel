load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_python//python/uv:lock.bzl", "lock")
load("//tools/toml/rules:al_toml_data.bzl", "al_toml_data")

package(transitive_visibility = "//tools:transitive_consumers")

exports_files(
    [
        "pyproject.toml",
        "uv.lock",
    ],
    visibility = ["//:__subpackages__"],
)

al_toml_data(
    name = "pyproject",
    srcs = ["//:pyproject.toml"],
    visibility = ["//:__subpackages__"],
)

lock(
    name = "uv_lock",
    srcs = ["pyproject.toml"],
    out = "uv.lock",
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = [
        "//tools/py/rules:docs",
    ],
)
