load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/release/rules:al_release_deployment.bzl", "al_release_deployment")

package(transitive_visibility = "//tools:transitive_consumers")

alias(
    name = "release",
    actual = "//tools/release/cmd/release:release",
    visibility = ["//:__subpackages__"],
)

al_release_deployment(
    name = "deployment",
    oci_repository = "docker.io/alwaldend/src",
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = [
        "//tools/release/api:docs",
        "//tools/release/cmd/release:docs",
        "//tools/release/openspec:docs",
        "//tools/release/rules:docs",
    ],
)
