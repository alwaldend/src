load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(transitive_visibility = "//tools:transitive_consumers")

go_library(
    name = "go_lib",
    srcs = [
        "bundle.go",
        "cmd.go",
        "deployer.go",
        "doc.go",
        "generator.go",
        "git_bundle.go",
        "main.go",
        "ssh_archive.go",
        "ssh_config.go",
        "ssh_deployer.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/tools/release/cmd/release",
    visibility = ["//visibility:private"],
    deps = [
        "//tools/git/cmd/git:go_lib",
        "//tools/release/api/contracts",
        "@com_github_go_git_go_git_v5//:go-git",
        "@com_github_go_git_go_git_v5//plumbing",
        "@com_github_go_git_go_git_v5//plumbing/format/packfile",
        "@com_github_go_git_go_git_v5//plumbing/object",
        "@com_github_go_git_go_git_v5//storage/memory",
        "@com_github_spf13_cobra//:cobra",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "go_test",
    srcs = [
        "bundle_test.go",
        "git_bundle_test.go",
        "namespace_test.go",
    ],
    data = [":release"],
    embed = [":go_lib"],
    deps = [
        "@com_github_go_git_go_git_v5//:go-git",
        "@com_github_go_git_go_git_v5//plumbing",
        "@com_github_go_git_go_git_v5//plumbing/filemode",
        "@com_github_go_git_go_git_v5//plumbing/format/packfile",
        "@com_github_go_git_go_git_v5//plumbing/object",
        "@com_github_go_git_go_git_v5//storage/memory",
        "@org_golang_x_crypto//ssh",
        "@org_golang_x_crypto//ssh/agent",
    ],
)

go_binary(
    name = "release",
    embed = [":go_lib"],
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools/release:__pkg__"],
)
