load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

alias(
    name = "hugo_worker",
    actual = "//tools/rules_hugo/cmd/hugo_worker",
    visibility = ["//visibility:public"],
)

build_test(
    name = "build_test",
    targets = [
        "//tools/rules_hugo/pkg/bzl:al_hugo_archives",
        "//tools/rules_hugo/pkg/bzl:al_hugo_binary",
        "//tools/rules_hugo/pkg/bzl:al_hugo_extension",
        "//tools/rules_hugo/pkg/bzl:al_hugo_module",
        "//tools/rules_hugo/pkg/bzl:al_hugo_module_info",
        "//tools/rules_hugo/pkg/bzl:al_hugo_run_binary",
        "//tools/rules_hugo/pkg/bzl:al_hugo_site",
        "//tools/rules_hugo/pkg/bzl:al_hugo_site_info",
        "//tools/rules_hugo/pkg/bzl:al_hugo_theme",
        "//tools/rules_hugo/pkg/bzl:al_hugo_theme_info",
        "//tools/rules_hugo/pkg/bzl:al_hugo_toolchain",
        "//tools/rules_hugo/pkg/bzl:al_hugo_worker",
        "//tools/rules_hugo/pkg/bzl:toolchain_type",
        "//tools/rules_hugo/tests:hugo_site_action_test",
        "//tools/rules_hugo/tests/toolchain:toolchain_impl",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    prefix = "content/docs/tools/rules_hugo",
    visibility = ["//visibility:public"],
    deps = subpackages(
        include = ["**"],
        allow_empty = True,
        exclude = [
            "bazel-*",
            "tests/**",
        ],
    ),
)
