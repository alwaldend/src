binary_toolchain_extension = use_extension(
    "@rules_binary_toolchain//main/bzl:binary_toolchain_extension.bzl",
    "binary_toolchain_extension",
)
binary_toolchain_extension.toolchains(
    archives = {
        "sass": ["linux_x86_64"],
    },
    lock = "//tools/sass:binary_toolchain.json",
    toolchains_map = {
        "sass": "com_alwaldend_src_tools_sass",
    },
)

register_toolchains(
    "@com_alwaldend_src_tools_sass//:all",
)

use_repo(
    binary_toolchain_extension,
    "com_alwaldend_src_tools_sass",
    "com_alwaldend_src_tools_sass_linux_x86_64",
)
