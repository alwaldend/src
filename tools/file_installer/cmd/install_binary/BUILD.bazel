load("@rules_go//go:def.bzl", "go_binary", "go_test")

package(transitive_visibility = ":installation_consumers")

package_group(
    name = "installation_consumers",
    includes = ["//tools:transitive_consumers"],
    packages = ["//projects/bazel_agent"],
)

go_binary(
    name = "install_binary",
    srcs = [
        "doc.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/tools/file_installer/cmd/install_binary",
    visibility = [":installation_consumers"],
    deps = ["@com_github_spf13_cobra//:cobra"],
)

go_test(
    name = "install_binary_test",
    size = "small",
    srcs = ["main_test.go"],
    data = [":install_binary"],
)
