load("@com_alwaldend_src_pip//:requirements.bzl", "all_whl_requirements")
load("@gazelle//:def.bzl", "DEFAULT_LANGUAGES", "gazelle", "gazelle_binary")
load("@rules_python_gazelle_plugin//manifest:defs.bzl", "gazelle_python_manifest")
load("@rules_python_gazelle_plugin//modules_mapping:def.bzl", "modules_mapping")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

gazelle(
    name = "gazelle",
    args = [
        "-docs_load_label=//tools/rules_docs/docs:defs.bzl",
        "-openspec_load_label=//tools/rules_openspec/rules:defs.bzl",
        "-promptfoo_load_label=//tools/rules_promptfoo/promptfoo:defs.bzl",
        "-skill_load_label=//tools/rules_skills/skill:defs.bzl",
        "-transitive_visibility_config=tools/transitive_visibility/transitive_visibility.toml",
    ],
    command = "fix",
    gazelle = ":gazelle_bin",
    visibility = ["//:__subpackages__"],
)

gazelle_binary(
    name = "gazelle_bin",
    languages = DEFAULT_LANGUAGES + [
        "@contrib_rules_jvm//java/gazelle",
        "//tools/rules_docs_gazelle/gazelle",
        "//tools/rules_openspec_gazelle/gazelle",
        "//tools/rules_promptfoo_gazelle/gazelle",
        "@rules_python_gazelle_plugin//python:python",
        "//tools/rules_skill_gazelle/gazelle",
        "//projects/bazel_gazelle_enforce_transitive_visibility/pkg/gazelle",
    ],
    visibility = ["//:__subpackages__"],
)

gazelle_python_manifest(
    name = "gazelle_python_manifest",
    lockfiles = "//tools/py:uv.lock",
    manifest = "//:gazelle_python.yaml",
    modules_mapping = ":modules_map",
    pip_repository_name = "com_alwaldend_src_pip",
    visibility = ["//:__subpackages__"],
)

modules_mapping(
    name = "modules_map",
    include_stub_packages = True,
    visibility = ["//:__subpackages__"],
    wheels = all_whl_requirements,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//tools:__pkg__"],
)
