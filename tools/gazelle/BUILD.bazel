load("@com_alwaldend_src_pip//:requirements.bzl", "all_whl_requirements")
load("@gazelle//:def.bzl", "DEFAULT_LANGUAGES", "gazelle", "gazelle_binary")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_python_gazelle_plugin//manifest:defs.bzl", "gazelle_python_manifest")
load("@rules_python_gazelle_plugin//modules_mapping:def.bzl", "modules_mapping")

gazelle(
    name = "gazelle",
    command = "fix",
    gazelle = ":gazelle_bin",
    visibility = ["//:__subpackages__"],
)

gazelle_binary(
    name = "gazelle_bin",
    languages = DEFAULT_LANGUAGES + [
        "@contrib_rules_jvm//java/gazelle",
        "@rules_docs_gazelle//gazelle",
        "@rules_promptfoo_gazelle//gazelle",
        "@rules_python_gazelle_plugin//python:python",
        "@rules_skill_gazelle//gazelle",
    ],
    visibility = ["//:__subpackages__"],
)

gazelle_python_manifest(
    name = "gazelle_python_manifest",
    manifest = "//:gazelle_python.yaml",
    modules_mapping = ":modules_map",
    pip_repository_name = "com_alwaldend_src_pip",
    requirements = "//:requirements.txt",
    visibility = ["//:__subpackages__"],
)

modules_mapping(
    name = "modules_map",
    include_stub_packages = True,
    visibility = ["//:__subpackages__"],
    wheels = all_whl_requirements,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//tools:__pkg__"],
)
