load("//tools/docs:defs.bzl", "docs_filegroup")

[
    alias(
        name = name,
        actual = "@com_alwaldend_src_tools_android_cmdtools//:{}_binary".format(name),
        visibility = ["//:__subpackages__"],
    )
    for name in [
        "apkanalyzer",
        "avdmanager",
        "d8",
        "lint",
        "profgen",
        "r8",
        "resourceshrinker",
        "retrace",
        "screenshot2",
        "sdkmanager",
    ]
]

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
)
