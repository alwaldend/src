load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//internal/assets/web:defs.bzl", "site_stylesheet")

package(
    default_visibility = ["//:__subpackages__"],
    transitive_visibility = "//tools:transitive_consumers",
)

alias(
    name = "code_screenshot",
    actual = "//tools/code_screenshot/cmd/code_screenshot",
)

site_stylesheet(
    name = "theme",
    src = "//internal/assets/web:application.scss",
    out = "theme.css",
    includes = {"@com_alwaldend_src_hugo_github_com_twbs_bootstrap//:pkg_files": "scss"},
    deps = ["//internal/assets/web:application_theme_sources"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
)
