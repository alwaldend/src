# gazelle:exclude examples/buf/example

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    prefix = "content/docs/tools/rules_binary_toolchain",
    visibility = ["//visibility:public"],
    deps = subpackages(
        include = ["**"],
        allow_empty = True,
        exclude = [
            "bazel-*",
            "test/**",
        ],
    ),
)

build_test(
    name = "build_test",
    targets = [
        "//tools/rules_binary_toolchain/rules:bzl_library",
        "//tools/rules_binary_toolchain/test/runtime_files:filegroup_runfiles_test",
        "//tools/rules_binary_toolchain/test/runtime_files:native_binary_runfiles_test",
        "//tools/rules_binary_toolchain/test/runtime_files:toolchain_binary_runfiles_environment_test",
    ],
)
