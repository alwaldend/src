module(
    name = "rules_binary_toolchain",
    version = "0.0.0",
    bazel_compatibility = [">=9.3.1"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_docs", version = "0.0.0")

bazel_dep(name = "rules_docs_gazelle", version = "0.0.0", dev_dependency = True)

bazel_dep(name = "rules_openspec", version = "0.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

binary_toolchain_extension = use_extension(
    "//rules:binary_toolchain_extension.bzl",
    "binary_toolchain_extension",
    dev_dependency = True,
)
binary_toolchain_extension.toolchains(
    archives = {
        "runtime_files_fixture": ["local"],
    },
    lock = "//examples:binary_toolchain.json",
    toolchains = [
        "runtime_files_fixture",
        "trufflehog",
    ],
    toolchains_map = {
        "buf": "buf_with_custom_name",
    },
)

register_toolchains(
    "@trufflehog//:all",
    "@buf_with_custom_name//:all",
    "@runtime_files_fixture//:all",
    dev_dependency = True,
)

use_repo(
    binary_toolchain_extension,
    "buf_with_custom_name",
    "runtime_files_fixture",
    "runtime_files_fixture_local",
    "trufflehog",
)
