load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("@rules_python//python/uv:lock.bzl", "lock")
load("//tools/ansible/main/bzl:al_ansible_scripts.bzl", "AL_ANSIBLE_SCRIPTS")

package(transitive_visibility = "//tools:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

lock(
    name = "uv_lock",
    srcs = ["pyproject.toml"],
    out = "uv.lock",
)

[
    py_console_script_binary(
        name = script,
        pkg = "@com_alwaldend_src_bzl_rules_ansible_pip//ansible_core:pkg",
        script = script.replace("_", "-"),
        visibility = ["//:__subpackages__"],
    )
    for script in AL_ANSIBLE_SCRIPTS
]

py_console_script_binary(
    name = "ansible_lint",
    pkg = "@com_alwaldend_src_bzl_rules_ansible_pip//ansible_lint:pkg",
    script = "ansible-lint",
    visibility = ["//:__subpackages__"],
)
