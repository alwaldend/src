load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_openspec_npm//:defs.bzl", "npm_link_all_packages")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(default_visibility = ["//visibility:private"])

exports_files([
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
])

npm_link_all_packages(name = "node_modules")

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    prefix = "content/docs/tools/rules_openspec",
    visibility = ["//visibility:public"],
    deps = ["//tools/rules_openspec/openspec:docs"],
)

build_test(
    name = "build_test",
    targets = [
        "//tools/rules_openspec/rules:openspec_validation",
        "//tools/rules_openspec/rules:workspace",
    ],
)
