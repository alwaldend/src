load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//tools/rules_openspec/rules:openspec.bzl", "OPENSPEC_ENTRY_POINT", "OPENSPEC_ENV", "OPENSPEC_NPM_PACKAGE")

package(default_visibility = ["//visibility:public"])

js_binary(
    name = "openspec",
    chdir = "$${BUILD_WORKSPACE_DIRECTORY}/$${OPENSPEC_PROJECT:-infra/src}",
    data = [OPENSPEC_NPM_PACKAGE],
    entry_point = OPENSPEC_ENTRY_POINT,
    env = OPENSPEC_ENV,
)

bzl_library(
    name = "workspace",
    srcs = ["workspace.bzl"],
)

bzl_library(
    name = "openspec_validation",
    srcs = ["openspec.bzl"],
    deps = [
        "@aspect_rules_js//js:defs",
    ],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        ":openspec_validation",
        ":workspace",
    ],
)
