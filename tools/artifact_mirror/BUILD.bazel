load("@rules_go//go:def.bzl", "go_binary")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

go_binary(
    name = "artifact_mirror",
    srcs = [
        "doc.go",
        "inventory.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/tools/artifact_mirror",
    visibility = ["//:__subpackages__"],
    deps = [
        "//tools/go/pkg/sensitiveerr",
        "@com_github_spf13_cobra//:cobra",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//tools:__pkg__"],
    deps = [":docs_assets"],
)

mermaid_diagram(
    name = "transfer",
    src = "transfer.mmd",
    out = "rendered/transfer",
    webp_aspect_ratio = [],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [":transfer_svg"],
    prefix = "content/docs/tools/artifact_mirror/assets",
)
