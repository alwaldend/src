load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_trufflehog//:defs.bzl", "trufflehog_test")

package(transitive_visibility = "//tools:transitive_consumers")

alias(
    name = "trufflehog",
    actual = "//third_party/com_github_trufflesecurity_trufflehog:trufflehog",
    visibility = ["//:__subpackages__"],
)

trufflehog_test(
    name = "repo_test",
    size = "medium",
    allowlist = "allowlist.json",
    git = "//tools/git",
    repository_marker = "//:AGENTS.md",
    scanner = ":trufflehog",
)

trufflehog_test(
    name = "repo_all_refs_test",
    size = "medium",
    all_refs = True,
    allowlist = "allowlist.json",
    git = "//tools/git",
    repository_marker = "//:AGENTS.md",
    scanner = ":trufflehog",
    tags = ["manual"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
)
