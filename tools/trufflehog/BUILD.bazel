load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")
load("//projects/rules_trufflehog:defs.bzl", "trufflehog_test")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//tools:transitive_consumers")

alias(
    name = "trufflehog",
    actual = "//projects/rules_trufflehog:trufflehog",
    visibility = ["//:__subpackages__"],
)

trufflehog_test(
    name = "repo_test",
    size = "medium",
    allowlist = "allowlist.json",
    git = "//projects/al:git",
    repository_marker = "//:AGENTS.md",
)

trufflehog_test(
    name = "repo_checkout_test",
    size = "medium",
    allowlist = "allowlist.json",
    checkout = True,
    git = "//projects/al:git",
    repository_marker = "//:AGENTS.md",
)

trufflehog_test(
    name = "repo_all_refs_test",
    size = "medium",
    all_refs = True,
    allowlist = "allowlist.json",
    git = "//projects/al:git",
    repository_marker = "//:AGENTS.md",
    tags = ["manual"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
)

mermaid_diagram(
    name = "scan_diagram",
    src = "//projects/rules_trufflehog/docs:scan.mmd",
    out = "rendered/scan",
    webp_aspect_ratio = [],
    webp_scale = 2,
)

docs_filegroup(
    name = "project_diagram",
    srcs = [":scan_diagram_svg"],
    prefix = "content/docs/projects/rules_trufflehog/assets",
    visibility = ["//projects:__pkg__"],
)
