load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_trufflehog//:defs.bzl", "trufflehog_test")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg", "mermaid_site_webp")

package(transitive_visibility = "//tools:transitive_consumers")

alias(
    name = "trufflehog",
    actual = "@rules_trufflehog//:trufflehog",
    visibility = ["//:__subpackages__"],
)

trufflehog_test(
    name = "repo_test",
    size = "medium",
    allowlist = "allowlist.json",
    git = "@rules_al//:git",
    repository_marker = "//:AGENTS.md",
)

trufflehog_test(
    name = "repo_all_refs_test",
    size = "medium",
    all_refs = True,
    allowlist = "allowlist.json",
    git = "@rules_al//:git",
    repository_marker = "//:AGENTS.md",
    tags = ["manual"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
)

mermaid_site_svg(
    name = "scan_diagram_svg",
    src = "@rules_trufflehog//docs:scan.mmd",
    out = "rendered/scan.svg",
)

mermaid_site_webp(
    name = "scan_diagram_dark_webp",
    src = "@rules_trufflehog//docs:scan.mmd",
    out = "rendered/scan.dark.webp",
    aspect_ratio = [],
    color_scheme = "dark",
    scale = 2,
)

docs_filegroup(
    name = "project_diagram",
    srcs = [":scan_diagram_svg"],
    prefix = "content/docs/projects/rules_trufflehog/assets",
    visibility = ["//projects:__pkg__"],
)
