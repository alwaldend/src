load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "git_proto",
    srcs = ["contracts.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "git_go_proto",
    importpath = "git.alwaldend.com/alwaldend/src/tools/rules_al/api/git",
    proto = ":git_proto",
)

go_library(
    name = "git",
    srcs = ["doc.go"],
    embed = [":git_go_proto"],
    importpath = "git.alwaldend.com/alwaldend/src/tools/rules_al/api/git",
    visibility = ["//:__subpackages__"],
)
