load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_openspec//rules:workspace.bzl", "openspec_workspace")

openspec_workspace(
    name = "source",
    srcs = ["config.yaml"] + glob(
        [
            "specs/**/*.md",
            "changes/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(
        [
            "*.md",
            "specs/**/*.md",
        ],
        allow_empty = True,
    ),
    prefix = "content/docs/tools/rules_al/openspec",
    preserve_paths = True,
    visibility = ["//:__pkg__"],
)
