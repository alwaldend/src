load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/ansible/main/bzl:al_ansible_scripts.bzl", "AL_ANSIBLE_SCRIPTS")
load("//tools/bzlenv/main/bzl:al_bzlenv_binary.bzl", "al_bzlenv_binary")

package(transitive_visibility = "//tools:transitive_consumers")

_ROOT_TOOLS = [
    "pkgsite",
    # "trufflehog",
    "cloc",
    "shfmt",
    "helm",
    "install_file",
    "replace_section",
    "isort",
    "mypy",
    "twine",
    "file_installer",
    "pnpm",
    "readme_tree",
    "prettier",
    "postcss",
    "shell_worker",
    "black",
    "flake8",
    "git_filter_repo",
    "tomlv",
    "stylua",
    "buildifier",
    "release",
]

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//tools:__pkg__"],
    deps = [
        "//tools/bzlenv/main/bzl:docs",
    ],
)

al_bzlenv_binary(
    name = "bzlenv",
    tools = {
        "gopackagesdriver": "//tools/sh/main/sh:gopackagesdriver",
        "bazel": "//tools/sh/main/sh:bazel",
        "al": "//projects/al/cmd/al",
        "blender": "//third_party/org_blender_blender:blender",
        "buf": "//third_party/build_buf_buf:buf",
        "dnscontrol": "//third_party/com_github_stackexchange_dnscontrol:dnscontrol",
        "hugo": "//third_party/io_gohugo_hugo:hugo",
        "minisign": "//third_party/com_github_jedisct1_minisign:minisign",
        "oras": "//third_party/land_oras_oras:oras",
        "shellcheck": "//third_party/com_github_koalaman_shellcheck:shellcheck",
        "taplo": "//third_party/com_github_tamasfe_taplo:taplo",
    } | {
        tool: "//tools/{}".format(tool)
        for tool in _ROOT_TOOLS
    } | {
        script.replace("_", "-"): "//tools/ansible:{}".format(script)
        for script in AL_ANSIBLE_SCRIPTS
    },
)
