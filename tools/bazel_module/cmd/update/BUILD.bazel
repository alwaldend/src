load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(transitive_visibility = "//tools:transitive_consumers")

go_binary(
    name = "update",
    args = ["--git=$(rlocationpath @rules_al//:git)"],
    data = ["@rules_al//:git"],
    embed = [":update_lib"],
    visibility = ["//tools/bazel_module:__pkg__"],
)

go_test(
    name = "update_test",
    size = "small",
    srcs = [
        "main.go",
        "main_test.go",
    ],
    args = ["-git=$(rlocationpath @rules_al//:git)"],
    data = ["@rules_al//:git"],
    deps = ["@rules_go//go/runfiles"],
)

go_test(
    name = "freshness_test",
    size = "small",
    srcs = [
        "freshness_test.go",
        "main.go",
    ],
    args = [
        "-git=$(rlocationpath @rules_al//:git)",
        "-workspace-marker=$(rlocationpath //:MODULE.bazel)",
    ],
    data = [
        "//:MODULE.bazel",
        "@rules_al//:git",
    ],
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
    visibility = ["//tools/repo_quality:__pkg__"],
    deps = ["@rules_go//go/runfiles"],
)

go_library(
    name = "update_lib",
    srcs = ["main.go"],
    importpath = "git.alwaldend.com/alwaldend/src/tools/bazel_module/cmd/update",
    visibility = ["//visibility:private"],
    deps = ["@rules_go//go/runfiles"],
)
