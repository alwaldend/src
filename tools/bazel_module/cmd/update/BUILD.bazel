load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(transitive_visibility = "//tools:transitive_consumers")

go_binary(
    name = "update",
    args = ["--git=$(rlocationpath //projects/al:git)"],
    data = ["//projects/al:git"],
    embed = [":update_lib"],
    visibility = ["//tools/bazel_module:__pkg__"],
)

go_test(
    name = "update_test",
    size = "small",
    srcs = [
        "doc.go",
        "flags_test.go",
        "main.go",
        "main_test.go",
    ],
    args = ["-git=$(rlocationpath //projects/al:git)"],
    data = ["//projects/al:git"],
    deps = [
        "//tools/go/pkg/flagcompat",
        "@com_github_spf13_cobra//:cobra",
        "@rules_go//go/runfiles",
    ],
)

go_test(
    name = "freshness_test",
    size = "small",
    srcs = [
        "doc.go",
        "flags_test.go",
        "freshness_test.go",
        "main.go",
    ],
    args = [
        "-git=$(rlocationpath //projects/al:git)",
        "-workspace-marker=$(rlocationpath //:MODULE.bazel)",
    ],
    data = [
        "//:MODULE.bazel",
        "//projects/al:git",
    ],
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
    visibility = ["//tools/repo_quality:__pkg__"],
    deps = [
        "//tools/go/pkg/flagcompat",
        "@com_github_spf13_cobra//:cobra",
        "@rules_go//go/runfiles",
    ],
)

go_library(
    name = "update_lib",
    srcs = [
        "doc.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/tools/bazel_module/cmd/update",
    visibility = ["//visibility:private"],
    deps = [
        "//tools/go/pkg/flagcompat",
        "@com_github_spf13_cobra//:cobra",
        "@rules_go//go/runfiles",
    ],
)
