alias(
    name = "mermaid_theme",
    actual = "//data/alwaldend/assets/mermaid:theme",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "diagram_font",
    actual = "@com_alwaldend_src_tools_drawio_fonts//:LiberationMono-Regular.ttf",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "diagram_font_license",
    actual = "@com_alwaldend_src_tools_drawio_fonts//:LICENSE",
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//data:__pkg__"],
)

filegroup(
    name = "monogram",
    srcs = ["assets/monogram_s8.svg"],
    visibility = ["//:__subpackages__"],
)
