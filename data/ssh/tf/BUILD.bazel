load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_test", "terraform_test_map")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map")

package(transitive_visibility = "//data:transitive_consumers")

_PROVIDERS = [
    "@terraform_provider_hashicorp_local//:provider",
    "@terraform_provider_hashicorp_vault//:provider",
]

al_terraform_binary_map(
    name = "tf",
    srcs = ["main.tf"],
    configs = ["//tools/al:config"],
    plugin_labels = {"vault_env": "default_default"},
    providers = _PROVIDERS,
)

terraform_test_map(
    name = "tf_tests",
    srcs = ["main.tf"],
    providers = _PROVIDERS,
)

terraform_test(
    name = "validate_test",
    srcs = ["main.tf"],
    arguments = [
        "validate",
        "-no-color",
    ],
    providers = _PROVIDERS,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//data/ssh:__pkg__"],
)
