load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//data:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]) + [":relays"],
    visibility = ["//data:__pkg__"],
)

genrule(
    name = "update_relays",
    outs = ["update_relays.sh"],
    cmd = """
cat - >$(@) <<EOF
#!/usr/bin/env sh
set -eu
curl https://api.mullvad.net/app/v1/relays >"\\$${BUILD_WORKSPACE_DIRECTORY}/data/mullvad/relays.json"
EOF
chmod u+x $(@)
    """,
    executable = True,
)

filegroup(
    name = "relays",
    srcs = ["relays.json"],
    visibility = ["//:__subpackages__"],
)
