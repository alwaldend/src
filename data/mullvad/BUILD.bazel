load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("//tools/docs:defs.bzl", "docs_filegroup")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//data:__pkg__"],
    deps = [":docs_data"],
)

pkg_files(
    name = "docs_data",
    srcs = [":relays"],
    prefix = "content/docs/{}".format(package_name()),
)

genrule(
    name = "update_relays",
    outs = ["update_relays.sh"],
    cmd = """
cat - >$(@) <<EOF
#!/usr/bin/env sh
set -eu
curl https://api.mullvad.net/app/v1/relays >"\\$${BUILD_WORKSPACE_DIRECTORY}/data/mullvad/relays.json"
EOF
chmod u+x $(@)
    """,
    executable = True,
)

filegroup(
    name = "relays",
    srcs = ["relays.json"],
    visibility = ["//:__subpackages__"],
)
