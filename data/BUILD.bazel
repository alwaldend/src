load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//data:transitive_consumers")

package_group(
    name = "transitive_consumers",
    packages = ["//..."],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
