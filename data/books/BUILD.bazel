load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("//tools/docs:defs.bzl", "docs_filegroup")
load("//tools/toml/main/bzl:al_toml_data.bzl", "al_toml_data")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//data:__pkg__"],
    deps = [":docs_data"],
)

pkg_files(
    name = "docs_data",
    srcs = [
        ":authors",
        ":books",
    ],
    prefix = "content/docs/{}".format(package_name()),
)

al_toml_data(
    name = "authors",
    srcs = ["authors.toml"],
    visibility = [
        "//data:__pkg__",
        "//projects/alwaldend.com/content/docs/misc/books:__pkg__",
    ],
)

al_toml_data(
    name = "books",
    srcs = ["books.toml"],
    visibility = [
        "//data:__pkg__",
        "//projects/alwaldend.com/content/docs/misc/books:__pkg__",
    ],
)
