load("@rules_license//rules:license.bzl", "license")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//internal:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]) + ["LICENSE.txt"],
    visibility = ["//internal:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

filegroup(
    name = "license",
    srcs = ["LICENSE.txt"],
    visibility = [
        "//tools/rules_dnscontrol:__pkg__",
        "//tools/rules_iso:__pkg__",
        "//tools/rules_systemd:__pkg__",
    ],
)

license(
    name = "default",
    license_kinds = [
        "@rules_license//licenses/spdx:AGPL-3.0",
    ],
    license_text = "//internal/license:LICENSE.txt",
    visibility = ["//:__subpackages__"],
)
