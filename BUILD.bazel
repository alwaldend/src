load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@com_alwaldend_src_npm//:defs.bzl", "npm_link_all_packages")
load("@com_alwaldend_src_pip//:requirements.bzl", "all_whl_requirements")
load("@gazelle//:def.bzl", "DEFAULT_LANGUAGES", "gazelle", "gazelle_binary")
load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("@rules_python_gazelle_plugin//manifest:defs.bzl", "gazelle_python_manifest")
load("@rules_python_gazelle_plugin//modules_mapping:def.bzl", "modules_mapping")
load("@rules_skill//skill:defs.bzl", "skill_discovery_links")
load("@tools_com_github_bazelbuild_buildtools//buildifier:def.bzl", "buildifier", "buildifier_test")
load("//projects/al/rules/al:al_config.bzl", "al_config")
load("//tools/md/main/bzl:al_md_data.bzl", "al_md_data")
load("//tools/terraform:defs.bzl", "terraform_binary_map")
load("//tools/toml/main/bzl:al_toml_data.bzl", "al_toml_data")
load("//tools/txt/main/bzl:al_txt_data.bzl", "al_txt_data")
load("//tools/vault:defs.bzl", "vault_binary_map")

terraform_binary_map(
    name = "tf",
    configs = [":al"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

al_config(
    name = "al",
    srcs = ["al.lua"],
    data = [
        "al_lib.lua",
        "//data/ssl/alwaldend.com:ica_servers",
    ],
    visibility = ["//:__subpackages__"],
)

alias(
    name = "write_git_hooks",
    actual = "//tools/git_hooks/main/go",
)

skill_discovery_links(
    name = "write_skill_links",
    skills = [
        "//projects/agents/skills/answer-question:skill",
        "//projects/agents/skills/bazel-agent:skill",
        "//projects/agents/skills/bazel-nested-module:skill",
        "//projects/agents/skills/bazel-rules-skill:skill",
        "//projects/agents/skills/blender-reference-fidelity:skill",
        "//projects/agents/skills/decision-review:skill",
        "//projects/agents/skills/full-repo-check:skill",
        "//projects/agents/skills/git-rebase-remote:skill",
        "//projects/agents/skills/host-bot-diagnostics:skill",
        "//projects/agents/skills/project-layout:skill",
        "//projects/agents/skills/repo-ansible:skill",
        "//projects/agents/skills/repo-bazel:skill",
        "//projects/agents/skills/repo-delivery:skill",
        "//projects/agents/skills/repo-external-dependency:skill",
        "//projects/agents/skills/repo-gazelle-plugin:skill",
        "//projects/agents/skills/repo-secrets:skill",
        "//projects/agents/skills/repo-terraform:skill",
        "//projects/agents/skills/spellcheck:skill",
        "//projects/goal/skills/goal:skill",
        "//tools/versioning/skills/versioning:skill",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = [],
    visibility = ["//projects/alwaldend.com:__pkg__"],
    deps = subpackages(
        include = ["*"],
        exclude = ["bazel-*"],
    ),
)

npm_link_all_packages(
    name = "node_modules",
)

gazelle_python_manifest(
    name = "gazelle_python_manifest",
    modules_mapping = ":modules_map",
    pip_repository_name = "com_alwaldend_src_pip",
    requirements = "//:requirements.txt",
    visibility = ["//:__subpackages__"],
)

modules_mapping(
    name = "modules_map",
    include_stub_packages = True,
    wheels = all_whl_requirements,
)

compile_pip_requirements(
    name = "requirements",
    size = "large",
    timeout = "long",
    srcs = [":pyproject"],
    extra_args = ["--no-strip-extras"],
    requirements_txt = ":requirements.txt",
)

al_txt_data(
    name = "editorconfig",
    srcs = [".editorconfig"],
    visibility = ["//:__subpackages__"],
)

al_toml_data(
    name = "pyproject",
    srcs = ["pyproject.toml"],
    visibility = ["//:__subpackages__"],
)

buildifier(
    name = "buildifier",
    exclude_patterns = ["./out/*"],
    visibility = ["//:__subpackages__"],
)

buildifier_test(
    name = "buildifier_test",
    size = "small",
    exclude_patterns = ["./out/*"],
    no_sandbox = True,
    workspace = "//:BUILD.bazel",
)

