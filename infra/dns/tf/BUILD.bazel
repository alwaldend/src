load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_package")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/dns:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_terraform_package(
    name = "tf",
    configs = ["//infra/dns:al"],
    data = glob(["*.tf"]) + [
        "//infra/dns:dnsconfig",
        "//projects/tf_modules/dns_records",
    ],
    plugin_labels = {"tf": ""},
    providers = [
        "@terraform_provider_cloudflare_cloudflare//:provider",
        "@terraform_provider_terraform_routeros_routeros//:provider",
    ],
    tests_use_al = True,
)
