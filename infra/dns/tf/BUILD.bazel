load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map", "al_terraform_test_map")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/dns:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_PROVIDERS = [
    "@terraform_provider_cloudflare_cloudflare//:provider",
    "@terraform_provider_terraform_routeros_routeros//:provider",
]

_CONFIGS = ["//infra/dns:al"]

_DATA = glob(["*.tf"]) + [
    "//infra/dns:dnsconfig",
    "//projects/tf_modules/dns_records",
]

al_terraform_binary_map(
    name = "tf",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = {"tf": ""},
    providers = _PROVIDERS,
)

al_terraform_test_map(
    name = "tf_tests",
    configs = _CONFIGS,
    data = _DATA,
    providers = _PROVIDERS,
)
