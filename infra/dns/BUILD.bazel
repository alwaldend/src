load("@rules_al//:defs.bzl", "al_config", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_dns")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

al_vault_auth(
    name = "auth",
    approle = "src_infra_dns",
    extends = "//tools/al:auth",
)

vault_tf_backend(
    name = "tf_backend_tf",
    labels = {"tf": "1"},
    path = "alwaldend.com/vault1/approles/src_infra_dns/tf_backend/tf",
)

infra_dns(
    name = "dns_providers",
    dc1 = True,
    labels = {"tf": "1"},
)

al_config(
    name = "al",
    configs = [
        ":auth",
        ":dns_providers",
        ":tf_backend_tf",
        "//infra:al",
    ],
    visibility = ["//infra/dns:__subpackages__"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

alias(
    name = "lint",
    actual = "//infra/dns/cmd/lint",
)

test_suite(
    name = "config_test",
    tests = [
        "//infra/dns/cmd/lint:lint_test",
        "//infra/dns/internal/dump:dump_test",
        "//infra/dns/internal/lint:lint_test",
        "//infra/dns/test/repository:repository_test",
    ],
    visibility = ["//:__subpackages__"],
)

alias(
    name = "lint_test",
    actual = ":config_test",
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    prefix = "content/docs/infra/dns",
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
