load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects:projects.bzl", "PROJECTS")
load("//tools/terraform:defs.bzl", "terraform_binary_map", "terraform_test_map")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/github:__pkg__"],
)

_CONFIGS = ["//infra/github:al"]

_RUN_ARGS = [
    "--plugin_label",
    "tf=main",
]

_DATA = glob(["*.tf"]) + [
    ".terraform.lock.hcl",
    ":project_pages",
    "//tools/vault/tf_backend",
    "//tools/vault/injector",
]

# Projects whose published hostname and landing repository must not follow a
# source-only rename. Keep this list empty except while a project is renamed, so
# an apply never destroys a live landing repository or its custom domain.
_PUBLISHED_PROJECT_HOSTNAMES = {
    "rules_skills": "rules-skill",
}

_PROJECT_PAGE_HOSTNAMES = {
    project: _PUBLISHED_PROJECT_HOSTNAMES.get(
        project,
        project.replace("_", "-"),
    )
    for project in PROJECTS
}

_PROJECT_PAGES = {
    project: {
        "hostname": hostname,
        "repository": hostname + "-landing",
    }
    for project, hostname in _PROJECT_PAGE_HOSTNAMES.items()
}

write_file(
    name = "project_pages",
    out = "project_pages.json",
    content = [
        json.encode_indent(
            _PROJECT_PAGES,
            indent = "  ",
        ),
    ],
)

terraform_binary_map(
    name = "tf",
    configs = _CONFIGS,
    data = _DATA,
    run_args = _RUN_ARGS,
)

terraform_test_map(
    name = "tf_tests",
    configs = _CONFIGS,
    data = _DATA,
)
