load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map", "al_terraform_test_map")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/github:__pkg__"],
)

_PROVIDERS = [
    "@terraform_provider_integrations_github//:provider",
]

_CONFIGS = ["//infra/github:al"]

_PLUGIN_LABELS = {"tf": "main"}

_DATA = glob(["*.tf"]) + [
    "//infra/repos:config",
    "//infra/repos/tf:module",
]

al_terraform_binary_map(
    name = "tf",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = _PLUGIN_LABELS,
    providers = _PROVIDERS,
)

al_terraform_test_map(
    name = "tf_tests",
    configs = _CONFIGS,
    data = _DATA,
    providers = _PROVIDERS,
)
