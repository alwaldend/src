load("//projects/al:defs.bzl", "al_binary_run")
load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")

package(transitive_visibility = "//infra:transitive_consumers")

_PLAYBOOK_ARGS = [
    "--inventory",
    "inventory.yaml",
    "--extra-vars",
    "@files/metrics-vars.json",
    "playbook_deploy.yaml",
]

al_ansible_package(
    name = "ansible",
    srcs = [
        "inventory.yaml",
        "playbook_deploy.yaml",
        "//infra/mlflow:storage",
        "//infra/mlflow/dns:dnsconfig",
        "//infra/mlflow/runtime",
        "//infra/victoria_metrics/dns:metrics_vars",
    ] + glob([
        "files/**",
        "group_vars/*.yaml",
        "tasks/*.yaml",
    ]),
    args = {"": _PLAYBOOK_ARGS},
    configs = ["//infra/mlflow:al"],
    plugin_labels = {
        "ansible": "1",
        "vault_env": "default_default",
    },
    renames = {
        "//infra/mlflow/dns:dnsconfig": "files/mlflow-dns.json",
        "//infra/mlflow/runtime": "files/runtime.tar.gz",
        "//infra/mlflow:storage": "files/storage.json",
        "//infra/victoria_metrics/dns:metrics_vars": "files/metrics-vars.json",
    },
)

al_binary_run(
    name = "ansible.syntax",
    args = [
        "$(rootpath :ansible_bin)",
        "--inventory",
        "inventory.yaml",
        "--syntax-check",
        "playbook_deploy.yaml",
    ],
    data = [":ansible_bin"],
)

al_binary_run(
    name = "ansible.coordinator",
    args = ["$(rootpath :ansible_bin)"] + _PLAYBOOK_ARGS + [
        "--extra-vars",
        "mlflow_enable_coordinator=true",
    ],
    configs = ["//infra/mlflow:al"],
    data = [":ansible_bin"],
    plugin_labels = {
        "ansible": "1",
        "mlflow_coordinator": "1",
        "vault_env": "default_default",
    },
)
