load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

mermaid_diagram(
    name = "architecture",
    src = "architecture.mmd",
    out = "rendered/architecture",
    webp_aspect_ratio = [],
)

docs_filegroup(
    name = "docs",
    srcs = ["architecture.mmd"],
    visibility = ["//infra/mlflow:__pkg__"],
    deps = [":docs_assets"],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [":architecture_svg"],
    prefix = "content/docs/infra/mlflow/docs/assets",
)
