load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "monitoring_overview",
    srcs = ["files/monitoring-overview.json"],
    visibility = ["//infra/grafana/tf:__pkg__"],
)

al_ansible_package(
    name = "ansible",
    srcs = [
        "files/monitoring-overview.json",
        "files/traefik.toml",
        "files/traefik_dynamic.toml",
        "group_vars/victoria_metrics.yaml",
        "inventory.yaml",
        "playbook_deploy.yaml",
        "templates/scrape.yaml.j2",
        "//infra/grafana/dns:dnsconfig",
        "//third_party/com_github_victoriametrics:victoria_metrics",
    ],
    configs = ["//infra/victoria_metrics:al"],
    extra_vars_files = [
        "//infra/ingress/ansible:inventory",
        "//infra/victoria_metrics/dns:metrics_vars",
    ],
    plugin_labels = {
        "ansible": "1",
        "vault_env": "default_default",
    },
    renames = {
        "//infra/grafana/dns:dnsconfig": "files/grafana-dns.json",
        "//third_party/com_github_victoriametrics:victoria_metrics": "files/victoria-metrics-prod",
    },
)
