{
    "uid": "infra-ingress-traffic",
    "title": "Ingress traffic",
    "schemaVersion": 38,
    "tags": ["infra/ingress"],
    "timezone": "browser",
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Requests by status code",
            "datasource": {
                "type": "prometheus",
                "uid": "victoria-metrics"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{job=\"traefik_ingress\"}[5m]))",
                    "legendFormat": "{{code}}"
                }
            ]
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "95th percentile request latency",
            "datasource": {
                "type": "prometheus",
                "uid": "victoria-metrics"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_entrypoint_request_duration_seconds_bucket{job=\"traefik_ingress\"}[5m])))",
                    "legendFormat": "p95"
                }
            ]
        }
    ]
}
