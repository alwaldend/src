load("@rules_al//:defs.bzl", "al_binary_run", "al_config", "release_binary", "release_deployment")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/ssh:defs.bzl", "ssh_binary")
load("//tools/vault:defs.bzl", "vault_binary_map")

package(transitive_visibility = "//infra:transitive_consumers")

_HOSTS = {
    "local": "host1.dc1.download.alwaldend.com",
    "yandex": "host1.yc.download.alwaldend.com",
}

[
    release_deployment(
        name = "publication." + environment,
        ssh_environment = environment,
        ssh_host = host,
        ssh_public_url = "https://download.alwaldend.com",
        ssh_publish_user = "download",
        ssh_user = "ansible",
    )
    for environment, host in _HOSTS.items()
]

[
    ssh_binary(
        name = "ssh." + environment,
        args = [
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=10",
            "-o",
            "IdentityAgent=none",
            "-o",
            "IdentitiesOnly=yes",
            "-o",
            "IdentityFile=$${DOWNLOAD_SSH_PRIVATE_KEY}",
            "-o",
            "CertificateFile=$${DOWNLOAD_SSH_CERTIFICATE}",
            "-o",
            "UserKnownHostsFile=$${DOWNLOAD_SSH_KNOWN_HOSTS}",
            "-o",
            "GlobalKnownHostsFile=/dev/null",
            "-o",
            "StrictHostKeyChecking=yes",
            "ansible@" + host,
        ],
        configs = [":al"],
        data = ["//tools/vault/injector"],
        run_args = [
            "--plugin_label",
            "ssh=1",
        ],
        visibility = ["//infra:__subpackages__"],
    )
    for environment, host in _HOSTS.items()
]

[
    release_binary(
        name = "publish." + environment + ".command",
        arguments = [
            "--environment",
            environment,
            "--ssh_config",
            "/dev/null",
            "--ssh_identity",
            "$${DOWNLOAD_SSH_PRIVATE_KEY}",
            "--ssh_disable_agent",
            "--ssh_certificate",
            "$${DOWNLOAD_SSH_CERTIFICATE}",
            "--ssh_known_hosts",
            "$${DOWNLOAD_SSH_KNOWN_HOSTS}",
        ],
        oras = None,
        ssh_deployment = ":publication." + environment,
    )
    for environment in [
        "local",
        "yandex",
    ]
]

[
    al_binary_run(
        name = "publish." + environment,
        args = ["$(rootpath :publish." + environment + ".command)"],
        configs = [":al"],
        data = [
            ":publish." + environment + ".command",
            "//tools/vault/injector",
        ],
        run_args = [
            "--plugin_label",
            "ssh=1",
        ],
    )
    for environment in [
        "local",
        "yandex",
    ]
]

al_config(
    name = "al",
    srcs = ["al.lua"],
    data = ["//data/ssh:ca_servers"],
    visibility = ["//infra/download:__subpackages__"],
    deps = ["//infra:al"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

al_binary_run(
    name = "sync.yandex",
    args = [
        "$(rootpath //infra/download/ansible:ansible_bin)",
        "--inventory",
        "inventory.yaml",
        "playbook_sync.yaml",
    ],
    configs = [":al"],
    data = [
        "//infra/download/ansible:ansible_bin",
        "//tools/vault/injector",
    ],
    run_args = [
        "--plugin_label",
        "ssh=1",
    ],
    visibility = ["//infra:__subpackages__"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
        exclude = ["test/**"],
    ),
)
