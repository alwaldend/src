load("@rules_al//:defs.bzl", "al_binary_run", "al_config", "al_release_binary", "al_release_deployment", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_dns", "infra_xo_login", "infra_yc_auth")
load("//tools/ssh:defs.bzl", "ssh_binary")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")
load(":defs.bzl", "infra_download_ssh")

package(transitive_visibility = "//infra:transitive_consumers")

_HOSTS = {
    "local": "host1.dc1.download.alwaldend.com",
    "yandex": "host1.yc.download.alwaldend.com",
}

_CONTENT_COMMANDS = {
    "publish": [
        "release",
        "publish",
    ],
    "website.extract": [
        "release",
        "website",
        "extract",
    ],
    "website.activate": [
        "release",
        "website",
        "activate",
    ],
}

[
    al_release_deployment(
        name = "publication." + environment,
        ssh_environment = environment,
        ssh_host = host,
        ssh_public_url = "https://download.alwaldend.com",
        ssh_publish_user = "download",
        ssh_user = "ansible",
    )
    for environment, host in _HOSTS.items()
]

[
    ssh_binary(
        name = "ssh." + environment,
        args = [
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=10",
            "-o",
            "IdentityAgent=none",
            "-o",
            "IdentitiesOnly=yes",
            "-o",
            "IdentityFile=$${DOWNLOAD_SSH_PRIVATE_KEY}",
            "-o",
            "CertificateFile=$${DOWNLOAD_SSH_CERTIFICATE}",
            "-o",
            "UserKnownHostsFile=$${DOWNLOAD_SSH_KNOWN_HOSTS}",
            "-o",
            "GlobalKnownHostsFile=/dev/null",
            "-o",
            "StrictHostKeyChecking=yes",
            "ansible@" + host,
        ],
        configs = [":al"],
        plugin_labels = {"ssh": "1"},
        visibility = ["//infra:__subpackages__"],
    )
    for environment, host in _HOSTS.items()
]

[
    al_release_binary(
        name = operation + "." + environment + ".command",
        arguments = [
            "--environment",
            environment,
            "--ssh_config",
            "/dev/null",
            "--ssh_identity",
            "$${DOWNLOAD_SSH_PRIVATE_KEY}",
            "--ssh_disable_agent",
            "--ssh_certificate",
            "$${DOWNLOAD_SSH_CERTIFICATE}",
            "--ssh_known_hosts",
            "$${DOWNLOAD_SSH_KNOWN_HOSTS}",
        ],
        command = command,
        ssh_deployment = ":publication." + environment,
    )
    for environment in _HOSTS
    for operation, command in _CONTENT_COMMANDS.items()
]

[
    al_binary_run(
        name = operation + "." + environment,
        args = ["$(rootpath :" + operation + "." + environment + ".command)"],
        configs = [":al"],
        data = [
            ":" + operation + "." + environment + ".command",
        ],
        plugin_labels = {"ssh": "1"},
    )
    for environment in _HOSTS
    for operation in _CONTENT_COMMANDS
]

al_vault_auth(
    name = "auth",
    approle = "src_infra_download",
    extends = "//tools/al:auth",
)

vault_tf_backend(
    name = "tf_backend_local",
    labels = {"tf": "local"},
    path = "alwaldend.com/vault1/approles/src_infra_download/tf_backend/local",
)

vault_tf_backend(
    name = "tf_backend_yandex",
    extends = ":tf_backend_local",
    labels = {"tf": "yandex"},
    path = "alwaldend.com/vault1/approles/src_infra_download/tf_backend/yandex",
)

vault_tf_backend(
    name = "tf_backend_dns",
    extends = ":tf_backend_yandex",
    labels = {"tf": "dns"},
    path = "alwaldend.com/vault1/approles/src_infra_download/tf_backend/dns",
)

infra_yc_auth(
    name = "yc_auth",
    labels = {"tf": "yandex"},
    path = "yandex.cloud/org1/folders/src-infra-download/account_iam_key",
)

infra_dns(
    name = "dns_providers",
    dc1 = True,
    labels = {"tf": "dns"},
)

infra_download_ssh(
    name = "ssh",
    labels = {"ssh": "1"},
)

infra_xo_login(
    name = "xo_login",
    labels = {"xoa_login": "1"},
    oidc_provider = "src_infra_xcp_ng_provider",
)

al_config(
    name = "al",
    configs = [
        ":auth",
        ":dns_providers",
        ":ssh",
        ":tf_backend_dns",
        ":tf_backend_local",
        ":tf_backend_yandex",
        ":xo_login",
        ":yc_auth",
        "//infra:al",
    ],
    visibility = ["//infra/download:__subpackages__"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

al_binary_run(
    name = "sync.yandex",
    args = [
        "$(rootpath //infra/download/ansible:ansible_bin)",
        "--inventory",
        "inventory.yaml",
        "playbook_sync.yaml",
    ],
    configs = [":al"],
    data = [
        "//infra/download/ansible:ansible_bin",
    ],
    plugin_labels = {"ssh": "1"},
    visibility = ["//infra:__subpackages__"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
        exclude = ["test/**"],
    ),
)
