load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/al/rules/al:al_config.bzl", "al_config")
load("//tools/release/main/bzl:al_release_binary.bzl", "al_release_binary")
load("//tools/release/main/bzl:al_release_deployment.bzl", "al_release_deployment")
load("//tools/ssh:defs.bzl", "ssh_binary")
load("//tools/vault:defs.bzl", "vault_binary_map")

package(transitive_visibility = "//infra:transitive_consumers")

_HOSTS = {
    "local": "host1.dc1.download.alwaldend.com",
    "yandex": "host1.yc.download.alwaldend.com",
}

[
    al_release_deployment(
        name = "publication." + environment,
        ssh_environment = environment,
        ssh_host = host,
        ssh_public_url = "https://download.alwaldend.com",
        ssh_publish_user = "download",
        ssh_user = "ansible",
    )
    for environment, host in _HOSTS.items()
]

[
    ssh_binary(
        name = "ssh." + environment,
        args = [
            "-F",
            "/dev/null",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=10",
            "-o",
            "IdentityAgent=none",
            "-o",
            "IdentitiesOnly=yes",
            "-o",
            "IdentityFile=$${DOWNLOAD_SSH_PRIVATE_KEY}",
            "-o",
            "CertificateFile=$${DOWNLOAD_SSH_CERTIFICATE}",
            "-o",
            "UserKnownHostsFile=$${DOWNLOAD_SSH_KNOWN_HOSTS}",
            "-o",
            "GlobalKnownHostsFile=/dev/null",
            "-o",
            "StrictHostKeyChecking=yes",
            "ansible@" + host,
        ],
        configs = [":al"],
        data = ["//tools/vault/injector"],
        run_args = [
            "--plugin_label",
            "ssh=1",
        ],
        visibility = ["//infra:__subpackages__"],
    )
    for environment, host in _HOSTS.items()
]

[
    al_release_binary(
        name = "publish." + environment,
        arguments = [
            "--environment",
            environment,
        ],
        oras = None,
        ssh_deployment = ":publication." + environment,
    )
    for environment in [
        "local",
        "yandex",
    ]
]

al_config(
    name = "al",
    srcs = ["al.lua"],
    data = ["//data/ssh:ca_servers"],
    visibility = ["//infra/download:__subpackages__"],
    deps = ["//infra:al"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
