load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "inventory",
    srcs = ["inventory.yaml"],
    visibility = ["//infra/security:fleet_inventory_consumers"],
)

al_ansible_package(
    name = "ansible",
    srcs = [
        "inventory.yaml",
        "playbook_deploy.yaml",
        "playbook_sync.yaml",
    ] + glob([
        "group_vars/**",
        "files/**",
        "tasks/**",
    ]),
    args = {environment: [
        "--inventory",
        "inventory.yaml",
        "--limit",
        "download_" + environment,
        "playbook_deploy.yaml",
    ] for environment in [
        "local",
        "yandex",
    ]},
    binary_visibility = ["//infra/download:__subpackages__"],
    configs = ["//infra/download:al"],
    extra_vars_files = ["//infra/victoria_metrics/dns:metrics_vars"],
    files_name = "files",
    plugin_labels = {
        "vault_env": "default_default",
        "ssh": "1",
    },
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/download:__pkg__"],
)
