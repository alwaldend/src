load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

mermaid_diagram(
    name = "architecture",
    src = "architecture.mmd",
    out = "rendered/architecture",
)

mermaid_diagram(
    name = "deployment",
    src = "deployment.mmd",
    out = "rendered/deployment",
    webp_aspect_ratio = [],
    webp_scale = 2,
)

mermaid_diagram(
    name = "operations",
    src = "operations.mmd",
    out = "rendered/operations",
)

docs_filegroup(
    name = "docs",
    srcs = [
        ":architecture_svg",
        ":deployment_dark_webp",
        ":deployment_svg",
        ":operations_svg",
    ],
    prefix = "content/docs/infra/download/assets",
    visibility = ["//infra/download:__pkg__"],
)
