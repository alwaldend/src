load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg", "mermaid_site_webp")

package(transitive_visibility = "//infra:transitive_consumers")

[
    mermaid_site_svg(
        name = diagram,
        src = diagram + ".mmd",
        out = "rendered/" + diagram + ".svg",
    )
    for diagram in [
        "architecture",
        "deployment",
        "operations",
    ]
]

mermaid_site_webp(
    name = "deployment_dark_webp",
    src = "deployment.mmd",
    out = "rendered/deployment.dark.webp",
    aspect_ratio = [],
    color_scheme = "dark",
    scale = 2,
)

docs_filegroup(
    name = "docs",
    srcs = [
        ":architecture",
        ":deployment",
        ":deployment_dark_webp",
        ":operations",
    ],
    prefix = "content/docs/infra/download/assets",
    visibility = ["//infra/download:__pkg__"],
)
