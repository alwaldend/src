load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg")

package(transitive_visibility = "//infra:transitive_consumers")

[
    mermaid_site_svg(
        name = diagram,
        src = diagram + ".mmd",
        out = "rendered/" + diagram + ".svg",
    )
    for diagram in [
        "architecture",
        "deployment",
        "operations",
    ]
]

docs_filegroup(
    name = "docs",
    srcs = [
        ":architecture",
        ":deployment",
        ":operations",
    ],
    prefix = "content/docs/infra/download/assets",
    visibility = ["//infra/download:__pkg__"],
)
