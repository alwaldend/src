load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")
load("//tools/rules_terraform/terraform:defs.bzl", "terraform_binary")

package(transitive_visibility = "//infra:transitive_consumers")

_DATA = glob([
    "*.tf",
    "tests/*.tftest.hcl",
]) + [
    "//infra/download/dns:dnsconfig",
    "//infra/dns/dns:dnsconfig",
    "//infra/cloud_init:xen_linux",
    "//infra/xcp_ng/cmd/xo_login",
]

_PROVIDERS = ["@terraform_provider_vatesfr_xenorchestra//:provider"]

al_terraform_package(
    name = "tf",
    configs = ["//infra/download:al"],
    data = _DATA,
    plugin_labels = {
        "tf": "local",
        "xoa_login": "1",
    },
    providers = _PROVIDERS,
)

# Offline init/validate entry point: no AL plugins, backend, or credentials.
terraform_binary(
    name = "offline",
    testonly = True,
    arguments = ["--direct"],
    data = _DATA,
    providers = _PROVIDERS,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/download:__pkg__"],
)
