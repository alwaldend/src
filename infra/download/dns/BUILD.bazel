load("//infra/dns/terraform:defs.bzl", "infra_terraform_dns")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

infra_terraform_dns(
    name = "tf",
    configs = ["//infra/download:al"],
    data = glob(["tests/*.tftest.hcl"]),
    dc1 = True,
    import_addresses = True,
    offline = True,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/download:__pkg__"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)
