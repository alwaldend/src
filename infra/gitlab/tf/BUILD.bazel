load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/gitlab:__pkg__"],
)

al_terraform_package(
    name = "tf",
    configs = ["//infra/gitlab:al"],
    data = glob(["*.tf"]) + [
        "//infra/repos:config",
        "//infra/repos/tf:module",
    ],
    plugin_labels = {"tf": "main"},
    providers = [
        "@terraform_provider_gitlabhq_gitlab//:provider",
    ],
    tests_use_al = True,
)
