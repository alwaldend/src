load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

mermaid_diagram(
    name = "network",
    src = "network.mmd",
    out = "rendered/network",
)

docs_filegroup(
    name = "docs",
    srcs = glob([
        "*.md",
        "*.mmd",
    ]),
    preserve_paths = True,
    visibility = ["//infra/printers:__pkg__"],
    deps = [":docs_assets"],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [":network_svg"],
    prefix = "content/docs/infra/printers/docs/assets",
)
