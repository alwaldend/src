load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

al_terraform_package(
    name = "tf",
    configs = ["//infra/printers:al"],
    data = glob(["*.tf"]) + ["//infra/printers/dns:dnsconfig"],
    plugin_labels = {"tf": "main"},
    providers = ["@terraform_provider_terraform_routeros_routeros//:provider"],
    test_kwargs = {
        "args": {
            "fmt": [
                "--direct",
                "fmt",
                "--check",
                "--recursive",
            ],
            "validate": ["validate"],
        },
        # Omit only the operational backend so checks initialize without Vault.
        "data": glob(
            ["*.tf"],
            exclude = ["backend.tf"],
        ) + ["//infra/printers/dns:dnsconfig"],
    },
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/printers:__pkg__"],
)
