load("@rules_al//:defs.bzl", "al_binary_run")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary_map", "terraform_test_map")

package(transitive_visibility = "//infra:transitive_consumers")

_PROVIDERS = [
    "@terraform_provider_cloudflare_cloudflare//:provider",
    "@terraform_provider_terraform_routeros_routeros//:provider",
]

_DATA = glob(["*.tf"]) + [
    "//infra/printers:dnsconfig",
    "//projects/tf_modules/dns_records:dns_records",
]

terraform_binary_map(
    name = "tf",
    data = _DATA + [
        "//tools/vault/injector",
        "//tools/vault/tf_backend",
    ],
    providers = _PROVIDERS,
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": ["//infra/printers:al"],
        "run_args": [
            "--plugin_label",
            "tf=dns",
        ],
    },
)

terraform_test_map(
    name = "tf_tests",
    args = {
        "fmt": [
            "--direct",
            "fmt",
            "--check",
            "--recursive",
        ],
        "validate": ["validate"],
    },
    data = glob(
        ["*.tf"],
        exclude = ["backend.tf"],
    ) + [
        "//infra/printers:dnsconfig",
        "//projects/tf_modules/dns_records",
    ],
    providers = _PROVIDERS,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/printers:__pkg__"],
)
