load("//infra/dns/terraform:defs.bzl", "infra_terraform_dns")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

infra_terraform_dns(
    name = "tf",
    configs = ["//infra/printers:al"],
    dc1 = True,
    validate = True,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/printers:__pkg__"],
)

filegroup(
    name = "dnsconfig",
    srcs = [
        "dnsconfig.json",
    ],
    visibility = ["//infra/printers:__subpackages__"],
)
