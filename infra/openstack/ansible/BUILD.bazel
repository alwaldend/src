load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/ansible/main/bzl:al_ansible_binary.bzl", "al_ansible_binary")
load("//tools/docs:defs.bzl", "docs_filegroup")


def _prepare_binary(name, action):
    al_ansible_binary(
        name = name,
        arguments = [
            "--inventory",
            "inventory.json",
            "--extra-vars",
            "@config.json",
            "--extra-vars",
            "openstack_action={}".format(action),
            "playbook_prepare.yaml",
        ],
        data = [
            ":srcs",
            "//infra:ansible_cfg",
            "//projects/ansible_collection:collections",
        ],
        process_name = "ansible_playbook",
        visibility = ["//infra/openstack:__pkg__"],
    )


_prepare_binary(
    name = "prepare_deploy",
    action = "deploy",
)

_prepare_binary(
    name = "prepare_prechecks",
    action = "prechecks",
)

_prepare_binary(
    name = "prepare_reconfigure",
    action = "reconfigure",
)

py_binary(
    name = "launcher",
    srcs = [
        "launcher.py",
        "render_inventory.py",
    ],
    visibility = ["//infra/openstack:__pkg__"],
)

py_test(
    name = "launcher_test",
    srcs = [
        "launcher.py",
        "launcher_test.py",
        "render_inventory.py",
    ],
    main = "launcher_test.py",
)

py_test(
    name = "render_inventory_test",
    srcs = [
        "render_inventory.py",
        "render_inventory_test.py",
    ],
    main = "render_inventory_test.py",
)

filegroup(
    name = "config",
    srcs = ["config.json"],
    visibility = ["//infra/openstack:__pkg__"],
)

filegroup(
    name = "inventory",
    srcs = ["inventory.json"],
    visibility = ["//infra/openstack:__pkg__"],
)

pkg_filegroup(
    name = "srcs",
    srcs = [":srcs_files"],
)

pkg_files(
    name = "srcs_files",
    srcs = [
        "config.json",
        "inventory.json",
        "openstack_prepare_root.marker",
        "playbook_prepare.yaml",
    ] + glob([
        "roles/**",
    ]),
    strip_prefix = strip_prefix.from_pkg(),
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/openstack:__pkg__"],
)
