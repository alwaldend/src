{
  "all": {
    "children": {
      "openstack": {
        "children": {
          "openstack_master": {
            "hosts": {
              "master1.openstack1.dc1.alwaldend.com": {
                "ansible_user": "ansible",
                "ansible_become": true,
                "ansible_python_interpreter": "/usr/bin/python3",
                "openstack_service_hostname": "master1",
                "openstack_management_interface": "CHANGE_ME",
                "openstack_external_interface": "CHANGE_ME",
                "openstack_fast_devices": [
                  "/dev/disk/by-id/CHANGE_ME_SATA_SSD_1",
                  "/dev/disk/by-id/CHANGE_ME_SATA_SSD_2"
                ],
                "openstack_bulk_devices": [
                  "/dev/disk/by-id/CHANGE_ME_DAS_HDD_1",
                  "/dev/disk/by-id/CHANGE_ME_DAS_HDD_2",
                  "/dev/disk/by-id/CHANGE_ME_DAS_HDD_3",
                  "/dev/disk/by-id/CHANGE_ME_DAS_HDD_4"
                ]
              }
            }
          },
          "openstack_compute": {
            "hosts": {
              "compute1.openstack1.dc1.alwaldend.com": {
                "ansible_user": "ansible",
                "ansible_become": true,
                "ansible_python_interpreter": "/usr/bin/python3",
                "openstack_service_hostname": "compute1",
                "openstack_management_interface": "CHANGE_ME",
                "openstack_compute_ephemeral_device":
                  "/dev/disk/by-id/CHANGE_ME_2TB_NVME"
              }
            }
          }
        }
      }
    }
  }
}
