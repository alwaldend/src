load("@rules_al//:defs.bzl", "al_config")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

_DATA = glob(["*.tf"]) + ["//projects/tf_modules/truenas_dataset"]

vault_tf_backend(
    name = "approle_backend",
    extends = "//infra/nas:truenas_backend",
    labels = {"tf": "approle_src_infra_dev"},
    path = "alwaldend.com/vault1/approles/src_infra_nas/tf_backend/approles/src_infra_dev",
)

al_config(
    name = "al",
    configs = [
        ":approle_backend",
        "//infra/nas:al",
    ],
)

al_terraform_package(
    name = "tf",
    configs = [":al"],
    data = _DATA,
    plugin_labels = {
        "tf": "approle_src_infra_dev",
        "truenas": "",
        "vault_env": "default_default",
    },
    providers = ["@terraform_provider_truenas_truenas//:provider"],
    test_kwargs = {
        "args": {
            "fmt": [
                "--direct",
                "fmt",
                "-check",
                "-recursive",
            ],
            "validate": ["validate"],
        },
        "data": [path for path in _DATA if path != "backend.tf"],
    },
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/nas/approles:__pkg__"],
)
