load("@rules_al//:defs.bzl", "al_config", "al_inject", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_dns")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

al_vault_auth(
    name = "auth",
    approle = "src_infra_nas",
    extends = "//tools/al:auth",
)

vault_tf_backend(
    name = "tf_backend",
    labels = {"tf": "main"},
    path = "alwaldend.com/vault1/approles/src_infra_nas/tf_backend/tf",
)

infra_dns(
    name = "dns_providers",
    dc1 = True,
    labels = {"tf": "main"},
)

vault_tf_backend(
    name = "truenas_backend",
    labels = {"tf": "truenas"},
    path = "alwaldend.com/vault1/approles/src_infra_nas/tf_backend/truenas",
)

al_inject(
    name = "truenas_connection",
    labels = {"tf": "truenas"},
    res_env = {
        "TRUENAS_ENDPOINT": {
            "value": "{{ .Last.Data.endpoint }}",
            "deps": ["truenas_connection"],
        },
        "TRUENAS_API_KEY": {
            "value": "{{ .Last.Data.api_key }}",
            "deps": ["truenas_connection"],
        },
    },
    res_kv = {"truenas_connection": {
        "mount": "secrets",
        "path": "alwaldend.com/vault1/approles/src_infra_nas/truenas",
    }},
)

al_config(
    name = "al",
    configs = [
        ":auth",
        ":dns_providers",
        ":tf_backend",
        ":truenas_backend",
        ":truenas_connection",
        "//infra:al",
    ],
    visibility = ["//infra/nas:__subpackages__"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
