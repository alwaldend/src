load("@rules_al//:defs.bzl", "al_config", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_dns")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

al_vault_auth(
    name = "auth",
    approle = "src_infra_nas",
    extends = "//tools/al:auth",
)

vault_tf_backend(
    name = "tf_backend",
    labels = {"tf": "main"},
    path = "alwaldend.com/vault1/approles/src_infra_nas/tf_backend/tf",
)

infra_dns(
    name = "dns_providers",
    dc1 = True,
    labels = {"tf": "main"},
)

al_config(
    name = "al",
    configs = [
        ":auth",
        ":dns_providers",
        ":tf_backend",
        "//infra:al",
    ],
    visibility = ["//infra/nas:__subpackages__"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
