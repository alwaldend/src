load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/ingress:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

filegroup(
    name = "inventory",
    srcs = ["inventory.yaml"],
    visibility = [
        "//infra/ingress:__subpackages__",
        "//infra/security:fleet_inventory_consumers",
        "//infra/victoria_metrics/ansible:__pkg__",
    ],
)

al_ansible_package(
    name = "ansible",
    srcs = [
        "inventory.yaml",
        "//infra/grafana/dns:dnsconfig",
        "//infra/mlflow/dns:dnsconfig",
    ] + glob([
        "group_vars/**/*.yaml",
        "files/**",
        "playbook_*.yaml",
    ]),
    configs = ["//infra/ingress:al"],
    extra_vars_files = ["//infra/victoria_metrics/dns:metrics_vars"],
    plugin_labels = {
        "vault_env": "default_default",
        "ansible": "",
    },
    renames = {
        "//infra/grafana/dns:dnsconfig": "files/grafana-dns.json",
        "//infra/mlflow/dns:dnsconfig": "files/mlflow-dns.json",
    },
)
