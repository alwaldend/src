load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/terraform:defs.bzl", "terraform_binary_map", "terraform_target_binary_map", "terraform_test_map")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/ingress:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_CONFIGS = ["//infra/ingress:al"]

_DATA = glob(["*.tf"]) + [
    ".terraform.lock.hcl",
    "//projects/tf_modules/dns_records:dns_records",
    "//infra/ingress:dnsconfig",
    "//infra/ingress/ansible:inventory",
    "//tools/vault/tf_backend",
    "//tools/vault/injector",
    "//infra/cloud_init:cloud_init",
]

terraform_binary_map(
    name = "tf",
    configs = _CONFIGS,
    data = _DATA,
    run_args = [
        "--plugin_label",
        "tf",
    ],
)

terraform_target_binary_map(
    name = "dns",
    configs = _CONFIGS,
    data = _DATA,
    run_args = [
        "--plugin_label",
        "dns=1",
    ],
    target = "module.dns",
)

terraform_test_map(
    name = "tf_tests",
    data = _DATA,
)
