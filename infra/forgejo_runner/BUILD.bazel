load("@rules_al//:defs.bzl", "al_config", "al_inject", "al_plugin", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_ansible_keys", "infra_dns", "infra_pve_provider_inputs")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

al_vault_auth(
    name = "auth",
    approle = "src_infra_forgejo_runner",
    extends = "//tools/al:auth",
)

infra_ansible_keys(
    name = "ansible_keys",
    labels = {"ansible": "1"},
    vault_ssh = {
        "backend": "ssh/clients/sign/admins",
        "ttl": 7200,
    },
)

vault_tf_backend(
    name = "tf_backend_tf_setup",
    labels = {
        "dns": "1",
        "tf": "setup",
    },
    path = "alwaldend.com/vault1/approles/src_infra_forgejo_runner/tf_backend/tf_setup",
)

al_plugin(
    name = "pve_login",
    labels = {"tf": "setup"},
)

al_inject(
    name = "config",
    labels = {"ansible": "1"},
    res_env = {"FORGEJO_RUNNER_TOKEN": {
        "value": "{{ .Last.Data.runner_token }}",
        "deps": ["config"],
    }},
    res_kv = {"config": {
        "mount": "secrets",
        "path": "alwaldend.com/vault1/approles/src_infra_forgejo_runner/config",
    }},
)

infra_pve_provider_inputs(
    name = "pve_provider_inputs",
    labels = {"dns": "1"},
)

infra_dns(
    name = "dns_providers",
    dc1 = True,
    global_records = False,
    labels = {
        "dns": "1",
        "tf": "setup",
    },
)

al_config(
    name = "al",
    configs = [
        ":ansible_keys",
        ":auth",
        ":config",
        ":dns_providers",
        ":pve_login",
        ":pve_provider_inputs",
        ":tf_backend_tf_setup",
        "//infra:al",
    ],
    visibility = ["//infra/forgejo_runner:__subpackages__"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
