load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//projects/al/rules/al:al_binary.bzl", "al_binary_run", "al_binary_run_map")
load("//tools/ansible/main/bzl:al_ansible_binary.bzl", "al_ansible_binary")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/forgejo_runner:__pkg__"],
)

al_binary_run_map(
    name = "ansible",
    args = {"": [
        "$(rootpath :ansible_bin)",
        "--inventory",
        "inventory.yaml",
        "playbook_deploy.yaml",
    ]},
    configs = ["//infra/forgejo_runner:al"],
    data = [
        ":ansible_bin",
        "//tools/vault/injector",
    ],
    run_args = [
        "--plugin_label",
        "vault_env=default_default",
        "--plugin_label",
        "ansible",
    ],
)

al_ansible_binary(
    name = "ansible_bin",
    data = [
        ":srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_playbook",
)

al_binary_run(
    name = "registration",
    args = [
        "$(rootpath :ansible_bin)",
        "--inventory",
        "inventory.yaml",
        "playbook_registration.yaml",
    ],
    configs = ["//infra/forgejo_runner:al"],
    data = [
        ":ansible_bin",
        "//tools/vault/forgejo_login",
        "//tools/vault/injector",
    ],
    run_args = [
        "--plugin_label",
        "vault_env=default_default",
        "--plugin_label",
        "registration=1",
    ],
)

pkg_filegroup(
    name = "srcs",
    srcs = [
        ":android_files",
        ":srcs_files",
        ":ssh_ca_files",
    ],
)

pkg_files(
    name = "ssh_ca_files",
    srcs = ["//data/ssh:ca_servers"],
    prefix = "files",
    renames = {"//data/ssh:ca_servers": "ssh_ca_servers.pub"},
)

pkg_files(
    name = "srcs_files",
    srcs = ["inventory.yaml"] + glob([
        "group_vars/**/*.yaml",
        "files/**",
        "playbook_*.yaml",
    ]),
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_files(
    name = "android_files",
    srcs = [
        "//tools/android:installer_tar",
        "//tools/android:packages.txt",
    ],
    prefix = "files",
    renames = {
        "//tools/android:installer_tar": "android_installer.tar.gz",
        "//tools/android:packages.txt": "android_packages.txt",
    },
)
