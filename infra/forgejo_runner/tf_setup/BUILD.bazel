load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary_map", "terraform_target_binary_map", "terraform_test_map")
load("//projects/al/rules/al:al_binary.bzl", "al_binary_run", "al_binary_run_test")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/forgejo_runner:__pkg__"],
)

_PROVIDERS = [
    "@terraform_provider_cloudflare_cloudflare//:provider",
    "@terraform_provider_terraform_routeros_routeros//:provider",
    "@terraform_provider_vatesfr_xenorchestra//:provider",
]

_CONFIGS = ["//infra/forgejo_runner:al"]

_RUN_ARGS = [
    "--plugin_label",
    "tf=setup",
    "--plugin_label",
    "xoa_login=1",
]

_DATA = glob(["*.tf"]) + [
    "//projects/tf_modules/dns_records:dns_records",
    "//infra/cloud_init:xen_linux",
    "//infra/forgejo_runner:dnsconfig",
    "//infra/xcp_ng/cmd/xo_login",
    "//tools/vault/tf_backend",
    "//tools/vault/injector",
]

terraform_binary_map(
    name = "tf_setup",
    data = _DATA,
    providers = _PROVIDERS,
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": _CONFIGS,
        "run_args": _RUN_ARGS,
    },
)

terraform_target_binary_map(
    name = "runner",
    data = _DATA,
    providers = _PROVIDERS,
    target = "xenorchestra_vm.runner",
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": _CONFIGS,
        "run_args": [
            "--plugin_label",
            "runner=1",
            "--plugin_label",
            "xoa_login=1",
        ],
    },
)

terraform_target_binary_map(
    name = "dns",
    data = _DATA,
    providers = _PROVIDERS,
    target = "module.dns",
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": _CONFIGS,
        "run_args": [
            "--plugin_label",
            "dns=1",
        ],
    },
)

terraform_test_map(
    name = "tf_tests",
    data = _DATA,
    providers = _PROVIDERS,
    wrapper = al_binary_run_test,
    wrapper_kwargs = {
        "configs": _CONFIGS,
    },
)
