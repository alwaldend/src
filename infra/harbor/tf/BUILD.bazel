load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary_map", "terraform_test_map")
load("//projects/al/rules/al:al_binary.bzl", "al_binary_run", "al_binary_run_test")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/harbor:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_PROVIDERS = [
    "@terraform_provider_goharbor_harbor//:provider",
    "@terraform_provider_hashicorp_vault//:provider",
]

_CONFIGS = ["//infra/harbor:al"]

_RUN_ARGS = [
    "--plugin_label",
    "tf=main",
    "--plugin_label",
    "vault_env=default_default",
]

_DATA = glob(["*.tf"]) + [
    "//tools/vault/tf_backend",
    "//tools/vault/injector",
    "//tools/vault/harbor_login",
]

terraform_binary_map(
    name = "tf",
    data = _DATA,
    providers = _PROVIDERS,
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": _CONFIGS,
        "run_args": _RUN_ARGS,
    },
)

terraform_test_map(
    name = "tf_tests",
    data = _DATA,
    providers = _PROVIDERS,
    wrapper = al_binary_run_test,
    wrapper_kwargs = {
        "configs": _CONFIGS,
    },
)
