load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

mermaid_diagram(
    name = "archive_harbor",
    src = "archive-harbor.mmd",
    out = "rendered/archive-harbor",
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.mmd"]),
    visibility = ["//infra/harbor:__pkg__"],
    deps = [":docs_assets"],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":archive_harbor_svg",
    ],
    prefix = "content/docs/infra/harbor/docs/assets",
)
