load("@rules_al//:defs.bzl", "al_binary_run")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary_map", "terraform_test_map")

package(transitive_visibility = "//infra:transitive_consumers")

_PROVIDERS = [
    "@terraform_provider_hashicorp_random//:provider",
    "@terraform_provider_hashicorp_vault//:provider",
    "@terraform_provider_terraform_routeros_routeros//:provider",
]

_DATA = glob(["*.tf"])

terraform_binary_map(
    name = "tf",
    data = _DATA + [
        "//tools/vault/injector",
        "//tools/vault/tf_backend",
    ],
    providers = _PROVIDERS,
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": ["//infra/mikrotik:al"],
        "run_args": [
            "--plugin_label",
            "tf=accounts",
        ],
    },
)

terraform_test_map(
    name = "tf_tests",
    args = {
        "fmt": [
            "--direct",
            "fmt",
            "--check",
            "--recursive",
        ],
        "validate": ["validate"],
    },
    # Omit only the operational backend so checks initialize without Vault.
    data = glob(
        ["*.tf"],
        exclude = ["backend.tf"],
    ),
    providers = _PROVIDERS,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/mikrotik:__pkg__"],
)
