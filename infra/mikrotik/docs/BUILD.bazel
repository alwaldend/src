load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

mermaid_diagram(
    name = "dc1",
    src = "dc1.mmd",
    out = "rendered/dc1",
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.mmd"]),
    visibility = ["//infra/mikrotik:__pkg__"],
    deps = [":docs_assets"],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":dc1_svg",
    ],
    prefix = "content/docs/infra/mikrotik/docs/assets",
)
