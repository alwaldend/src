load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg")

mermaid_site_svg(
    name = "dc1",
    src = "dc1.mmd",
    out = "rendered/dc1.svg",
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.mmd"]),
    visibility = ["//infra/mikrotik:__pkg__"],
    deps = [":docs_assets"],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":dc1",
    ],
    prefix = "content/docs/infra/mikrotik/docs/assets",
)
