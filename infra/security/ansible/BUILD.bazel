load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("//tools/ansible/rules:al_ansible_binary.bzl", "al_ansible_binary")
load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")
load(":inventories.bzl", "INVENTORIES")

package(transitive_visibility = "//infra:transitive_consumers")

al_ansible_package(
    name = "ansible",
    srcs = ["playbook_security.yaml"],
    args = {"": [
        "--inventory",
        "inventories",
        "playbook_security.yaml",
    ]},
    configs = ["//infra/security:al"],
    files_name = "files",
    packaged_srcs = [
        ":files",
        ":inventories",
        ":lynis_archive",
    ],
    plugin_labels = {"maintenance": "1"},
)

al_ansible_package(
    name = "clamav",
    srcs = ["playbook_clamav.yaml"],
    args = {"": [
        "--inventory",
        "inventories",
        "playbook_clamav.yaml",
    ]},
    configs = ["//infra/security:al"],
    files_name = "clamav_playbook",
    packaged_srcs = [
        ":clamav_playbook",
        ":inventories",
        "//infra/security/clamav:runtime",
    ],
    plugin_labels = {"maintenance": "1"},
    srcs_name = "clamav_srcs",
)

al_ansible_binary(
    name = "clamav_syntax",
    arguments = [
        "--syntax-check",
        "--inventory",
        "inventories",
        "playbook_clamav.yaml",
    ],
    data = [
        ":clamav_srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_playbook",
)

pkg_files(
    name = "inventories",
    srcs = INVENTORIES.values(),
    renames = {label: "inventories/" + owner + ".yaml" for owner, label in INVENTORIES.items()},
)

pkg_files(
    name = "lynis_archive",
    srcs = ["//third_party/com_github_cisofy_lynis:archive"],
    renames = {"//third_party/com_github_cisofy_lynis:archive": "files/lynis.tar.gz"},
)

docs_filegroup(
    name = "docs",
    srcs = [],
    visibility = ["//infra/security:__pkg__"],
)
