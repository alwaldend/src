load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("//tools/ansible/rules:al_ansible_binary.bzl", "al_ansible_binary")
load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")

package(transitive_visibility = "//infra:transitive_consumers")

al_ansible_package(
    name = "ansible",
    srcs = glob([
        "files/*.sh",
        "group_vars/*.yaml",
        "playbook_*.yaml",
        "tasks/*.yaml",
    ]),
    args = {
        "": [
            "--inventory",
            "inventory.yaml",
            "playbook_audit.yaml",
        ],
        "status": [
            "--inventory",
            "inventory.yaml",
            "playbook_status.yaml",
        ],
        "update_xcpng": [
            "--inventory",
            "inventory.yaml",
            "playbook_update_xcpng.yaml",
        ],
        "update_xoa": [
            "--inventory",
            "inventory.yaml",
            "playbook_update_xoa.yaml",
        ],
    },
    configs = ["//infra/xcp_ng:al"],
    files_name = "files",
    packaged_srcs = [
        ":files",
        ":inventory",
        ":lynis_archive",
    ],
    plugin_labels = {
        "xcp_ng_ansible": "1",
        "xcpng_host": "1",
    },
)

al_ansible_package(
    name = "clamav",
    srcs = ["playbook_clamav.yaml"] + glob(["group_vars/*.yaml"]),
    args = {"": [
        "--inventory",
        "inventory.yaml",
        "playbook_clamav.yaml",
    ]},
    configs = ["//infra/xcp_ng:al"],
    files_name = "clamav_files",
    packaged_srcs = [
        ":clamav_files",
        ":inventory",
        "//infra/security/clamav:runtime",
    ],
    plugin_labels = {"xcp_ng_ansible": "1"},
    srcs_name = "clamav_srcs",
)

al_ansible_binary(
    name = "clamav_syntax",
    arguments = [
        "--syntax-check",
        "--inventory",
        "inventory.yaml",
        "playbook_clamav.yaml",
    ],
    data = [
        ":clamav_srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_playbook",
)

al_ansible_binary(
    name = "syntax",
    arguments = [
        "--syntax-check",
        "--inventory",
        "inventory.yaml",
        "playbook_audit.yaml",
        "playbook_status.yaml",
        "playbook_update_xcpng.yaml",
        "playbook_update_xoa.yaml",
    ],
    data = [
        ":srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_playbook",
)

pkg_files(
    name = "inventory",
    srcs = ["//infra/xcp_ng/ansible:inventory"],
    renames = {"//infra/xcp_ng/ansible:inventory": "inventory.yaml"},
)

pkg_files(
    name = "lynis_archive",
    srcs = ["//third_party/com_github_cisofy_lynis:archive"],
    renames = {"//third_party/com_github_cisofy_lynis:archive": "files/lynis.tar.gz"},
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/security:__pkg__"],
)
