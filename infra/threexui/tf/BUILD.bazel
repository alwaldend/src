load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map", "al_terraform_test_map")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/threexui:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_PROVIDERS = [
    "@terraform_provider_batonogov_threexui//:provider",
    "@terraform_provider_hashicorp_vault//:provider",
]

_CONFIGS = ["//infra/threexui:al"]

_PLUGIN_LABELS = {
    "tf": "main",
    "vault_env": "default_default",
}

_DATA = glob([
    "*.tf",
    "node/*.tf",
]) + [
    "//data/mullvad:relays",
]

al_terraform_binary_map(
    name = "tf",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = _PLUGIN_LABELS,
    providers = _PROVIDERS,
)

al_terraform_test_map(
    name = "tf_tests",
    configs = _CONFIGS,
    data = _DATA,
    providers = _PROVIDERS,
)
