load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "inventory",
    srcs = ["inventory.yaml"],
    visibility = ["//infra/security:fleet_inventory_consumers"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/threexui:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_ansible_package(
    name = "ansible",
    srcs = [
        "inventory.yaml",
    ] + glob([
        "group_vars/**/*.yaml",
        "files/**",
        "playbook_*.yaml",
    ]),
    configs = ["//infra/threexui:al"],
    extra_vars_files = ["//infra/victoria_metrics/dns:metrics_vars"],
    plugin_labels = {
        "vault_env": "default_default",
        "ansible": "",
    },
)
