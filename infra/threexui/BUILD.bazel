load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/al/rules/al:al_binary.bzl", "al_binary_run_map")
load("//projects/al/rules/al:al_config.bzl", "al_config")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg", "mermaid_site_webp")
load("//tools/vault:defs.bzl", "vault_binary_map")

al_config(
    name = "al",
    srcs = ["al.lua"],
    visibility = ["//infra/threexui:__subpackages__"],
    deps = ["//infra:al"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

al_binary_run_map(
    name = "fix_subs",
    args = {
        "": [
            "$(rootpath //infra/threexui/sub)",
        ],
    },
    configs = [":al"],
    data = [
        "//infra/threexui/sub",
        "//tools/vault/injector",
    ],
    run_args = [
        "--plugin_label",
        "sub",
    ],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]) + ["architecture.mmd"],
    visibility = ["//infra:__pkg__"],
    deps = [":docs_assets"] + subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

mermaid_site_svg(
    name = "architecture",
    src = "architecture.mmd",
    out = "rendered/architecture.svg",
)

mermaid_site_webp(
    name = "architecture_webp",
    src = "architecture.mmd",
    out = "rendered/architecture.webp",
    scale = 2,
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":architecture",
        ":architecture_webp",
    ],
    prefix = "content/docs/infra/threexui/assets",
)
