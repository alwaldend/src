load("@rules_al//:defs.bzl", "al_binary_run_map", "al_config")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/vault:defs.bzl", "vault_binary_map")

package(transitive_visibility = "//infra:transitive_consumers")

al_config(
    name = "al",
    srcs = ["al.lua"],
    visibility = ["//infra/threexui:__subpackages__"],
    deps = ["//infra:al"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

al_binary_run_map(
    name = "fix_subs",
    args = {
        "": [
            "$(rootpath //infra/threexui/sub)",
        ],
    },
    configs = [":al"],
    data = [
        "//infra/threexui/sub",
        "//tools/vault/injector",
    ],
    run_args = [
        "--plugin_label",
        "sub",
    ],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
