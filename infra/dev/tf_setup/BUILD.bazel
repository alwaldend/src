load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_test_map")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map")

package(transitive_visibility = "//infra:transitive_consumers")

_DATA = glob(["*.tf"]) + [
    "//infra/cloud_init:xen_linux",
    "//infra/dev:dnsconfig",
]

_PROVIDERS = [
    "@terraform_provider_hashicorp_vault//:provider",
    "@terraform_provider_vatesfr_xenorchestra//:provider",
]

al_terraform_binary_map(
    name = "tf",
    configs = ["//infra/dev:al"],
    data = _DATA,
    plugin_labels = {
        "tf": "setup",
        "vault_env": "default_default",
        "xoa_login": "1",
    },
    providers = _PROVIDERS,
)

terraform_test_map(
    name = "tf_tests",
    args = {
        "fmt": [
            "--direct",
            "fmt",
            "-check",
            "-recursive",
        ],
        "validate": ["validate"],
    },
    data = [path for path in _DATA if path != "backend.tf"],
    providers = _PROVIDERS,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/dev:__pkg__"],
)
