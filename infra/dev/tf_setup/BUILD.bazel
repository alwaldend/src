load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

_DATA = glob(["*.tf"]) + [
    "//infra/cloud_init:xen_linux",
    "//infra/dev/dns:dnsconfig",
]

al_terraform_package(
    name = "tf",
    configs = ["//infra/dev:al"],
    data = _DATA,
    plugin_labels = {
        "tf": "setup",
        "vault_env": "default_default",
        "xoa_login": "1",
    },
    providers = [
        "@terraform_provider_hashicorp_vault//:provider",
        "@terraform_provider_vatesfr_xenorchestra//:provider",
    ],
    test_kwargs = {
        "args": {
            "fmt": [
                "--direct",
                "fmt",
                "-check",
                "-recursive",
            ],
            "validate": ["validate"],
        },
        "data": [path for path in _DATA if path != "backend.tf"],
    },
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/dev:__pkg__"],
)
