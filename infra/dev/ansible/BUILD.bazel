load("@rules_al//:defs.bzl", "al_binary_run_map")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("//tools/ansible/rules:al_ansible_binary.bzl", "al_ansible_binary")
load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "inventory",
    srcs = ["inventory.yaml"],
    visibility = ["//infra/security:fleet_inventory_consumers"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/dev:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_ansible_package(
    name = "ansible",
    srcs = [
        "inventory.yaml",
    ] + glob([
        "group_vars/**/*.yaml",
        "files/**",
        "playbook_*.yaml",
        "tasks/**/*.yaml",
    ]),
    configs = ["//infra/dev:al"],
    extra_vars_files = ["//infra/victoria_metrics/dns:metrics_vars"],
    packaged_srcs = [
        ":android_installer",
        ":fj_binary",
        ":srcs_files",
        ":ssh_server_ca",
    ],
    plugin_labels = {
        "vault_env": "default_default",
        "ansible": "",
        "runner": "1",
    },
)

# The fj installation is user-local and has no SSH or Vault inputs.
al_binary_run_map(
    name = "fj_install",
    args = {"": [
        "$(rootpath :ansible_bin)",
        "--inventory",
        "inventory.yaml",
        "playbook_deploy.yaml",
        "--limit",
        "dev1.dev.alwaldend.com",
        "--connection",
        "local",
        "--tags",
        "fj",
        "--extra-vars",
        "ansible_become=false",
    ]},
    data = [":ansible_bin"],
)

pkg_files(
    name = "android_installer",
    srcs = [
        "//tools/android:installer_tar",
        "//tools/android:packages.txt",
    ],
    renames = {
        "//tools/android:installer_tar": "files/android-installer.tar.gz",
        "//tools/android:packages.txt": "files/android-packages.txt",
    },
)

pkg_files(
    name = "fj_binary",
    srcs = ["@org_codeberg_forgejo_contrib_forgejo_cli_bin_linux_x86_64//:fj_filegroup"],
    renames = {"@org_codeberg_forgejo_contrib_forgejo_cli_bin_linux_x86_64//:fj_filegroup": "files/fj"},
)

pkg_files(
    name = "ssh_server_ca",
    srcs = ["//data/ssh:ca_servers"],
    renames = {"//data/ssh:ca_servers": "files/ssh_ca_servers.pub"},
)

al_ansible_binary(
    name = "syntax",
    arguments = [
        "--syntax-check",
        "--inventory",
        "inventory.yaml",
        "playbook_deploy.yaml",
    ],
    data = [
        ":srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_playbook",
)

al_ansible_binary(
    name = "inventory_check",
    arguments = [
        "--inventory",
        "inventory.yaml",
        "--list",
    ],
    data = [
        ":srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_inventory",
)
