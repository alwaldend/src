load("@rules_al//:defs.bzl", "al_binary_run_map")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//tools/ansible/rules:al_ansible_binary.bzl", "al_ansible_binary")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "inventory",
    srcs = ["inventory.yaml"],
    visibility = ["//infra/security:fleet_inventory_consumers"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/dev:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_binary_run_map(
    name = "ansible",
    args = {"": [
        "$(rootpath :ansible_bin)",
        "--inventory",
        "inventory.yaml",
        "playbook_deploy.yaml",
    ]},
    configs = ["//infra/dev:al"],
    data = [":ansible_bin"],
    plugin_labels = {
        "vault_env": "default_default",
        "ansible": "",
    },
)

al_ansible_binary(
    name = "ansible_bin",
    data = [
        ":srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_playbook",
)

pkg_filegroup(
    name = "srcs",
    srcs = [
        ":srcs_files",
        ":ssh_server_ca",
    ],
)

pkg_files(
    name = "ssh_server_ca",
    srcs = ["//data/ssh:ca_servers"],
    renames = {"//data/ssh:ca_servers": "files/ssh_ca_servers.pub"},
)

pkg_files(
    name = "srcs_files",
    srcs = [
        "inventory.yaml",
    ] + glob([
        "group_vars/**/*.yaml",
        "files/**",
        "playbook_*.yaml",
    ]),
    strip_prefix = strip_prefix.from_pkg(),
)

al_ansible_binary(
    name = "syntax",
    arguments = [
        "--syntax-check",
        "--inventory",
        "inventory.yaml",
        "playbook_deploy.yaml",
    ],
    data = [
        ":srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_playbook",
)

al_ansible_binary(
    name = "inventory_check",
    arguments = [
        "--inventory",
        "inventory.yaml",
        "--list",
    ],
    data = [
        ":srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_inventory",
)
