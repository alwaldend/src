load("@rules_al//:defs.bzl", "al_config", "al_inject", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_ansible_keys", "infra_dns", "infra_xo_login")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")
load("//tools/mermaid:defs.bzl", "mermaid_svg")
load("//tools/ssh:defs.bzl", "ssh_binary")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

al_vault_auth(
    name = "auth",
    approle = "src_infra_dev",
    extends = "//tools/al:auth",
)

infra_ansible_keys(
    name = "ansible_keys",
    labels = {"ansible": "1"},
    vault_ssh = {
        "backend": "ssh/clients/sign/admins",
        "ttl": 7200,
    },
)

al_inject(
    name = "ssh_known_hosts",
    labels = {"ansible": "1"},
    res_env = {"DEV_SSH_KNOWN_HOSTS": {
        "value": "{{ index .Last.Files 0 }}",
        "deps": ["dev_known_hosts"],
    }},
    res_file = {"dev_known_hosts": {
        "value": "@cert-authority secure1.dev.alwaldend.com @AL_SSH_SERVER_CA@\n",
    }},
    substitutions = {"//data/ssh:ca_servers": "@AL_SSH_SERVER_CA@"},
)

ssh_binary(
    name = "ssh.secure1",
    args = [
        "-F",
        "/dev/null",
        "-o",
        "BatchMode=yes",
        "-o",
        "ConnectTimeout=10",
        "-o",
        "IdentityAgent=none",
        "-o",
        "IdentitiesOnly=yes",
        "-o",
        "IdentityFile=$${ANSIBLE_PRIVATE_KEY_FILE}",
        "-o",
        "UserKnownHostsFile=$${DEV_SSH_KNOWN_HOSTS}",
        "-o",
        "GlobalKnownHostsFile=/dev/null",
        "-o",
        "StrictHostKeyChecking=yes",
        "ansible@secure1.dev.alwaldend.com",
    ],
    configs = [":al"],
    plugin_labels = {"ansible": "1"},
)

al_config(
    name = "al",
    configs = [
        ":ansible_keys",
        ":auth",
        ":dns_providers",
        ":runner_cache_metadata",
        ":runner_credentials",
        ":runner_proxy",
        ":setup_ssh_key",
        ":ssh_known_hosts",
        ":tf_backend",
        ":tf_backend_setup",
        ":xo_login",
        "//infra:al",
    ],
    visibility = ["//infra/dev:__subpackages__"],
)

al_inject(
    name = "runner_cache_metadata",
    labels = {"runner": "1"},
    res_env = {"DEV_RUNNER_CACHE_METADATA": {
        "value": "{{ .Last.Data | to_json }}",
        "deps": ["runner_cache_metadata"],
    }},
    res_kv = {"runner_cache_metadata": {
        "mount": "secrets",
        "path": "alwaldend.com/vault1/approles/src_infra_dev/runner_cache",
    }},
)

al_inject(
    name = "runner_proxy",
    labels = {"runner": "1"},
    res_env = {"DEV_RUNNER_PROXY_PASSWORD": {
        "value": "{{ .Last.Data.http_proxies.t3code }}",
        "deps": ["runner_proxy"],
    }},
    res_kv = {"runner_proxy": {
        "mount": "secrets",
        "path": "alwaldend.com/vault1/approles/src_infra_threexui/http_proxies",
    }},
)

al_inject(
    name = "runner_credentials",
    labels = {"runner": "1"},
    res_env = {"FORGEJO_RUNNER_CREDENTIALS": {
        "value": "{{ .Last.Data | to_json }}",
        "deps": ["secure1_runner"],
    }},
    res_kv = {"secure1_runner": {
        "mount": "secrets",
        "path": "alwaldend.com/vault1/approles/src_infra_dc1_forgejo1/runners/secure1",
    }},
)

vault_tf_backend(
    name = "tf_backend",
    labels = {"tf": "dns"},
    path = "alwaldend.com/vault1/approles/src_infra_dev/tf_backend/dns",
)

vault_tf_backend(
    name = "tf_backend_setup",
    labels = {"tf": "setup"},
    path = "alwaldend.com/vault1/approles/src_infra_dev/tf_backend/tf_setup",
)

# Seed the VM's initial SSH identity through the existing private key injector.
al_inject(
    name = "setup_ssh_key",
    labels = {"tf": "setup"},
    res_env = {
        "TF_VAR_ssh_private_key_file": {
            "value": "{{ .Last.Data.private_key }}",
            "deps": ["secure1_host_key"],
        },
        "TF_VAR_ssh_public_key_file": {
            "value": "{{ .Last.Data.public_key }}",
            "deps": ["secure1_host_key"],
        },
    },
    res_vault_ssh = {"secure1_host_key": {
        "backend": "ssh/clients/sign/admins",
        "ttl": 600,
    }},
)

infra_xo_login(
    name = "xo_login",
    labels = {"xoa_login": "1"},
    oidc_provider = "src_infra_xcp_ng_provider",
)

infra_dns(
    name = "dns_providers",
    dc1 = True,
    labels = {"tf": "dns"},
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]) + [
        "docs/ci.mmd",
        "docs/comfyui-architecture.mmd",
        "docs/development-hosts.mmd",
        "t3code-architecture.mmd",
    ],
    visibility = ["//infra:__pkg__"],
    deps = [":docs_assets"] + subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

mermaid_diagram(
    name = "rendered",
    src = "t3code-architecture.mmd",
    out = "rendered/t3code-architecture",
)

mermaid_svg(
    name = "rendered_historical",
    src = "t3code-architecture.mmd",
    out = "rendered/historical/t3code-architecture.svg",
    visibility = [
        # Preserve the original image published by the diagram-migration post.
        "//projects/alwaldend.com/content/blog/diagrams-in-ac-era:__pkg__",
    ],
)

# Mermaid's own defaults, for comparing the themed diagram against upstream.
# Not published and not hermetic; see tools/mermaid/README.md.
mermaid_svg(
    name = "rendered_plain",
    src = "t3code-architecture.mmd",
    out = "rendered/plain/t3code-architecture.svg",
    plain = True,
)

mermaid_diagram(
    name = "rendered_comfyui",
    src = "docs/comfyui-architecture.mmd",
    out = "rendered/comfyui-architecture",
)

mermaid_diagram(
    name = "rendered_development_hosts",
    src = "docs/development-hosts.mmd",
    out = "rendered/development-hosts",
    webp_aspect_ratio = [
        16,
        9,
    ],
    webp_scale = 2,
)

mermaid_diagram(
    name = "rendered_ci",
    src = "docs/ci.mmd",
    out = "rendered/ci",
    webp_aspect_ratio = [
        16,
        9,
    ],
    webp_scale = 2,
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":rendered_ci_dark_webp",
        ":rendered_ci_svg",
        ":rendered_comfyui_svg",
        ":rendered_development_hosts_dark_webp",
        ":rendered_development_hosts_svg",
        ":rendered_svg",
    ],
    prefix = "content/docs/infra/dev/assets",
)
