load("@rules_al//:defs.bzl", "al_binary_run")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_test_map")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "validation_inputs",
    testonly = True,
    srcs = glob([
        "*.tf",
        "tests/*.tftest.hcl",
    ]),
    visibility = ["//infra/vastai/tf:__pkg__"],
)

al_terraform_binary_map(
    name = "tf",
    args = {
        "plan": ["plan"],
        "apply": ["apply"],
        "state": ["state"],
    },
    configs = ["//infra/vastai:al"],
    data = glob(["*.tf"]) + [
        "//infra/vastai:configuration",
    ],
    plugin_labels = {
        "tf": "alwaldend",
        "vastai": "alwaldend",
        "vault_env": "component",
    },
    providers = [
        "//projects/vastai_terraform_provider:provider",
        "@terraform_provider_hashicorp_vault//:provider",
    ],
)

al_binary_run(
    name = "alwaldend",
    args = ["$(rootpath //tools/vastai)"],
    configs = ["//infra/vastai:al"],
    data = [
        "//tools/vastai",
    ],
    plugin_labels = {"vastai": "alwaldend"},
)

terraform_test_map(
    name = "tf_tests",
    data = glob([
        "*.tf",
        "tests/*.tftest.hcl",
    ]),
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/vastai:__pkg__"],
)
