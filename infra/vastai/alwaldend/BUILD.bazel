load("@rules_al//:defs.bzl", "al_binary_run")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary_map", "terraform_test_map")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "validation_inputs",
    testonly = True,
    srcs = glob([
        "*.tf",
        "tests/*.tftest.hcl",
    ]),
    visibility = ["//infra/vastai/tf:__pkg__"],
)

terraform_binary_map(
    name = "tf",
    args = {
        "plan": ["plan"],
        "apply": ["apply"],
        "state": ["state"],
    },
    data = glob(["*.tf"]) + [
        "//infra/vastai:configuration",
        "//tools/vault/injector",
        "//tools/vault/tf_backend",
    ],
    providers = [
        "//projects/vastai_terraform_provider:provider",
        "@terraform_provider_hashicorp_vault//:provider",
    ],
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": ["//infra/vastai:al"],
        "run_args": [
            "--plugin_label",
            "tf=alwaldend",
            "--plugin_label",
            "vastai=alwaldend",
            "--plugin_label",
            "vault_env=component",
        ],
    },
)

al_binary_run(
    name = "alwaldend",
    args = ["$(rootpath //tools/vastai)"],
    configs = ["//infra/vastai:al"],
    data = [
        "//tools/vastai",
        "//tools/vault/injector",
    ],
    run_args = [
        "--plugin_label",
        "vastai=alwaldend",
    ],
)

terraform_test_map(
    name = "tf_tests",
    data = glob([
        "*.tf",
        "tests/*.tftest.hcl",
    ]),
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/vastai:__pkg__"],
)
