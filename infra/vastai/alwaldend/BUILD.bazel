load("//projects/al:defs.bzl", "al_binary_run")
load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "validation_inputs",
    testonly = True,
    srcs = glob([
        "*.tf",
        "tests/*.tftest.hcl",
    ]),
    visibility = ["//infra/vastai/tf:__pkg__"],
)

al_terraform_package(
    name = "tf",
    args = {
        "plan": ["plan"],
        "apply": ["apply"],
        "state": ["state"],
    },
    configs = ["//infra/vastai:al"],
    data = glob(["*.tf"]) + [
        "//infra/vastai:configuration",
    ],
    plugin_labels = {
        "tf": "alwaldend",
        "vastai": "alwaldend",
        "vault_env": "component",
    },
    providers = [
        "//projects/vastai_terraform_provider:provider",
        "@terraform_provider_hashicorp_vault//:provider",
    ],
    test_kwargs = {
        "data": glob([
            "*.tf",
            "tests/*.tftest.hcl",
        ]),
        "providers": [],
    },
)

al_binary_run(
    name = "alwaldend",
    args = ["$(rootpath //tools/vastai)"],
    configs = ["//infra/vastai:al"],
    data = [
        "//tools/vastai",
    ],
    plugin_labels = {"vastai": "alwaldend"},
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/vastai:__pkg__"],
)
