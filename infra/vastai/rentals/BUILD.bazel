load("@rules_al//:defs.bzl", "al_binary_run")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary", "terraform_binary_map", "terraform_test_map")

package(transitive_visibility = "//infra:transitive_consumers")

_INPUTS = glob([
    "*.tf",
    "modules/gpu/*.tf",
])

_PLUGINS = [
    "//tools/vault/injector",
    "//tools/vault/tf_backend",
]

terraform_binary_map(
    name = "tf",
    args = {
        "plan": ["plan"],
        "apply": ["apply"],
        "release": [
            "apply",
            "-destroy",
            "-var=release=true",
        ],
        "refresh": [
            "apply",
            "-refresh-only",
        ],
        "state": ["state"],
    },
    data = _INPUTS + _PLUGINS,
    providers = ["//projects/vastai_terraform_provider:provider"],
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": ["//infra/vastai:al"],
        "run_args": [
            "--plugin_label",
            "tf=rentals",
            "--plugin_label",
            "vastai=rentals",
        ],
    },
)

terraform_binary(
    name = "test_terraform",
    data = _INPUTS,
    providers = ["//projects/vastai_terraform_provider:provider"],
)

terraform_binary_map(
    name = "test_tf",
    args = {
        "release": [
            "apply",
            "-destroy",
            "-var=release=true",
        ],
        "state": ["state"],
    },
    data = _INPUTS + _PLUGINS,
    providers = ["//projects/vastai_terraform_provider:provider"],
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": ["//infra/vastai:al"],
        "run_args": [
            "--plugin_label",
            "tf=rental_test",
            "--plugin_label",
            "vastai=rentals",
        ],
    },
)

al_binary_run(
    name = "live_test",
    args = [
        "$(rootpath //infra/vastai/cmd/rental_test)",
        "--terraform",
        "$(rootpath :test_terraform)",
        "--vastai",
        "$(rootpath //tools/vastai)",
    ],
    configs = ["//infra/vastai:al"],
    data = _PLUGINS + [
        ":test_terraform",
        "//infra/vastai/cmd/rental_test",
        "//tools/vastai",
    ],
    run_args = [
        "--plugin_label",
        "tf=rental_test",
        "--plugin_label",
        "vastai=rentals",
    ],
    tags = ["manual"],
)

terraform_test_map(
    name = "tf_tests",
    data = _INPUTS,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/vastai:__pkg__"],
)
