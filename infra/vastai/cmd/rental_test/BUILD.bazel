load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_go//go:def.bzl", "go_binary", "go_test")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = [],
    visibility = ["//infra/vastai:__pkg__"],
)

go_binary(
    name = "rental_test",
    srcs = [
        "doc.go",
        "main.go",
    ],
    visibility = ["//infra/vastai:__subpackages__"],
    deps = ["@com_github_spf13_cobra//:cobra"],
)

go_test(
    name = "rental_test_test",
    srcs = ["main_test.go"],
    args = [
        "-command=$(rlocationpath :rental_test)",
        "-launcher=$(rlocationpath @rules_terraform//cmd/terraform:terraform)",
    ],
    data = [
        ":rental_test",
        "@rules_terraform//cmd/terraform",
    ],
    deps = ["@rules_go//go/runfiles"],
)
