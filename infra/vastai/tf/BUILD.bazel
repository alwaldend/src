load("@rules_al//:defs.bzl", "al_binary_run")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary", "terraform_binary_map", "terraform_test_map")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "catalog_root",
    srcs = ["main.tf"],
    visibility = ["//infra/vastai/test/catalog:__pkg__"],
)

terraform_binary(
    name = "catalog_terraform",
    testonly = True,
    arguments = ["--direct"],
    data = glob([
        "*.tf",
        "tests/*.tftest.hcl",
    ]) + [
        "//infra/vastai:configuration",
        "//infra/vastai/alwaldend:validation_inputs",
        "//infra/vastai/rentals_test:validation_inputs",
    ],
    providers = [
        "//projects/vastai_terraform_provider:provider",
        "@terraform_provider_hashicorp_vault//:provider",
    ],
    visibility = ["//infra/vastai/test/catalog:__pkg__"],
)

terraform_binary_map(
    name = "tf",
    args = {
        "plan": ["plan"],
        "show": ["show"],
        "import": ["import"],
        "state": ["state"],
        "apply": ["apply"],
        "destroy_plan": [
            "plan",
            "-destroy",
        ],
    },
    data = glob(["*.tf"]) + [
        "//infra/vastai:configuration",
        "//tools/vault/injector",
        "//tools/vault/tf_backend",
    ],
    providers = ["//projects/vastai_terraform_provider:provider"],
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": ["//infra/vastai:al"],
        "run_args": [
            "--plugin_label",
            "tf=main",
            "--plugin_label",
            "vastai=1",
        ],
    },
)

terraform_test_map(
    name = "tf_tests",
    data = glob([
        "*.tf",
        "tests/*.tftest.hcl",
    ]),
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/vastai:__pkg__"],
)
