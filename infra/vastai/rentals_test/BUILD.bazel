load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "validation_inputs",
    testonly = True,
    srcs = glob(["*.tf"]),
    visibility = ["//infra/vastai/tf:__pkg__"],
)

al_terraform_package(
    name = "tf",
    args = {
        "plan": ["plan"],
        "rent": ["apply"],
        "release": [
            "apply",
            "-destroy",
        ],
        "state": ["state"],
    },
    configs = ["//infra/vastai:al"],
    data = glob(["*.tf"]),
    plugin_labels = {
        "tf": "rental_test",
        "vastai": "rentals",
    },
    providers = ["//projects/vastai_terraform_provider:provider"],
    test_kwargs = {
        "providers": [],
    },
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/vastai:__pkg__"],
)
