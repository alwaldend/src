load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_test_map")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "validation_inputs",
    testonly = True,
    srcs = glob(["*.tf"]),
    visibility = ["//infra/vastai/tf:__pkg__"],
)

al_terraform_binary_map(
    name = "tf",
    args = {
        "plan": ["plan"],
        "rent": ["apply"],
        "release": [
            "apply",
            "-destroy",
        ],
        "state": ["state"],
    },
    configs = ["//infra/vastai:al"],
    data = glob(["*.tf"]),
    plugin_labels = {
        "tf": "rental_test",
        "vastai": "rentals",
    },
    providers = ["//projects/vastai_terraform_provider:provider"],
)

terraform_test_map(
    name = "tf_tests",
    data = glob(["*.tf"]),
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/vastai:__pkg__"],
)
