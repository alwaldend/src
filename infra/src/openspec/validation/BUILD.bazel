load("@rules_openspec//main/bzl:openspec.bzl", "openspec_validation")
load(":workspaces.bzl", _WORKSPACE_SOURCES = "WORKSPACE_SOURCES")

package(
    default_visibility = ["//visibility:private"],
    transitive_visibility = "//infra:transitive_consumers",
)

package_group(
    name = "validation",
    packages = ["//infra/src/openspec/validation"],
)

[
    openspec_validation(
        name = name + "_validate_test",
        source = source,
    )
    for name, source in _WORKSPACE_SOURCES.items()
]

_ARCHIVE_WORKSPACES = [
    "infra_openhands",
    "infra_repos",
    "infra_threexui",
    "infra_vault",
    "repository",
    "tools_agents",
    "tools_mermaid",
    "tools_release",
    "tools_repo_delivery",
    "projects_alwaldend_com",
    "projects_anki_as_code",
    "projects_anki_grpc",
    "projects_ansible_collection",
    "projects_leetcode_downloader",
    "projects_mlops_2026",
    "projects_icon_generator",
    "projects_mcp_cordis",
    "tools_rules_skills",
    "projects_x_article_uploader",
    "tools_rules_terraform",
    "users_simeonwarren_anki",
    "users_simeonwarren_host_bot",
]

[
    openspec_validation(
        name = name + "_archive_test",
        archived = True,
        source = _WORKSPACE_SOURCES[name],
    )
    for name in _ARCHIVE_WORKSPACES
]

test_suite(
    name = "validate_test",
    tests = [":" + name + "_validate_test" for name in _WORKSPACE_SOURCES],
    visibility = ["//:__subpackages__"],
)

test_suite(
    name = "archive_test",
    tests = [":" + name + "_archive_test" for name in _ARCHIVE_WORKSPACES],
    visibility = ["//:__subpackages__"],
)
