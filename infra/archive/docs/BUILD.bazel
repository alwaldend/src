load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")

package(transitive_visibility = "//infra:transitive_consumers")

mermaid_diagram(
    name = "harvester",
    src = "harvester.mmd",
    out = "rendered/harvester",
)

mermaid_diagram(
    name = "opencode",
    src = "opencode.mmd",
    out = "rendered/opencode",
)

mermaid_diagram(
    name = "hermes",
    src = "hermes.mmd",
    out = "rendered/hermes",
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.mmd"]),
    visibility = ["//infra/archive:__pkg__"],
    deps = [":docs_assets"],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":harvester_svg",
        ":hermes_svg",
        ":opencode_svg",
    ],
    prefix = "content/docs/infra/archive/docs/assets",
)
