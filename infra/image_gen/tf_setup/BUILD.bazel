load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_test_map")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map")

package(transitive_visibility = "//infra:transitive_consumers")

_PROVIDERS = [
    "//projects/vastai_terraform_provider:provider",
    "@terraform_provider_hashicorp_random//:provider",
    "@terraform_provider_hashicorp_vault//:provider",
]

_DATA = [
    "//infra/image_gen:configuration",
    "//projects/comfyui_tools/nodes/chained_img2img_gif:source",
    "//projects/comfyui_tools/nodes/prompt_sequence:source",
    "//projects/comfyui_tools/workflows:workflows",
    "//projects/tf_modules/vastai_instance_imagegen_comfyui",
]

# The parent component supplies the same AL/backend context while embedding
# this self-describing read-only Terraform invocation in its CLI bridge.
alias(
    name = "connection_output",
    actual = ":tf.output.terraform",
    visibility = ["//infra/image_gen:__pkg__"],
)

al_terraform_binary_map(
    name = "tf",
    args = {
        "plan": ["plan"],
        "rent": ["apply"],
        "release": [
            "apply",
            "-destroy",
        ],
        "refresh": [
            "apply",
            "-refresh-only",
        ],
        "output": ["output"],
    },
    configs = ["//infra/image_gen:al"],
    data = glob(["*.tf"]) + _DATA,
    plugin_labels = {"tf": "setup"},
    providers = _PROVIDERS,
    visibility = ["//infra/image_gen:__pkg__"],
)

terraform_test_map(
    name = "tf_tests",
    args = {
        "fmt": [
            "--direct",
            "fmt",
            "-check",
            "-recursive",
        ],
        "validate": ["validate"],
        "test": [
            "test",
            "-no-color",
        ],
    },
    data = glob(
        [
            "*.tf",
            "tests/*.tftest.hcl",
        ],
        exclude = ["backend.tf"],
    ) + _DATA,
    providers = _PROVIDERS,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/image_gen:__pkg__"],
)
