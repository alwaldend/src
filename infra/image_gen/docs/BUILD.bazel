load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")
load("//tools/mermaid:theme.bzl", "mermaid_theme")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")
load("//tools/rules_template/rules:template_run_binary.bzl", "template_run_binary")

package(transitive_visibility = "//infra:transitive_consumers")

# Compose the shared site theme and existing actor artwork without duplicating either.
template_run_binary(
    name = "theme_config",
    srcs = ["theme.json.tmpl"],
    outs = ["theme.json"],
    data = [
        "//internal/assets/mermaid:config",
        "//tools/mermaid:theme.json",
    ],
)

mermaid_theme(
    name = "theme",
    config = ":theme_config",
    font = "//internal/assets:diagram_font",
    font_license = "//internal/assets:diagram_font_license",
    palette = "//internal/assets/mermaid:palette",
)

mermaid_diagram(
    name = "architecture",
    src = "architecture.mmd",
    out = "rendered/architecture",
    theme = ":theme",
    webp_aspect_ratio = [],
    webp_scale = 2,
)

docs_filegroup(
    name = "docs",
    srcs = [
        ":architecture_dark_webp",
        ":evaluations_dark_webp",
        ":evaluations_svg",
    ],
    prefix = "content/docs/infra/image_gen/assets",
    visibility = ["//infra/image_gen:__pkg__"],
)

mermaid_diagram(
    name = "evaluations",
    src = "evaluations.mmd",
    out = "rendered/evaluations",
    theme = ":theme",
    webp_aspect_ratio = [],
    webp_scale = 2,
)
