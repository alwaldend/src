load("//projects/al:defs.bzl", "al_binary_run", "al_config", "al_inject", "al_vault_auth")
load("//tools/jsonnet:defs.bzl", "jsonnet_to_json")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")
load("//tools/ssh:defs.bzl", "ssh_binary")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

ssh_binary(
    name = "ssh",
    args = [
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
    ],
    configs = [],
)

filegroup(
    name = "evaluation_certificate",
    srcs = ["//third_party/ai_vast_openapi:root_certificate"],
    visibility = ["//infra/image_gen:__subpackages__"],
)

package_group(
    name = "configuration_acceptance_consumers",
    packages = ["//projects/vastai_terraform_provider/test/acceptance"],
)

exports_files(
    ["res4lyf-requirements.txt"],
    visibility = [
        ":configuration_acceptance_consumers",
        "//infra/image_gen:__subpackages__",
    ],
)

jsonnet_to_json(
    name = "rental_configuration",
    src = "configuration.jsonnet",
    outs = ["config.json"],
    visibility = [
        ":configuration_acceptance_consumers",
        "//infra/image_gen:__subpackages__",
    ],
    deps = [
        "deployment.json",
        "//projects/comfyui_tools/workflows:models.json",
    ],
)

filegroup(
    name = "configuration",
    srcs = [
        "config.json",
        "res4lyf-requirements.txt",
    ],
    visibility = [
        ":configuration_acceptance_consumers",
        "//infra/image_gen:__subpackages__",
    ],
)

al_vault_auth(
    name = "auth",
    approle = "src_infra_image_gen",
    extends = "//tools/al:auth",
    visibility = ["//infra/image_gen:__subpackages__"],
)

vault_tf_backend(
    name = "tf_backend_setup",
    labels = {"tf": "setup"},
    path = "alwaldend.com/vault1/approles/src_infra_image_gen/tf_backend/setup",
)

al_inject(
    name = "rental_auth",
    labels = {"tf": "setup"},
    res_env = {"VAST_API_KEY": {
        "value": "{{ .Last.Data.api_key }}",
        "deps": ["rental_key"],
    }},
    res_kv = {"rental_key": {
        "mount": "secrets",
        "path": "alwaldend.com/vault1/approles/src_infra_image_gen/vastai",
    }},
    res_vault_env = {"component": {
        "auth": "default",
        "conn": "default",
    }},
    visibility = ["//infra/image_gen:__subpackages__"],
)

al_inject(
    name = "hugging_face_auth",
    labels = {"model_auth": "huggingface"},
    res_env = {"COMFYUI_HUGGING_FACE_TOKEN": {
        "value": "{{ .Last.Data.token }}",
        "deps": ["hugging_face_model_token"],
    }},
    res_kv = {"hugging_face_model_token": {
        "mount": "secrets",
        "path": "alwaldend.com/vault1/approles/src_infra_image_gen/huggingface",
    }},
    visibility = ["//infra/image_gen:__subpackages__"],
)

al_config(
    name = "al",
    configs = [
        ":auth",
        ":hugging_face_auth",
        ":rental_auth",
        ":tf_backend_setup",
        ":web_auth",
        "//infra:al",
    ],
    visibility = ["//infra/image_gen:__subpackages__"],
)

al_inject(
    name = "web_auth",
    labels = {"comfy": "1"},
    res_env = {
        "IMAGEGEN_WEB_USERNAME": {
            "value": "{{ .Last.Data.username }}",
            "deps": ["web_login"],
        },
        "IMAGEGEN_WEB_PASSWORD": {
            "value": "{{ .Last.Data.password }}",
            "deps": ["web_login"],
        },
    },
    res_kv = {"web_login": {
        "mount": "secrets",
        "path": "alwaldend.com/vault1/approles/src_infra_image_gen/web",
    }},
    visibility = ["//infra/image_gen:__subpackages__"],
)

al_binary_run(
    name = "comfy",
    args = [
        "$(rootpath //tools/comfyui/cmd/remote)",
        "--cli",
        "$(rlocationpath //tools/comfyui/cli:comfy)",
        "--endpoint-command",
        "$(rlocationpath //infra/image_gen/tf_setup:connection_output)",
        "--endpoint-arg=-raw",
        "--endpoint-arg=-no-color",
        "--endpoint-arg=https_url",
        "--ca-file",
        "$(rlocationpath //third_party/ai_vast_openapi:root_certificate)",
        "--",
    ],
    configs = [":al"],
    data = [
        "//infra/image_gen/tf_setup:connection_output",
        "//third_party/ai_vast_openapi:root_certificate",
        "//tools/comfyui/cli:comfy",
        "//tools/comfyui/cmd/remote",
    ],
    plugin_labels = {
        "comfy": "1",
        "tf": "setup",
    },
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = [
        "README.md",
        "config.json",
        "deployment.json",
        "res4lyf-requirements.txt",
    ],
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
