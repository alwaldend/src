load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

_CONFIG = [
    "main.tf",
    "//infra/cloud_init:xen_linux",
    "//infra/flux/dns:dnsconfig",
]

al_terraform_package(
    name = "tf_setup",
    configs = ["//infra/flux:al"],
    data = _CONFIG + ["backend.tf"],
    plugin_labels = {
        "tf": "setup",
        "xoa_login": "1",
    },
    providers = ["@terraform_provider_vatesfr_xenorchestra//:provider"],
    test_kwargs = {
        "data": _CONFIG,
        "validate": True,
    },
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/flux:__pkg__"],
)
