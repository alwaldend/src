load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/flux:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_PROVIDERS = [
    "@terraform_provider_telmate_proxmox//:provider",
]

_CONFIGS = ["//infra/flux:al"]

_DATA = glob(["*.tf"]) + [
    "//projects/tf_modules/pve_vm_qemu",
    "//infra/flux/dns:dnsconfig",
]

al_terraform_package(
    name = "tf_setup",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = {"tf": "setup"},
    providers = _PROVIDERS,
    tests_name = "tf_tests",
    tests_use_al = True,
)
