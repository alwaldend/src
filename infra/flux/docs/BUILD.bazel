load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")

package(transitive_visibility = "//infra:transitive_consumers")

mermaid_diagram(
    name = "architecture",
    src = "architecture.mmd",
    out = "rendered/architecture",
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.mmd"]),
    visibility = ["//infra/flux:__pkg__"],
    deps = [":docs_assets"],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":architecture_svg",
    ],
    prefix = "content/docs/infra/flux/docs/assets",
)
