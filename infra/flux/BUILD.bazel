load("//infra/dns/terraform:defs.bzl", "infra_terraform_dns_config")
load("//projects/al:defs.bzl", "al_vault_auth")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

al_vault_auth(
    name = "auth",
    approle = "src_infra_flux",
    extends = "//tools/al:auth",
)

infra_terraform_dns_config(
    name = "dns_al",
    auth = ":auth",
    backend_path = "alwaldend.com/vault1/approles/src_infra_flux/tf_backend/dns",
    dc1 = True,
    global_records = False,
    visibility = ["//infra/flux/dns:__pkg__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
