load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

al_ansible_package(
    name = "ansible",
    srcs = [
        "files/k3s.yaml",
        "files/k3s_manifests.yaml",
        "group_vars/all.yaml",
        "inventory.yaml",
        "playbook_deploy.yaml",
        "//infra/flux:ingress_access",
        "//infra/ingress/ansible:inventory",
        "//infra/vault/dns:dnsconfig",
    ],
    configs = ["//infra/flux:al"],
    plugin_labels = {
        "ansible": "",
        "vault_env": "default_default",
    },
    renames = {
        "//infra/flux:ingress_access": "files/ingress-access.json",
        "//infra/ingress/ansible:inventory": "files/ingress-inventory.yaml",
        "//infra/vault/dns:dnsconfig": "files/vault-dns.json",
    },
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/flux:__pkg__"],
)
