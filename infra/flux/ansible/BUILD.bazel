load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "inventory",
    srcs = ["inventory.yaml"],
    visibility = ["//infra/security:fleet_inventory_consumers"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/flux:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_ansible_package(
    name = "ansible",
    srcs = [
        "inventory.yaml",
    ] + glob([
        "group_vars/**/*.yaml",
        "files/**",
        "playbook_*.yaml",
    ]),
    configs = ["//infra/flux:al"],
    plugin_labels = {
        "vault_env": "default_default",
        "ansible": "",
    },
)

native_test(
    name = "ansible_lint",
    src = "//tools/ansible/lint:ansible_lint_test",
    args = [
        "--strict",
        "inventory.yaml",
        "group_vars/all.yaml",
        "playbook_deploy.yaml",
    ],
    data = [
        "files/k3s.yaml",
        "files/k3s_admission.yaml",
        "files/k3s_auth.yaml",
        "files/k3s_manifests.yaml",
        "group_vars/all.yaml",
        "inventory.yaml",
        "playbook_deploy.yaml",
        "//projects/ansible_collection:collection",
        "//tools/ansible",
        "//tools/ansible:ansible_config",
        "//tools/ansible:ansible_galaxy",
        "//tools/ansible:ansible_lint",
        "//tools/ansible:ansible_playbook",
    ],
    env = {
        "ANSIBLE_LINT_PACKAGE_ROOT": "infra/flux/ansible",
    },
)
