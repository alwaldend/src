load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

_CONFIG = [
    "controllers.tf",
    "flux-instance/Chart.yaml",
    "flux-instance/templates/instance.yaml.tpl",
    "main.tf",
    "operator_ingress.tf",
    "operator-ingress/Chart.yaml",
    "operator-ingress/templates/resources.yaml.tpl",
    "//data/ssl/alwaldend.com:ica_servers",
    "//infra/flux:operator_issuer",
    "//infra/flux:ingress_access",
    "//infra/flux/dns:dnsconfig",
    "//infra/ingress/ansible:inventory",
    "//third_party/io_cert_manager_cert_manager:artifacts.json",
    "//third_party/io_controlplane_flux_operator:artifacts.json",
    "//third_party/io_fluxcd_flux:artifacts.json",
    "//third_party/io_traefik_traefik:artifacts.json",
]

al_terraform_package(
    name = "tf",
    configs = ["//infra/flux:al"],
    data = _CONFIG + ["backend.tf"],
    plugin_labels = {
        "tf": "workloads",
        "vault_env": "default_default",
    },
    providers = [
        "@terraform_provider_hashicorp_helm//:provider",
        "@terraform_provider_hashicorp_vault//:provider",
    ],
    test_kwargs = {
        "data": _CONFIG,
        "validate": True,
    },
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/flux:__pkg__"],
)
