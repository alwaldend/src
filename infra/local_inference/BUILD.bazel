load("//infra:al_config.bzl", "infra_ansible_keys")
load("//projects/al:defs.bzl", "al_config", "al_vault_auth")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

al_vault_auth(
    name = "auth",
    approle = "src_infra_local_inference",
    extends = "//tools/al:auth",
)

infra_ansible_keys(
    name = "ansible_keys",
    labels = {"ansible": "1"},
    vault_ssh = {
        "backend": "ssh/clients/sign/admins",
        "ttl": 7200,
    },
)

al_config(
    name = "al",
    configs = [
        ":ansible_keys",
        ":auth",
        "//infra:al",
    ],
    visibility = ["//infra/local_inference:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
