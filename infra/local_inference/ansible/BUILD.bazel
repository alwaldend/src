load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

al_ansible_package(
    name = "ansible",
    srcs = ["inventory.yaml"] + glob([
        "group_vars/**",
        "files/**",
        "templates/**",
        "tasks/**",
        "playbook_*.yaml",
    ]),
    configs = ["//infra/local_inference:al"],
    packaged_srcs = [
        ":dnsconfig_file",
        ":responses_bridge_file",
        ":runtime_archives",
        ":srcs_files",
    ],
    plugin_labels = {
        "vault_env": "default_default",
        "ansible": "1",
    },
)

pkg_files(
    name = "dnsconfig_file",
    srcs = ["//infra/local_inference/dns:dnsconfig"],
    strip_prefix = strip_prefix.from_root("infra/local_inference/dns"),
)

pkg_files(
    name = "responses_bridge_file",
    srcs = ["//projects/llama_responses_bridge"],
    prefix = "files",
    renames = {"//projects/llama_responses_bridge": "responses_bridge"},
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/local_inference:__pkg__"],
)

pkg_files(
    name = "runtime_archives",
    srcs = [
        "//third_party/com_github_ggml_org_llama_cpp:cuda_archive",
        "//third_party/com_github_ggml_org_llama_cpp:llama_archive",
        "//third_party/com_github_openai_codex:linux_archive",
        "//third_party/com_github_pingdotgg_t3code:linux_archive",
    ],
    prefix = "files",
    renames = {
        "//third_party/com_github_ggml_org_llama_cpp:llama_archive": "llama.tar.gz",
        "//third_party/com_github_ggml_org_llama_cpp:cuda_archive": "cuda.tar.gz",
        "//third_party/com_github_openai_codex:linux_archive": "codex.tar.gz",
        "//third_party/com_github_pingdotgg_t3code:linux_archive": "t3code.tar.gz",
    },
)
