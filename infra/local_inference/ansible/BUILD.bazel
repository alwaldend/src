load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//projects/al/rules/al:al_binary.bzl", "al_binary_run_map")
load("//tools/ansible/rules:al_ansible_binary.bzl", "al_ansible_binary")

package(transitive_visibility = "//infra:transitive_consumers")

al_binary_run_map(
    name = "ansible",
    args = {
        "": [
            "$(rootpath :ansible_bin)",
            "--inventory",
            "inventory.yaml",
            "playbook_deploy.yaml",
        ],
    },
    configs = ["//infra/local_inference:al"],
    data = [
        ":ansible_bin",
        "//tools/vault/injector",
    ],
    run_args = [
        "--plugin_label",
        "vault_env=default_default",
        "--plugin_label",
        "ansible=1",
    ],
)

al_ansible_binary(
    name = "ansible_bin",
    data = [
        ":srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_playbook",
)

pkg_files(
    name = "srcs_files",
    srcs = ["inventory.yaml"] + glob([
        "group_vars/**",
        "files/**",
        "templates/**",
        "tasks/**",
        "playbook_*.yaml",
    ]),
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_files(
    name = "dnsconfig_file",
    srcs = ["//infra/local_inference:dnsconfig"],
    strip_prefix = strip_prefix.from_root("infra/local_inference"),
)

pkg_filegroup(
    name = "srcs",
    srcs = [
        ":dnsconfig_file",
        ":responses_bridge_file",
        ":srcs_files",
    ],
)

pkg_files(
    name = "responses_bridge_file",
    srcs = ["//infra/local_inference/cmd/responses_bridge"],
    prefix = "files",
    renames = {"//infra/local_inference/cmd/responses_bridge": "responses_bridge"},
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/local_inference:__pkg__"],
)
