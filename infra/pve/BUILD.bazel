load("@rules_al//:defs.bzl", "al_config", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_dns", "infra_pve_provider_inputs", "infra_yc_account", "infra_yc_auth", "infra_yc_bucket_auth")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

al_vault_auth(
    name = "auth",
    approle = "src_infra_dc1_pve1",
    extends = "//tools/al:auth",
)

vault_tf_backend(
    name = "tf_backend",
    labels = {
        "dns": "1",
        "tf": "1",
    },
    path = "alwaldend.com/vault1/approles/src_infra_dc1_pve1/tf_backend",
)

infra_yc_auth(
    name = "yc_auth",
    labels = {
        "dns": "1",
        "tf": "1",
    },
    path = "yandex.cloud/org1/folders/src-infra-dc1-pve1/account_iam_key",
)

infra_yc_bucket_auth(
    name = "yc_bucket_auth",
    labels = {"tf": "1"},
    path = "yandex.cloud/org1/folders/src-infra-dc1-pve1/account_static_key",
)

infra_yc_account(
    name = "yc_account",
    labels = {
        "dns": "1",
        "tf": "1",
    },
    path = "yandex.cloud/org1/folders/src-infra-dc1-pve1/account",
)

infra_pve_provider_inputs(
    name = "pve_provider_inputs",
    labels = {"dns": "1"},
)

infra_dns(
    name = "dns_providers",
    dc1 = True,
    global_records = False,
    labels = {
        "dns": "1",
        "tf": "1",
    },
)

al_config(
    name = "al",
    configs = [
        ":auth",
        ":dns_providers",
        ":pve_provider_inputs",
        ":tf_backend",
        ":yc_account",
        ":yc_auth",
        ":yc_bucket_auth",
        "//infra:al",
    ],
    visibility = ["//infra/pve:__subpackages__"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//:__subpackages__"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
