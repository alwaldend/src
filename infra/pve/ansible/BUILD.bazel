load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "inventory",
    srcs = ["inventory.yaml"],
    visibility = ["//infra/security:fleet_inventory_consumers"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/pve:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_ansible_package(
    name = "ansible",
    srcs = [
        "inventory.yaml",
        "//data/ssl/alwaldend.com:ica_servers",
        "//data/ssl/alwaldend.com:root_ca",
        "//infra/cloud_init",
        "//infra/cloud_init:cloud_init_min",
        "@com_hashicorp_vault_linux_x86_64//:vault_filegroup",
    ] + glob([
        "group_vars/**/*.yaml",
        "playbook_*.yaml",
    ]),
    configs = ["//infra/pve:al"],
    plugin_labels = {
        "vault_env": "default_default",
        "ansible": "",
    },
    renames = {
        "//infra/cloud_init:cloud_init": "files/cloud_init.yaml",
        "//infra/cloud_init:cloud_init_min": "files/cloud_init_min.yaml",
        "@com_hashicorp_vault_linux_x86_64//:vault_filegroup": "files/vault",
        "//data/ssl/alwaldend.com:root_ca": "files/pki_ca_root.crt",
        "//data/ssl/alwaldend.com:ica_servers": "files/pki_ca_servers.crt",
    },
)
