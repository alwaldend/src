load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_test_map")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map", "al_terraform_target_binary_map")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/pve:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_PROVIDERS = [
    "@terraform_provider_cloudflare_cloudflare//:provider",
    "@terraform_provider_hashicorp_vault//:provider",
    "@terraform_provider_telmate_proxmox//:provider",
    "@terraform_provider_terraform_routeros_routeros//:provider",
    "@terraform_provider_yandex_cloud_yandex//:provider",
]

_CONFIGS = ["//infra/pve:al"]

_PLUGIN_LABELS = {
    "tf": "",
    "pve_login": "",
    "vault_env": "default_default",
}

_DATA = glob(["*.tf"]) + [
    "//projects/tf_modules/dns_records:dns_records",
    "//projects/tf_modules/tf_backend",
    "//projects/tf_modules/pve_vm_qemu",
    "//infra/pve:dnsconfig",
]

al_terraform_binary_map(
    name = "tf",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = _PLUGIN_LABELS,
    providers = _PROVIDERS,
)

al_terraform_target_binary_map(
    name = "dns",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = {"dns": "1"},
    providers = _PROVIDERS,
    target = "module.dns",
)

terraform_test_map(
    name = "tf_tests",
    data = _DATA,
    providers = _PROVIDERS,
)
