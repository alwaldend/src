load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_test_map")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map", "al_terraform_target_binary_map")

package(transitive_visibility = "//infra:transitive_consumers")

_PROVIDERS = [
    "@terraform_provider_cloudflare_cloudflare//:provider",
    "@terraform_provider_hashicorp_external//:provider",
    "@terraform_provider_hashicorp_vault//:provider",
    "@terraform_provider_terraform_routeros_routeros//:provider",
    "@terraform_provider_vatesfr_xenorchestra//:provider",
]

_CONFIGS = ["//infra/xcp_ng:al"]

_DATA = [
    "//infra/xcp_ng:dnsconfig",
    "//projects/tf_modules/dns_records:dns_records",
] + glob(["*.tf"])

_RUNTIME_DATA = _DATA + [
    "//infra/xcp_ng/cmd/xo_config",
]

al_terraform_binary_map(
    name = "tf",
    configs = _CONFIGS,
    data = _RUNTIME_DATA,
    plugin_labels = {
        "xcp_ng_tf": "1",
        "xoa": "1",
        "vault_env": "xcp_ng",
    },
    providers = _PROVIDERS,
)

al_terraform_target_binary_map(
    name = "dns",
    configs = _CONFIGS,
    data = _RUNTIME_DATA,
    plugin_labels = {"dns": "1"},
    providers = _PROVIDERS,
    target = "module.dns",
)

terraform_test_map(
    name = "tf_tests",
    data = _DATA,
    providers = _PROVIDERS,
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/xcp_ng:__pkg__"],
)
