load("@rules_al//:defs.bzl", "al_binary_run", "al_config", "al_injector_call", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_dns")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

al_vault_auth(
    name = "auth.xcp_ng",
    approle = "src_infra_xcp_ng",
    config_name = "xcp_ng",
)

vault_tf_backend(
    name = "tf_backend",
    labels = {
        "dns": "1",
        "xcp_ng_tf": "1",
    },
    path = "alwaldend.com/vault1/approles/src_infra_xcp_ng/tf_backend",
    vault_auth = "xcp_ng",
)

al_injector_call(
    name = "xcpng_host_login",
    labels = {"xcpng_host": "1"},
    res_env = {
        "XCPNG_USERNAME": {
            "value": "{{ .Last.Data.xcpng_username }}",
            "deps": ["xcpng_host"],
        },
        "XCPNG_PASSWORD": {
            "value": "{{ .Last.Data.xcpng_password }}",
            "deps": ["xcpng_host"],
        },
        "SSHPASS": {
            "value": "{{ .Last.Data.xcpng_password }}",
            "deps": ["xcpng_host"],
        },
    },
    res_kv = {
        "xcpng_host": {
            "mount": "secrets",
            "path": "alwaldend.com/vault1/approles/src_infra_xcp_ng/host1",
            "vault_auth": "xcp_ng",
        },
    },
)

al_injector_call(
    name = "xoa_ssh",
    labels = {"xcp_ng_ansible": "1"},
    res_env = {"XOA_SSH_PASSWORD": {
        "value": "{{ .Last.Data.xoa_ssh_password }}",
        "deps": ["xoa_ssh"],
    }},
    res_kv = {
        "xoa_ssh": {
            "mount": "secrets",
            "path": "alwaldend.com/vault1/approles/src_infra_xcp_ng/xoa",
            "vault_auth": "xcp_ng",
        },
    },
)

al_injector_call(
    name = "xoa_login",
    labels = {"xoa": "1"},
    res_env = {"XOA_TOKEN": {
        "value": "{{ .Last.Data.xoa_token }}",
        "deps": ["xoa"],
    }},
    res_kv = {
        "xoa": {
            "mount": "secrets",
            "path": "alwaldend.com/vault1/approles/src_infra_xcp_ng/xoa",
            "vault_auth": "xcp_ng",
        },
    },
)

al_injector_call(
    name = "env_xcp_ng",
    labels = {"vault_env": "xcp_ng"},
    res_vault_env = {"env_xcp_ng": {
        "auth": "xcp_ng",
        "conn": "default",
    }},
)

infra_dns(
    name = "dns_providers",
    dc1 = True,
    global_records = False,
    labels = {
        "dns": "1",
        "xcp_ng_tf": "1",
    },
    vault_auth = "xcp_ng",
)

al_config(
    name = "al",
    configs = [
        ":auth.xcp_ng",
        ":dns_providers",
        ":env_xcp_ng",
        ":tf_backend",
        ":xcpng_host_login",
        ":xoa_login",
        ":xoa_ssh",
        "//infra:al",
    ],
    visibility = [
        "//infra/forgejo:__subpackages__",
        "//infra/security/appliances:__pkg__",
        "//infra/xcp_ng:__subpackages__",
    ],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
    vault_env = "xcp_ng",
)

al_binary_run(
    name = "ssh",
    args = [
        "sshpass",
        "-e",
        "ssh",
        "-F",
        "/dev/null",
        "-o",
        "ConnectTimeout=10",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "PreferredAuthentications=password",
        "-o",
        "PubkeyAuthentication=no",
        "root@host1.xcp-ng.alwaldend.com",
    ],
    configs = [":al"],
    plugin_labels = {"xcpng_host": "1"},
)

al_binary_run(
    name = "xo_inspect",
    args = [
        "$(rootpath //infra/xcp_ng/cmd/xo_config)",
        "inspect",
    ],
    configs = [":al"],
    data = [
        "//infra/xcp_ng/cmd/xo_config",
    ],
    plugin_labels = {"xoa": "1"},
)

al_binary_run(
    name = "xo_register_host",
    args = [
        "$(rootpath //infra/xcp_ng/cmd/xo_config)",
        "register-host",
    ],
    configs = [":al"],
    data = [
        "//infra/xcp_ng/cmd/xo_config",
    ],
    plugin_labels = {
        "xoa": "1",
        "xcpng_host": "1",
    },
)

al_binary_run(
    name = "xo_import_template",
    args = [
        "$(rootpath //infra/xcp_ng/cmd/xo_config)",
        "import-template",
        "$(rootpath //third_party/org_fedora_cloud)",
    ],
    configs = [":al"],
    data = [
        "//infra/xcp_ng/cmd/xo_config",
        "//third_party/org_fedora_cloud",
    ],
    plugin_labels = {"xoa": "1"},
)

al_binary_run(
    name = "xo_import_prepared_template",
    args = [
        "$(rootpath //infra/xcp_ng/cmd/xo_config)",
        "import-template",
    ],
    configs = [":al"],
    data = [
        "//infra/xcp_ng/cmd/xo_config",
    ],
    plugin_labels = {"xoa": "1"},
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
