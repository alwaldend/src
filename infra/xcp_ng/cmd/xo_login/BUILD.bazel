load("@rules_al//:defs.bzl", "al_binary_run", "al_config", "al_plugin_config")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(transitive_visibility = "//infra:transitive_consumers")

al_plugin_config(
    name = "bootstrap_plugin",
    args = {
        "bootstrap": True,
        "xoa_url": "https://xoa.xcp-ng.alwaldend.com",
        "discovery_url": "https://vault.alwaldend.com:8200/v1/identity/oidc/provider/src_infra_xcp_ng_provider/.well-known/openid-configuration",
    },
    config_name = "xo_login",
    executable = ":xo_login",
    labels = {"xoa_login": "1"},
)

al_config(
    name = "bootstrap_config",
    configs = [
        ":bootstrap_plugin",
        "//tools/al:connection",
    ],
)

al_binary_run(
    name = "bootstrap",
    args = [
        "$(rootpath :xo_login)",
        "--report",
    ],
    configs = [":bootstrap_config"],
    data = [
        ":xo_login",
    ],
    plugin_labels = {"xoa_login": "1"},
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/xcp_ng:__pkg__"],
)

go_library(
    name = "xo_login_lib",
    srcs = [
        "doc.go",
        "issuer.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/infra/xcp_ng/cmd/xo_login",
    visibility = ["//visibility:private"],
    deps = [
        "//infra/xcp_ng/internal/oidclogin",
        "@com_github_hashicorp_vault_api//:api",
        "@rules_al//api/al_proto",
        "@rules_al//pkg/al",
        "@rules_al//pkg/al_plugin",
        "@rules_al//pkg/lifecycle",
    ],
)

go_binary(
    name = "xo_login",
    embed = [":xo_login_lib"],
    visibility = ["//infra:__subpackages__"],
)

go_test(
    name = "xo_login_test",
    srcs = [
        "issuer_test.go",
        "main_test.go",
    ],
    data = [":bootstrap_config"],
    embed = [":xo_login_lib"],
    env = {"BOOTSTRAP_CONFIG": "$(rlocationpath :bootstrap_config)"},
    deps = [
        "@com_github_hashicorp_vault_api//:api",
        "@rules_al//pkg/al",
        "@rules_go//go/runfiles",
    ],
)
