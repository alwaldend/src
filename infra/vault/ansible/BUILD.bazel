load("//projects/al:defs.bzl", "al_binary_run_map")
load("//tools/ansible/rules:al_ansible_package.bzl", "al_ansible_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

filegroup(
    name = "inventory",
    srcs = ["inventory.yaml"],
    visibility = ["//infra/security:fleet_inventory_consumers"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/vault:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_ansible_package(
    name = "ansible",
    srcs = [
        "inventory.yaml",
        "//data/ssl/alwaldend.com:ica_clients",
        "//data/ssl/alwaldend.com:ica_servers",
        "//data/ssl/alwaldend.com:root_ca",
        "@com_hashicorp_vault_linux_x86_64//:vault_filegroup",
    ] + glob([
        "group_vars/**/*.yaml",
        "playbook_*.yaml",
        "files/**",
    ]),
    args = {
        "": [
            "--inventory",
            "inventory.yaml",
            "playbook_setup.yaml",
        ],
        "vm": [
            "--inventory",
            "inventory.yaml",
            "playbook_setup_vm.yaml",
        ],
        "bm": [
            "--inventory",
            "inventory.yaml",
            "playbook_setup_bm.yaml",
        ],
    },
    configs = ["//infra/vault:al"],
    plugin_labels = {
        "vault_env": "default_default",
        "ansible": "",
    },
    renames = {
        "@com_hashicorp_vault_linux_x86_64//:vault_filegroup": "files/vault",
        "//data/ssl/alwaldend.com:ica_clients": "files/tls_client_ca_file.pem",
        "//data/ssl/alwaldend.com:root_ca": "files/pki_ca_root.crt",
        "//data/ssl/alwaldend.com:ica_servers": "files/pki_ca_servers.crt",
    },
)

al_binary_run_map(
    name = "fix_quorum",
    args = {
        "": [
            "$(rootpath :ansible_bin)",
            "--inventory",
            "inventory.yaml",
            "playbook_fix_quorum.yaml",
        ],
    },
    configs = ["//infra/vault:al"],
    data = [":ansible_bin"],
)
