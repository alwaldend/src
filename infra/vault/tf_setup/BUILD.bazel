load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map", "al_terraform_target_binary_map", "al_terraform_test_map")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/vault:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_PROVIDERS = [
    "@terraform_provider_cloudflare_cloudflare//:provider",
    "@terraform_provider_hashicorp_vault//:provider",
    "@terraform_provider_telmate_proxmox//:provider",
    "@terraform_provider_terraform_routeros_routeros//:provider",
]

_CONFIGS = ["//infra/vault:al"]

_PLUGIN_LABELS = {
    "tf": "setup",
    "pve_login": "",
}

_DATA = glob(["*.tf"]) + [
    "//projects/tf_modules/dns_records:dns_records",
    "//projects/tf_modules/pve_vm_qemu",
    "//infra/vault:dnsconfig",
]

al_terraform_binary_map(
    name = "tf_setup",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = _PLUGIN_LABELS,
    providers = _PROVIDERS,
)

al_terraform_target_binary_map(
    name = "dns",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = {"dns": "1"},
    providers = _PROVIDERS,
    target = "module.dns",
)

al_terraform_test_map(
    name = "tf_tests",
    configs = _CONFIGS,
    data = _DATA,
    providers = _PROVIDERS,
)
