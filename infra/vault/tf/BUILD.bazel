load("//tools/al:al_terraform.bzl", "al_terraform_package")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/vault:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_DATA = glob([
    "*.tf",
    "approle_src_infra_openhands/*.tf",
    "approles/*/*.tf",
    "dns_access/*.tf",
]) + [
    "//infra/local_inference/dns:dnsconfig",
    "//data/ssl/alwaldend.com:ica1",
    "//data/ssl/alwaldend.com:simeonwarren",
    "//projects/tf_modules/backup_bucket",
    "//projects/tf_modules/tf_backend",
    "//projects/tf_modules/vault_approle",
    "//projects/tf_modules/vault_pki_ica",
    "//projects/tf_modules/vault_pki_server",
    "//projects/tf_modules/vault_oidc_provider",
    "//projects/tf_modules/vault_ssh_server_role",
]

al_terraform_package(
    name = "tf",
    configs = ["//infra/vault:al"],
    data = _DATA,
    plugin_labels = {
        "tf": "main",
        "vault_env": "default_default",
    },
    providers = [
        "@terraform_provider_hashicorp_local//:provider",
        "@terraform_provider_hashicorp_random//:provider",
        "@terraform_provider_hashicorp_vault//:provider",
        "@terraform_provider_yandex_cloud_yandex//:provider",
    ],
    test_kwargs = {
        "args": {
            "fmt": [
                "--direct",
                "fmt",
                "-check",
                "-recursive",
            ],
            "validate": ["validate"],
        },
        "data": [path for path in _DATA if path != "backend.tf"],
    },
)

filegroup(
    name = "dns_access",
    srcs = ["dns_access/main.tf"],
    visibility = ["//infra/vault:approle_state_projects"],
)
