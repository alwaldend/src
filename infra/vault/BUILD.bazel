load("@rules_al//:defs.bzl", "al_binary_run", "al_config", "al_inject", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_ansible_keys", "infra_dns", "infra_pve_provider_inputs", "infra_rclone_config", "infra_yc_account", "infra_yc_auth", "infra_yc_bucket_auth")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//infra:__subpackages__"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

al_vault_auth(
    name = "auth",
    approle = "src_infra_dc1_vault",
    extends = "//tools/al:auth",
)

infra_ansible_keys(
    name = "ansible_keys",
    labels = {"ansible": "1"},
    vault_ssh = {
        "backend": "ssh/clients/sign/admins",
        "ttl": 7200,
    },
)

vault_tf_backend(
    name = "tf_backend_setup",
    labels = {
        "dns": "1",
        "tf": "setup",
    },
    path = "alwaldend.com/vault1/approles/src_infra_dc1_vault/tf_backend/tf_setup",
)

vault_tf_backend(
    name = "tf_backend_main",
    extends = ":tf_backend_setup",
    labels = {"tf": "main"},
    path = "alwaldend.com/vault1/approles/src_infra_dc1_vault/tf_backend/main",
    visibility = ["//infra/vault/approles/src_infra_download:__pkg__"],
)

infra_yc_auth(
    name = "yc_auth",
    labels = {"tf": "main"},
    path = "yandex.cloud/org1/folders/src-infra-dc1-vault/account_iam_key",
)

infra_yc_bucket_auth(
    name = "yc_bucket_auth",
    labels = {"tf": "main"},
    path = "yandex.cloud/org1/folders/src-infra-dc1-vault/account_static_key",
)

infra_yc_account(
    name = "yc_account",
    labels = {"tf": "main"},
    path = "yandex.cloud/org1/folders/src-infra-dc1-vault/account",
)

infra_rclone_config(
    name = "rclone_config",
    labels = {"backup": "1"},
    path = "alwaldend.com/vault1/approles/src_infra_dc1_vault/backup_bucket",
)

al_inject(
    name = "al.plugin_call.unseal",
    config_name = "unseal",
    labels = {"unseal": "1"},
    res_env = {"UNSEAL_KEY": {
        "value": "{{ .Last.Data.encrypted_key }}",
        "deps": ["unseal"],
    }},
    res_kv = {"unseal": {
        "mount": "secrets",
        "path": "alwaldend.com/vault1/approles/src_infra_dc1_vault/unseal",
    }},
)

infra_pve_provider_inputs(
    name = "pve_provider_inputs",
    labels = {"dns": "1"},
)

infra_dns(
    name = "dns_providers",
    dc1 = True,
    labels = {
        "dns": "1",
        "tf": "setup",
    },
)

al_config(
    name = "al",
    configs = [
        ":al.plugin_call.unseal",
        ":ansible_keys",
        ":auth",
        ":dns_providers",
        ":pve_provider_inputs",
        ":rclone_config",
        ":tf_backend_main",
        ":tf_backend_setup",
        ":yc_account",
        ":yc_auth",
        ":yc_bucket_auth",
        "//infra:al",
    ],
    visibility = ["//infra/vault:__subpackages__"],
)

al_binary_run(
    name = "gen_client_cert",
    args = [
        "$(rootpath //tools/vault/gen_client_cert)",
        "--vault",
        "$(rootpath //tools/vault)",
    ],
    configs = ["//infra/vault:al"],
    data = [
        "//tools/vault",
        "//tools/vault/gen_client_cert",
    ],
    plugin_labels = {"vault_env": "default_default"},
)

al_binary_run(
    name = "gen_root_token",
    args = [
        "$(rootpath //tools/vault/gen_root_token)",
        "--vault",
        "$(rootpath //tools/vault)",
    ],
    configs = ["//infra/vault:al"],
    data = [
        "//tools/vault",
        "//tools/vault/gen_root_token",
    ],
    plugin_labels = {"vault_env": "default_no_auth"},
)

al_binary_run(
    name = "unseal",
    args = [
        "$(rootpath //tools/vault/unseal)",
        "--vault",
        "$(rootpath //tools/vault)",
        "https://host1.vault.dc1.alwaldend.com:8200",
    ],
    configs = ["//infra/vault:al"],
    data = [
        "//tools/vault",
        "//tools/vault/unseal",
        "//tools/ykman",
    ],
    plugin_labels = {
        "vault_env": "default_no_auth",
        "unseal": "",
    },
)

al_binary_run(
    name = "unseal_standalone",
    args = [
        "$(rootpath //tools/vault/unseal)",
        "--vault",
        "$(rootpath //tools/vault)",
        "https://host1.vault.dc1.alwaldend.com:8200",
    ],
    configs = ["//infra/vault:al"],
    data = [
        "//tools/vault",
        "//tools/vault/unseal",
        "//tools/ykman",
    ],
    plugin_labels = {"vault_env": "default_no_auth"},
)

al_binary_run(
    name = "backup",
    args = [
        "$(rootpath //tools/vault/backup)",
        "--rclone",
        "$(rootpath //third_party/org_rclone_rclone:rclone)",
        "--vault",
        "$(rootpath //tools/vault)",
    ],
    configs = ["//infra/vault:al"],
    data = [
        "//third_party/org_rclone_rclone:rclone",
        "//tools/vault",
        "//tools/vault/backup",
    ],
    plugin_labels = {
        "vault_env": "default_default",
        "backup": "",
        "tf": "",
    },
)
