load("@rules_al//:defs.bzl", "al_config")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary", "terraform_test_map")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//infra:transitive_consumers")

_DATA = glob([
    "*.tf",
    "tests/*.tftest.hcl",
]) + [
    "//projects/tf_modules/vault_approle",
    "//projects/tf_modules/vault_pki_server",
    "//projects/tf_modules/vault_ssh_server_role",
    "//infra/vault/tf:dns_access",
]

_PROVIDERS = ["@terraform_provider_hashicorp_vault//:provider"]

vault_tf_backend(
    name = "download_approle_backend",
    extends = "//infra/vault:tf_backend_main",
    labels = {"tf": "approle_download"},
    path = "alwaldend.com/vault1/approles/src_infra_dc1_vault/tf_backend/approles/src_infra_download",
)

al_config(
    name = "al",
    configs = [
        ":download_approle_backend",
        "//infra/vault:al",
    ],
)

al_terraform_binary_map(
    name = "tf",
    configs = [":al"],
    data = _DATA,
    plugin_labels = {
        "tf": "approle_download",
        "vault_env": "default_default",
    },
    providers = _PROVIDERS,
)

terraform_binary(
    name = "offline",
    testonly = True,
    arguments = ["--direct"],
    data = _DATA,
    providers = _PROVIDERS,
)

terraform_test_map(
    name = "tf_tests",
    data = _DATA,
    providers = _PROVIDERS,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//infra/vault:__pkg__"],
)
