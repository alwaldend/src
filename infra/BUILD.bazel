load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")
load("//projects/al/rules/al:al_config.bzl", "al_config")

package(transitive_visibility = "//infra:transitive_consumers")

package_group(
    name = "transitive_consumers",
    packages = [
        "//",
        "//.agents/...",
        "//data/...",
        "//infra/...",
        "//third_party/...",
        "//tools/...",
        "//users/...",
        # Website documentation and its developer commands.
        "//projects/alwaldend.com/...",
        # The AL configuration for the authenticated developer command.
        "//projects/x_article_uploader",
    ],
)

pkg_filegroup(
    name = "ansible_cfg",
    srcs = [":ansible_cfg_file"],
    visibility = ["//:__subpackages__"],
)

pkg_files(
    name = "ansible_cfg_file",
    srcs = ["ansible.cfg"],
)

al_config(
    name = "al",
    data = ["al_lib.lua"],
    visibility = ["//:__subpackages__"],
    deps = ["//tools/al:config"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
