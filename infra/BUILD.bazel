load("@rules_al//:defs.bzl", "al_config")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

package(transitive_visibility = "//infra:transitive_consumers")

package_group(
    name = "transitive_consumers",
    includes = [
        "//infra/image_gen:configuration_acceptance_consumers",
        "//infra/image_gen:workflow_configuration_consumers",
        "//projects/vastai_terraform_provider:credential_consumers",
        "//projects/x_profile_cleaner:credential_consumers",
    ],
    packages = [
        "//",
        "//.agents/...",
        "//data/...",
        "//infra/...",
        "//third_party/...",
        "//tools/...",
        "//users/...",
        # Website documentation and its developer commands.
        "//projects/alwaldend.com/...",
        # The AL configuration for the authenticated developer command.
        "//projects/x_article_uploader",
    ],
)

pkg_filegroup(
    name = "ansible_cfg",
    srcs = [":ansible_cfg_file"],
    visibility = ["//:__subpackages__"],
)

pkg_files(
    name = "ansible_cfg_file",
    srcs = ["ansible.cfg"],
)

al_config(
    name = "al",
    configs = ["//tools/al:config"],
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

exports_files(
    ["al_config.bzl"],
    visibility = ["//:__subpackages__"],
)
