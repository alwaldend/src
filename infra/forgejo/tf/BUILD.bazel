load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_package")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/forgejo:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

filegroup(
    name = "runner_bootstrap_source",
    srcs = ["runner_bootstrap.tf"],
    visibility = ["//infra/forgejo/cmd/runner_registration:__pkg__"],
)

al_terraform_package(
    name = "tf",
    configs = ["//infra/forgejo:al"],
    data = glob(["*.tf"]) + [
        "//infra/forgejo/cmd/runner_registration",
        "//infra/repos:config",
        "//infra/repos/tf:module",
    ],
    plugin_labels = {
        "tf": "main",
        "vault_env": "default_default",
    },
    providers = [
        "@terraform_provider_hashicorp_vault//:provider",
        "@terraform_provider_svalabs_forgejo//:provider",
    ],
    tests_use_al = True,
)
