load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg")

mermaid_site_svg(
    name = "architecture",
    src = "architecture.mmd",
    out = "rendered/architecture.svg",
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.mmd"]),
    visibility = ["//infra/forgejo:__pkg__"],
    deps = [":docs_assets"],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":architecture",
    ],
    prefix = "content/docs/infra/forgejo/docs/assets",
)
