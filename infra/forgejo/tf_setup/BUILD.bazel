load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_package")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/forgejo:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_PROVIDERS = [
    "@terraform_provider_vatesfr_xenorchestra//:provider",
]

_CONFIGS = ["//infra/forgejo:al"]

_DATA = glob(["*.tf"]) + [
    "//infra/cloud_init:xen_linux",
    "//infra/forgejo/dns:dnsconfig",
    "//tools/vault/cmd/ssh_key",
    "//infra/xcp_ng/cmd/xo_login",
]

filegroup(
    name = "signing_bootstrap_source",
    srcs = ["signing_bootstrap.tf"],
    visibility = ["//infra/forgejo/test/signing_key:__pkg__"],
)

al_terraform_package(
    name = "tf_setup",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = {
        "tf": "setup",
        "vault_env": "default_default",
        "xoa_login": "1",
    },
    providers = _PROVIDERS,
    tests_name = "tf_tests",
    tests_use_al = True,
)
