load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_package")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/yandex_cloud/org1:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_terraform_package(
    name = "tf",
    configs = ["//infra/yandex_cloud/org1:al"],
    data = glob(["*.tf"]) + [
        "//projects/tf_modules/tf_backend",
        "//projects/tf_modules/yc_folder",
    ],
    plugin_labels = {
        "tf": "",
        "vault_env": "default_default",
    },
    providers = [
        "@terraform_provider_hashicorp_vault//:provider",
        "@terraform_provider_yandex_cloud_yandex//:provider",
    ],
    tests_name = "tf_test",
    tests_use_al = True,
)
