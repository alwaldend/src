load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map", "al_terraform_test_map")

package(transitive_visibility = "//infra:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//infra/yandex_cloud/org1:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_PROVIDERS = [
    "@terraform_provider_hashicorp_vault//:provider",
    "@terraform_provider_yandex_cloud_yandex//:provider",
]

_CONFIGS = ["//infra/yandex_cloud/org1:al"]

_DATA = glob(["*.tf"]) + [
    "//projects/tf_modules/yc_folder",
    "//projects/tf_modules/tf_backend",
]

al_terraform_binary_map(
    name = "tf",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = {
        "tf": "",
        "vault_env": "default_default",
    },
    providers = _PROVIDERS,
)

al_terraform_test_map(
    name = "tf_test",
    configs = _CONFIGS,
    data = _DATA,
    providers = _PROVIDERS,
)
