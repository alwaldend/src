# Upstream rules_lint format discovery exclusions. These files are owned by
# generators, dependency managers, or upstream vendors and must not be
# rewritten by general-purpose formatters.
data/** rules-lint-ignored=true
third_party/** rules-lint-ignored=true
# Versioned records under the canonical agent-goal owner are tool-generated
# or digest-bound. Validate and regenerate them through the goal workflow;
# generic Markdown/YAML formatting can invalidate exact evidence.
projects/agents/goals/*/** rules-lint-ignored=true
projects/agents/goals/*/attempts/*/result.md whitespace=-blank-at-eof
projects/agents/goals/*/attempts/*/evidence/*.md whitespace=-blank-at-eof
tools/agents/catalogs/action.json rules-lint-ignored=true
tools/agents/catalogs/capability.json rules-lint-ignored=true
tools/agents/catalogs/index.json rules-lint-ignored=true
tools/agents/catalogs/skill-cases.json rules-lint-ignored=true
tools/agents/catalogs/skill-coverage.md rules-lint-ignored=true
tools/agents/catalogs/skill-coverage.json rules-lint-ignored=true
**/MODULE.bazel.lock rules-lint-ignored=true
**/pnpm-lock.yaml rules-lint-ignored=true
**/go.sum rules-lint-ignored=true
**/go.work.sum rules-lint-ignored=true
**/.terraform.lock.hcl rules-lint-ignored=true
**/*_lock.json rules-lint-ignored=true
**/lazy-lock.json rules-lint-ignored=true
**/binary_toolchain.json rules-lint-ignored=true
maven_install.json rules-lint-ignored=true
requirements.txt rules-lint-ignored=true
gazelle_python.yaml rules-lint-ignored=true
infra/dns/types-dnscontrol.d.ts rules-lint-ignored=true
projects/rules_promptfoo/tests/fake_cli/fake_codex_home/auth.json rules-lint-ignored=true
projects/alwaldend.com/layouts/** rules-lint-ignored=true
projects/ci_platform/main/go/docs/swagger.* rules-lint-ignored=true
projects/dotfiles/vial/** rules-lint-ignored=true

# Explicit templates require a formatter that understands both the host
# language and its template dialect. Ordinary Markdown/YAML/HTML files remain
# governed by their normal formatter even when they contain template strings.
*.j2 rules-lint-ignored=true
*.tmpl rules-lint-ignored=true
*.tpl rules-lint-ignored=true

# HCL outside Terraform has no repository-wide canonical formatter. Terraform
# sources remain covered through their .tf/.tfvars extensions and owning
# Bazel targets; HCL files are checked only by their owning consumers.
*.hcl rules-lint-ignored=true

# These extensions are intentionally generic or application-specific. Their
# owning applications and Bazel builds are authoritative; a generic formatter
# or linter would guess the dialect and can silently change semantics.
*.cfg rules-lint-ignored=true
*.conf rules-lint-ignored=true
*.ini rules-lint-ignored=true
*.service rules-lint-ignored=true
*.desktop rules-lint-ignored=true
*.policy rules-lint-ignored=true
*.pro rules-lint-ignored=true
*.rules rules-lint-ignored=true
*.rsc rules-lint-ignored=true
*.snippets rules-lint-ignored=true
*.zone rules-lint-ignored=true

# Diagram and vector assets are edited or generated by their owning tools.
# Their XML structure may be validated by consumers, but general formatting
# creates noisy churn and can invalidate generator expectations.
*.bpmn rules-lint-ignored=true
*.drawio rules-lint-ignored=true
*.svg rules-lint-ignored=true

# Ansible YAML is an embedded Jinja dialect. Its owning Bazel/Ansible checks
# are authoritative; generic YAML formatters reject valid Ansible constructs.
infra/**/ansible/** rules-lint-ignored=true
projects/ansible_collection/** rules-lint-ignored=true
users/**/ansible/** rules-lint-ignored=true

# SOPS-encrypted manifests are owned by the SOPS workflow. Formatter diffs can
# expose their encrypted payloads in logs and may invalidate authenticated
# metadata, so general-purpose formatters must not rewrite them.
infra/flux/cl/cert-manager/issuer-approle.yaml rules-lint-ignored=true
infra/flux/cl/flux-system/flux-operator-oidc.yaml rules-lint-ignored=true
infra/harbor/cl/cert-manager/issuer-approle.yaml rules-lint-ignored=true
projects/kustomization/flux-repo/flux-git-src-secret.yaml rules-lint-ignored=true
projects/kustomization/flux-repo/flux-sops-secret.yaml rules-lint-ignored=true
