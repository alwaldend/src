load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

filegroup(
    name = "cases",
    srcs = glob([
        "*/*.json",
        "*/*.txt",
        "*/*.jpg",
        "*/*.png",
    ]),
    visibility = ["//projects/comfyui_tools:asset_consumers"],
)

exports_files(
    ["README.md"],
    visibility = ["//projects/comfyui_tools:asset_consumers"],
)

docs_filegroup(
    name = "docs",
    srcs = [
        "README.md",
        "plush_petting/README.md",
        "plush_petting/lift-sketch.png",
        "plush_petting/sketch-prompt.txt",
    ],
    preserve_paths = True,
    visibility = ["//projects/comfyui_tools:__pkg__"],
)
