load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

filegroup(
    name = "cases",
    srcs = glob([
        "*/*.json",
        "*/*.txt",
        "*/*.jpg",
    ]),
    visibility = ["//projects/comfyui_tools:asset_consumers"],
)

exports_files(
    ["README.md"],
    visibility = ["//projects/comfyui_tools:asset_consumers"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects/comfyui_tools:__pkg__"],
)
