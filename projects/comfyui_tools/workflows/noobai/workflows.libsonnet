// Approved SDXL checkpoint using the shared generation/reference graphs.
local g = import '../internal/graph.libsonnet';
local n = import '../internal/nodes.libsonnet';

function(models)
  // Laxhar's NoobAI XL 1.1 model card recommends Euler a, 25–30 steps and CFG 5–6.
  local quality = 'masterpiece, best quality, newest, absurdres, highres, safe';
  local settings = {
    name: 'NoobAI XL 1.1',
    prefix: 'NoobAI',
    steps: 30,
    cfg: 5.5,
    sampler: 'euler_ancestral',
    scheduler: 'normal',
    prompt: quality + ', watercolor illustration, robot, blue body, red chest plate, reading, open book, park bench, snowy park, clear silhouettes',
    negative: 'nsfw, worst quality, old, early, low quality, lowres, signature, username, logo, bad hands, mutated hands, mammal, anthro, furry, ambiguous form, feral, semi-anthro',
    sequence_context: quality + ', watercolor illustration, consistent small blue robot with a red chest plate, snowy park, one scene',
    reference_context: quality + ', illustration, consistent referenced characters and visual style, one scene',
  };
  local workflows = (import '../internal/sdxl.libsonnet')(models, settings);
  local sequence = {
    shared_prompt: quality + ', chibi, robot, blue body, yellow eyes, red chest plate, flat color, lineart, solo',
    actions: std.join('\n\n', [
      'medium shot, eye level, snowy park, wooden bench, fir trees, overcast, standing, arms at sides',
      'medium shot, eye level, snowy park, wooden bench, fir trees, overcast, standing, raised right hand, waving',
      'medium shot, eye level, snowy park, wooden bench, fir trees, overcast, standing, right hand above shoulder, waving',
      '---',
      'medium shot, eye level, library, wooden desk, bookshelves, warm lighting, sitting, closed red book on desk, hands beside book',
      'medium shot, eye level, library, wooden desk, bookshelves, warm lighting, sitting, closed red book on desk, right hand on cover',
      'medium shot, eye level, library, wooden desk, bookshelves, warm lighting, sitting, open red book on desk, hands on pages',
    ]),
  };
  workflows + (import 'sketch_edit.libsonnet')(models, settings, quality) {
    'image-sequence': {
      version: 0.4,
      config: {},
      last_node_id: 7,
      last_link_id: 9,
      groups: [
        { title: '1. Persistent references', bounding: [-30, -40, 390, 350], color: '#3f789e', font_size: 24, flags: {} },
        { title: '2. Scenes and actions', bounding: [800, -40, 760, 1120], color: '#3f789e', font_size: 24, flags: {} },
        { title: 'Reference strength and installed models', bounding: [370, -40, 400, 760], color: '#555555', font_size: 20, flags: {} },
      ],
      nodes: [
        n.node(1, 'ImagegenReferenceImages', ['reference.png', '(none)', '(none)', '(none)'], [0, 0], [330, 250], title='Appearance references and optional continuation'),
        n.node(2, 'CheckpointLoaderSimple', [models.checkpoint], [400, 0], [330, 150]),
        n.node(3, 'IPAdapterModelLoader', [models.ipadapter], [400, 200], [330, 100]),
        n.node(4, 'CLIPVisionLoader', [models.clip_vision], [400, 350], [330, 100]),
        n.node(5, 'IPAdapterAdvanced', [0.05, 'linear', 'concat', 0.0, 0.8, 'V only'], [400, 500], [330, 220], title='Persistent appearance influence'),
        n.node(6, 'ImagegenImageSequence', [
          sequence.shared_prompt,
          sequence.actions,
          settings.negative,
          0.6,
          1024,
          1024,
          42,
          'fixed',
          settings.steps,
          settings.cfg,
          settings.sampler,
          settings.scheduler,
          1,
          0,
          'sequence',
          500,
          0.2,
          0.75,
          4,
          'continue_previous',
          'increment',
          0,
          0.4,
        ], [830, 0], [700, 1020], title='NoobAI image sequence'),
        n.node(7, 'ControlNetLoader', [models.controlnet], [400, 800], [330, 100], title='Optional scene structure'),
      ],
      links: [
        [1, 2, 0, 5, 0],
        [2, 3, 0, 5, 1],
        [3, 1, 0, 5, 2],
        [4, 4, 0, 5, 3],
        [5, 5, 0, 6, 0],
        [6, 2, 1, 6, 1],
        [7, 2, 2, 6, 2],
        [8, 1, 1, 6, 3],
        [9, 7, 0, 6, 4],
      ],
      extra: {
        ds: { offset: [50, 80], scale: 0.65 },
        linearMode: false,
        linearData: {
          inputs: [
            [1, 'reference_1'],
            [1, 'reference_2'],
            [1, 'reference_3'],
            [6, 'shared_prompt', { height: 150, description: 'Appearance and style reused throughout. Put changing locations in each action.' }],
            [6, 'actions', { height: 350, description: 'One desired image per line. Use --- on its own line to start a fresh scene; following actions edit the preceding image.' }],
            [6, 'change_strength'],
            [6, 'control_strength'],
            [6, 'control_end'],
            [6, 'gif_frame_duration_ms'],
            [6, 'interpolation_multiplier'],
            [5, 'weight', { description: 'Reference influence. Start low for NoobAI; stronger values can distort colors and anatomy.' }],
            [6, 'width'],
            [6, 'height'],
            [6, 'seed'],
            [6, 'start_image'],
            [6, 'image_count'],
            [1, 'continuation'],
            [6, 'negative_prompt', { height: 100 }],
            [6, 'steps'],
            [6, 'cfg'],
            [6, 'filename_prefix'],
          ],
          outputs: [6],
        },
      },
    },
    'image-sequence.app': self['image-sequence'] { extra+: { linearMode: true } },
    'reference-sequence': local base = self['image-sequence']; g.variant(base, {
      updates: {
        '6': {
          title: 'Reference sequence: continue the previous image',
          widgets_values: std.mapWithIndex(function(index, value)
                                             if index == 16 then 0 else if index == 18 then 1 else value,
                                           base.nodes[5].widgets_values),
        },
      },
    }),
    'reference-sequence.app': self['reference-sequence'] { extra+: { linearMode: true } },
    'scene-composer': {
      version: 0.4,
      config: {},
      last_node_id: 4,
      last_link_id: 7,
      groups: [
        { title: 'Shared character, clothing and visual style', bounding: [-30, 420, 680, 780], color: '#3f789e', font_size: 24, flags: {} },
        { title: 'Native model and optional installed LoRA', bounding: [-30, -40, 680, 420], color: '#555555', font_size: 24, flags: {} },
        { title: 'Independent generation and latent refinement', bounding: [720, -40, 760, 1220], color: '#3f789e', font_size: 24, flags: {} },
      ],
      nodes: [
        n.node(1, 'CheckpointLoaderSimple', [models.checkpoint], [0, 0], [300, 150]),
        n.node(2, 'ImagegenOptionalLora', ['(none)', 1.0, 1.0], [340, 0], [300, 230], title='Optional installed character or style LoRA'),
        n.node(3, 'ImagegenScenePrompts', [
          '1girl, adult woman, solo, long black hair, green eyes',
          'red coat, black skirt, black tights, black boots',
          quality + ', anime illustration, soft shading, detailed background',
          'snowy park, wooden bench, fir trees, soft daylight\nlibrary, wooden desk, bookshelves, warm lighting',
          'medium shot, standing, arms at sides\nmedium shot, standing, waving, raised right hand\nmedium shot, standing, right hand above shoulder\n---\nmedium shot, sitting at desk, closed book, hands beside book\nmedium shot, sitting at desk, hand on book\nmedium shot, sitting at desk, reading, holding open book',
        ], [0, 470], [620, 680], title='Shared descriptions, scene settings and actions'),
        n.node(4, 'ImagegenImageSequence', [
          '',
          '',
          settings.negative,
          0.45,
          832,
          1216,
          42,
          'fixed',
          25,
          settings.cfg,
          settings.sampler,
          settings.scheduler,
          1,
          0,
          'composer',
          500,
          0,
          0.75,
          1,
          'independent',
          'fixed',
          20,
          0.4,
        ], [750, 0], [700, 1130], title='Scene composer: independent images and second pass') {
          inputs+: [
            { name: 'shared_prompt', type: 'STRING', widget: { name: 'shared_prompt' } },
            { name: 'actions', type: 'STRING', widget: { name: 'actions' } },
          ],
        },
      ],
      links: [
        [1, 1, 0, 2, 0],
        [2, 1, 1, 2, 1],
        [3, 2, 0, 4, 0],
        [4, 2, 1, 4, 1],
        [5, 1, 2, 4, 2],
        [6, 3, 0, 4, 5],
        [7, 3, 1, 4, 6],
      ],
      extra: {
        ds: { offset: [40, 70], scale: 0.65 },
        linearMode: false,
        linearData: {
          inputs: [
            [3, 'character_prompt', { height: 130, description: 'Fixed character description reused for every image. This version uses prompts, not uploaded reference images.' }],
            [3, 'clothing_prompt', { height: 100 }],
            [3, 'style_prompt', { height: 100 }],
            [3, 'scene_settings', { height: 150, description: 'One setting per scene, one per nonempty line. A single setting applies throughout.' }],
            [3, 'actions', { height: 300, description: 'One desired image per line; --- advances to the next scene setting. Every image is generated independently.' }],
            [2, 'lora_name', { description: 'Optional already-installed LoRA. None is selected or downloaded by default.' }],
            [2, 'strength_model'],
            [2, 'strength_clip'],
            [4, 'width'],
            [4, 'height'],
            [4, 'seed'],
            [4, 'seed_mode'],
            [4, 'steps'],
            [4, 'cfg'],
            [4, 'refiner_steps'],
            [4, 'refiner_denoise'],
            [4, 'start_image'],
            [4, 'image_count'],
            [4, 'negative_prompt', { height: 100 }],
            [4, 'gif_frame_duration_ms'],
            [4, 'interpolation_multiplier'],
            [4, 'filename_prefix'],
          ],
          outputs: [4],
        },
      },
    },
    'scene-composer.app': self['scene-composer'] { extra+: { linearMode: true } },
    'image-to-image-prompt-sequence': g.sequence(workflows['image-to-image'],
                                                 n.node(10, 'ImagegenPromptSequence', ['The referenced character stands beside a bench.\n\nThe referenced character sits on the bench.\n\nThe referenced character waves beside the bench.', settings.reference_context, 'line', 'img2img'], [380, 850], [680, 380], title='Img2img prompts; same reference for every image', order=9),
                                                 2,
                                                 3,
                                                 7,
                                                 [13, 14, 15]),
  }
