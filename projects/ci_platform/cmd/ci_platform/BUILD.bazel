load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_go//go:def.bzl", "go_binary", "go_library")

package(transitive_visibility = "//projects:transitive_consumers")

build_test(
    name = "build_test",
    targets = [
        ":ci_platform",
    ],
)

go_library(
    name = "go_lib",
    srcs = ["main.go"],
    importpath = "git.alwaldend.com/alwaldend/src/projects/ci_platform/cmd/ci_platform",
    visibility = ["//visibility:private"],
    deps = ["//projects/ci_platform/internal/command"],
)

go_binary(
    name = "ci_platform",
    embed = [":go_lib"],
    visibility = ["//:__subpackages__"],
)
