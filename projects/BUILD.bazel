load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/release/main/bzl:al_release_binary.bzl", "al_release_binary")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_release_binary(
    name = "deploy_heads",
    srcs = [
        "//projects/{}/releases:head".format(package)
        for package in subpackages(
            include = ["*"],
            exclude = [
                "mcp_cordis",
                "alwaldend.com",
                "ansible_collection",
                "bazel_registry",
                "bazel_agent",
                "goal",
                "useless_qt_gui",
                "renders",
            ],
        )
    ] + [],
)
