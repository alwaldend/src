load("@rules_al//:defs.bzl", "al_release_binary", "al_release_deployment")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

package_group(
    name = "transitive_consumers",
    packages = ["public"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
        exclude = [
            "al",
            "bazel_gazelle_enforce_transitive_visibility",
            "rules_trufflehog",
        ],
    ) + [
        "//tools/trufflehog:project_diagram",
        "@bazel_gazelle_enforce_transitive_visibility//:docs",
        "@rules_al//:docs",
        "@rules_trufflehog//:docs",
    ],
)

al_release_binary(
    name = "deploy_heads",
    srcs = [
        "//projects/{}/releases:head".format(package)
        for package in subpackages(
            include = ["*"],
            exclude = [
                "al",
                "anki_as_code",
                "mcp_cordis",
                "mlops_2026",
                "alwaldend.com",
                "ansible_collection",
                "bazel_registry",
                "bazel_deps_analyzer",
                "bazel_gazelle_enforce_transitive_visibility",
                "goal",
                "icon_generator",
                "useless_qt_gui",
                "renders",
                "rules_trufflehog",
                "x_article_uploader",
                "x_profile_cleaner",
                "llama_responses_bridge",
            ],
        )
    ] + [],
)

al_release_deployment(
    name = "release_deployment",
    oci_repository = "docker.io/alwaldend/src",
    visibility = ["//visibility:public"],
)
