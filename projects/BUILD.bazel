load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/release/main/bzl:al_release_binary.bzl", "al_release_binary")

package(transitive_visibility = "//projects:transitive_consumers")

package_group(
    name = "transitive_consumers",
    packages = ["public"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
        exclude = ["bazel_gazelle_enforce_transitive_visibility"],
    ) + ["@bazel_gazelle_enforce_transitive_visibility//:docs"],
)

al_release_binary(
    name = "deploy_heads",
    srcs = [
        "//projects/{}/releases:head".format(package)
        for package in subpackages(
            include = ["*"],
            exclude = [
                "anki_as_code",
                "mcp_cordis",
                "mlops_2026",
                "alwaldend.com",
                "ansible_collection",
                "bazel_registry",
                "bazel_agent",
                "bazel_deps_analyzer",
                "bazel_gazelle_enforce_transitive_visibility",
                "goal",
                "icon_generator",
                "useless_qt_gui",
                "renders",
                "x_article_uploader",
                "x_profile_cleaner",
            ],
        )
    ] + [],
)
