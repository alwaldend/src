load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects:projects.bzl", "PROJECTS")
load("//tools/release/main/bzl:al_release_binary.bzl", "al_release_binary")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
        exclude = ["rules_*"],
    ) + [
        "@rules_binary_toolchain//:docs",
        "@rules_dnscontrol//:docs",
        "@rules_docs//:docs",
        "@rules_docs_gazelle//:docs",
        "@rules_hugo//:docs",
        "@rules_iso//:docs",
        "@rules_promptfoo//:docs",
        "@rules_promptfoo_gazelle//:docs",
        "@rules_skill//:docs",
        "@rules_skill_gazelle//:docs",
        "@rules_template//:docs",
    ],
)

al_release_binary(
    name = "deploy_heads",
    srcs = [
        "//projects/{}/releases:head".format(package)
        for package in subpackages(
            include = ["*"],
            exclude = [
                "hugo_landing",
                "agents",
                "mcp_cordis",
                "alwaldend.com",
                "ansible_collection",
                "bazel_registry",
                "bazel_agent",
                "goal",
                "rules_dnscontrol",
                "rules_iso",
                "useless_qt_gui",
                "rules_template",
                "rules_binary_toolchain",
                "rules_docs",
                "rules_docs_gazelle",
                "rules_hugo",
                "rules_promptfoo",
                "rules_promptfoo_gazelle",
                "renders",
                "rules_skill",
                "rules_skill_gazelle",
            ],
        )
    ] + [],
)

_LANDING_TARGETS = [
    "//projects/hugo_landing/landing:{}".format(project) if project.startswith("rules_") else "//projects/{}/landing:site".format(project)
    for project in PROJECTS
]

filegroup(
    name = "landing_sites",
    srcs = _LANDING_TARGETS,
)

build_test(
    name = "landings",
    targets = _LANDING_TARGETS,
)

native_binary(
    name = "deploy_landings",
    src = "//projects/hugo_landing/cmd/deploy",
    args = [
        "--site={}=$(rootpath {})".format(project, target)
        for project, target in zip(PROJECTS, _LANDING_TARGETS)
    ],
    data = _LANDING_TARGETS,
)
