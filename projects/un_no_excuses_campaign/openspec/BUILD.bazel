load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_openspec//rules:workspace.bzl", "openspec_workspace")

package(transitive_visibility = "//projects:transitive_consumers")

openspec_workspace(
    name = "source",
    srcs = ["config.yaml"] + glob(
        [
            "specs/**/*.md",
            "changes/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//infra/src/openspec/validation"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(
        [
            "*.md",
            "specs/**/*.md",
        ],
        allow_empty = True,
    ),
    preserve_paths = True,
    visibility = ["//projects/un_no_excuses_campaign:__pkg__"],
)
