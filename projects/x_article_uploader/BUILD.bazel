load("@rules_al//:defs.bzl", "al_binary_run", "al_config", "al_injector_call", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/vault:defs.bzl", "vault_binary_map")

package(transitive_visibility = "//projects:transitive_consumers")

package_group(
    name = "x_api_credential_consumers",
    includes = ["//projects/x_profile_cleaner:credential_consumers"],
    packages = [
        "//projects/x_article_uploader/...",
        "//third_party/com_x_api_openapi",
    ],
)

al_vault_auth(
    name = "auth",
    approle = "src_projects_x_article_uploader",
    extends = "//tools/al:auth",
)

al_injector_call(
    name = "x_api",
    labels = {"x_api": "1"},
    res_env = {
        "X_API_KEY": {
            "value": "{{ .Last.Data.api_key }}",
            "deps": ["x_api"],
        },
        "X_API_SECRET": {
            "value": "{{ .Last.Data.api_secret }}",
            "deps": ["x_api"],
        },
        "X_ACCESS_TOKEN": {
            "value": "{{ .Last.Data.access_token }}",
            "deps": ["x_api"],
        },
        "X_ACCESS_TOKEN_SECRET": {
            "value": "{{ .Last.Data.access_token_secret }}",
            "deps": ["x_api"],
        },
    },
    res_kv = {
        "x_api": {
            "mount": "secrets",
            "path": "alwaldend.com/vault1/approles/src_projects_x_article_uploader/oauth1",
        },
    },
)

al_config(
    name = "al",
    configs = [
        ":auth",
        ":x_api",
        "//infra:al",
    ],
    visibility = [":x_api_credential_consumers"],
)

# Runs draft creation with the injected OAuth 1.0a credential. The plugin label
# selects the injection declared in BUILD.bazel; its config supplies the plugin. The
# target creates a draft only and never publishes an article.
al_binary_run(
    name = "draft",
    args = [
        "$(rootpath //projects/x_article_uploader/cmd/draft)",
    ],
    configs = [":al"],
    data = [
        "//projects/x_article_uploader/cmd/draft",
    ],
    plugin_labels = {"x_api": "1"},
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

test_suite(
    name = "test",
    tests = ["//projects/x_article_uploader/test/e2e:e2e_test"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects:__pkg__"],
    deps = [
        "//projects/x_article_uploader/openspec:docs",
        "//projects/x_article_uploader/site:docs",
    ],
)
