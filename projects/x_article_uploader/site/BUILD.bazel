load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(
        ["*.md"],
        allow_empty = True,
    ),
    visibility = ["//projects/x_article_uploader:__pkg__"],
    deps = ["//projects/x_article_uploader/site/content:docs"],
)
