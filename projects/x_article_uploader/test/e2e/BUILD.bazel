load("@rules_go//go:def.bzl", "go_test")

# The content tree is declared as data so the checks discover the real posts
# from the build graph rather than from a hand-maintained list.
go_test(
    name = "e2e_test",
    size = "medium",
    srcs = [
        "constructs_test.go",
        "conversion_test.go",
        "draft_test.go",
        "raster_test.go",
        "support_test.go",
    ],
    args = [
        "-raster-render=$(rlocationpath //tools/mermaid/test/renderer:smoke_webp)",
        "-raster-source=$(rlocationpath //tools/mermaid/test/renderer:smoke_svg)",
    ],
    data = [
        "//projects/alwaldend.com/content/blog:test_data",
        "//tools/mermaid/test/renderer:smoke_svg",
        "//tools/mermaid/test/renderer:smoke_webp",
    ],
    deps = [
        "//projects/x_article_uploader/internal/draft",
        "//projects/x_article_uploader/internal/draftjs",
        "//projects/x_article_uploader/internal/markdown",
        "//projects/x_article_uploader/internal/xapi",
        "//tools/mermaid/test/svgdoc",
        "@rules_go//go/runfiles",
    ],
)
