load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects/goal:__pkg__"],
)

go_library(
    name = "go_lib",
    srcs = [
        "command.go",
        "learning.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/projects/goal/cmd/goal",
    visibility = ["//visibility:private"],
    deps = [
        "//projects/goal/internal/fsstore",
        "//tools/agents/api/v1alpha1",
        "//tools/agents/catalog/v1alpha1",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "goal",
    embed = [":go_lib"],
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "go_test",
    size = "small",
    srcs = ["command_test.go"],
    embed = [":go_lib"],
)
