load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_promptfoo//promptfoo:defs.bzl", "promptfoo_validate_test")
load("@rules_skill//skill:defs.bzl", "skill_library")

skill_library(
    name = "skill",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD",
            "BUILD.bazel",
            "evals/**",
        ],
    ),
    visibility = ["//tools/agents:skill_discovery"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/goal:__pkg__"],
    deps = [
        ":evaluation_docs",
        ":reference_docs",
    ],
)

docs_filegroup(
    name = "reference_docs",
    srcs = glob(["references/*.md"]),
    prefix = "content/docs/projects/goal/skills/goal/references",
)

docs_filegroup(
    name = "evaluation_docs",
    srcs = glob(["evals/*.md"]),
    prefix = "content/docs/projects/goal/skills/goal/evals",
)

filegroup(
    name = "eval_cases",
    testonly = True,
    srcs = ["evals/cases.yaml"],
)

promptfoo_validate_test(
    name = "eval_config_test",
    config = "evals/promptfooconfig.yaml",
    data = [
        "evals/README.md",
        ":eval_cases",
    ],
    skills = [":skill"],
)
