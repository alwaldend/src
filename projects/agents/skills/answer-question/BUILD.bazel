load(
    "@rules_promptfoo//promptfoo:defs.bzl",
    "promptfoo_test",
    "promptfoo_validate_test",
)
load("@rules_skill//skill:defs.bzl", "skill_library")

skill_library(
    name = "skill",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD",
            "BUILD.bazel",
            "evals/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "eval_cases",
    testonly = True,
    srcs = ["evals/cases.yaml"],
)

promptfoo_validate_test(
    name = "eval_config_test",
    config = "evals/promptfooconfig.yaml",
    data = [
        "evals/README.md",
        "evals/cases.yaml",
    ],
    skills = [":skill"],
)

promptfoo_validate_test(
    name = "eval_no_skill_config_test",
    config = "evals/promptfooconfig.no_skill.yaml",
    data = [
        "evals/README.md",
        "evals/cases.yaml",
    ],
)

promptfoo_validate_test(
    name = "eval_routing_config_test",
    config = "evals/promptfooconfig.routing.yaml",
    data = [
        "evals/README.md",
        "evals/cases.yaml",
    ],
    skills = [":skill"],
)

promptfoo_test(
    name = "eval",
    size = "enormous",
    timeout = "eternal",
    config = "evals/promptfooconfig.yaml",
    data = [":eval_cases"],
    env_inherit = [
        "ALL_PROXY",
        "CODEX_HOME",
        "CODEX_PATH_OVERRIDE",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
    ],
    reuse_codex_login = True,
    skills = [":skill"],
)

promptfoo_test(
    name = "eval_no_skill",
    size = "enormous",
    timeout = "eternal",
    config = "evals/promptfooconfig.no_skill.yaml",
    data = [":eval_cases"],
    env_inherit = [
        "ALL_PROXY",
        "CODEX_HOME",
        "CODEX_PATH_OVERRIDE",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
    ],
    reuse_codex_login = True,
)

promptfoo_test(
    name = "eval_no_skill_stability",
    size = "enormous",
    timeout = "eternal",
    args = [
        "--repeat",
        "3",
    ],
    config = "evals/promptfooconfig.no_skill.yaml",
    data = [":eval_cases"],
    env_inherit = [
        "ALL_PROXY",
        "CODEX_HOME",
        "CODEX_PATH_OVERRIDE",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
    ],
    reuse_codex_login = True,
)

promptfoo_test(
    name = "eval_routing",
    size = "enormous",
    timeout = "eternal",
    config = "evals/promptfooconfig.routing.yaml",
    env_inherit = [
        "ALL_PROXY",
        "CODEX_HOME",
        "CODEX_PATH_OVERRIDE",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
    ],
    reuse_codex_login = True,
    skills = [":skill"],
)

promptfoo_test(
    name = "eval_stability",
    size = "enormous",
    timeout = "eternal",
    args = [
        "--repeat",
        "3",
    ],
    config = "evals/promptfooconfig.yaml",
    data = [":eval_cases"],
    env_inherit = [
        "ALL_PROXY",
        "CODEX_HOME",
        "CODEX_PATH_OVERRIDE",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
    ],
    reuse_codex_login = True,
    skills = [":skill"],
)
