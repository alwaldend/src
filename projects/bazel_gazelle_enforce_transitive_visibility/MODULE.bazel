module(
    name = "bazel_gazelle_enforce_transitive_visibility",
    version = "0.0.0",
    bazel_compatibility = [">=9.3.1"],
)

bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_docs", version = "0.0.0")
bazel_dep(name = "rules_go", version = "0.60.0")

local_path_override(
    module_name = "rules_docs",
    path = "../../tools/rules_docs",
)

local_path_override(
    module_name = "rules_openspec",
    path = "../../tools/rules_openspec",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps_mod = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps_mod.from_file(go_mod = "//:go.mod")
use_repo(go_deps_mod, "com_github_burntsushi_toml")
