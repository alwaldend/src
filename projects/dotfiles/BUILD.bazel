load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//projects/al/rules/al:al_config.bzl", "al_config")
load("//tools/make_install/main/bzl:al_make_install.bzl", "al_make_install")
load("//tools/make_install/main/bzl:al_make_install_binary.bzl", "al_make_install_binary")
load("//tools/vault:defs.bzl", "vault_binary_map")

build_test(
    name = "build_test",
    targets = [
        ":make_install",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = [
        "//projects:__pkg__",
        "//projects/dotfiles/landing:__pkg__",
    ],
    deps = [
        "//projects/dotfiles/releases:docs",
        "//projects/dotfiles/tf:docs",
    ],
)

al_make_install(
    name = "make_install",
    srcs = [
        "//projects/dotfiles/bin:make_install_filegroup",
        "//projects/dotfiles/home:make_install_filegroup",
        "//projects/dotfiles/nvim:make_install_filegroup",
    ],
)

al_make_install_binary(
    name = "install",
    src = "make_install",
    args = ["install"],
)

al_make_install_binary(
    name = "diff",
    src = "make_install",
    args = ["diff"],
)

al_make_install_binary(
    name = "help",
    src = "make_install",
    args = ["help"],
)

pkg_tar(
    name = "dotfiles",
    srcs = [":make_install"],
    package_dir = "dotfiles",
    visibility = ["//projects/dotfiles/releases:__pkg__"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
        "//projects/alwaldend.com:__subpackages__",
        "//projects/dotfiles/tf:__pkg__",
    ],
)

al_config(
    name = "al",
    srcs = ["al.lua"],
    visibility = ["//projects/dotfiles/tf:__pkg__"],
    deps = ["//infra:al"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)
