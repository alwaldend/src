load("@rules_al//:defs.bzl", "al_release_binary", "al_release_bundle", "al_release_files")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/release_pages:defs.bzl", "release_page")

package(transitive_visibility = "//projects:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/dotfiles:__pkg__"],
    deps = [
        ":head",
    ],
)

genquery(
    name = "check",
    expression = "deps(//projects/alwaldend.com/releases:head)",
    opts = [
        "--output",
        "graph",
    ],
    scope = ["//projects/alwaldend.com/releases:head"],
)

al_release_files(
    name = "files",
    srcs = [
        "//projects/dotfiles",
        "//projects/dotfiles/misc",
        "//projects/dotfiles/vial",
    ],
    deployments = ["//projects:release_deployment"],
)

release_page(
    name = "head",
    srcs = [
        ":files",
    ],
    project = "projects/dotfiles",
    release_name = "head",
    visibility = ["//projects:__pkg__"],
)

al_release_binary(
    name = "head_deploy",
    srcs = [":head"],
)

# Build this project independently with the shared release bootstrap.
al_release_bundle(
    name = "bundle",
    project = "projects/dotfiles",
    visibility = ["//:__subpackages__"],
    deps = [":files"],
)
