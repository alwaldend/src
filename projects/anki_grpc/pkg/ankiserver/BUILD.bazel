load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_library")

package(transitive_visibility = "//projects:transitive_consumers")

rust_library(
    name = "server_rust",
    srcs = [
        "cli.rs",
        "lib.rs",
        "wasi.rs",
    ],
    crate_name = "anki_grpc_server",
    crate_root = "lib.rs",
    edition = "2021",
    rustc_flags = ["-Cpanic=abort"],
    visibility = [
        "//projects/anki_grpc/cmd/anki_grpc:__pkg__",
        "//projects/anki_grpc/pkg/ankigrpc/native:__pkg__",
        "//projects/anki_grpc/pkg/ankigrpc/wasm:__pkg__",
        "//projects/anki_grpc/test/wasm/cmd/worker:__pkg__",
    ],
    deps = [
        "//projects/anki_grpc/internal/backend:backend_rust",
        "@com_github_ankitects_anki_crates//:bytes",
        "@com_github_ankitects_anki_crates//:hyper",
        "@com_github_ankitects_anki_crates//:hyper-util",
        "@com_github_ankitects_anki_crates//:tokio",
        "@com_github_ankitects_anki_crates//:tonic",
    ],
)

rust_clippy(
    name = "clippy",
    visibility = ["//projects/anki_grpc/cmd/anki_grpc:__pkg__"],
    deps = [
        ":server_rust",
    ],
)
