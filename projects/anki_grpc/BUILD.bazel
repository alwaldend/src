load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg", "mermaid_site_webp")

alias(
    name = "anki_grpc",
    actual = "//projects/anki_grpc/cmd/anki_grpc",
    visibility = [":server_consumers"],
)

alias(
    name = "clippy",
    actual = "//projects/anki_grpc/cmd/anki_grpc:clippy",
    visibility = ["//:__subpackages__"],
)

package_group(
    name = "server_consumers",
    packages = [
        "//projects/anki_grpc/pkg/backend",
        "//projects/anki_grpc/releases",
        "//projects/anki_grpc/test/transport",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects:__pkg__"],
    deps = [
        ":docs_assets",
        "//projects/anki_grpc/releases:docs",
    ],
)

mermaid_site_svg(
    name = "architecture",
    src = "docs/architecture.mmd",
    out = "rendered/architecture.svg",
)

docs_filegroup(
    name = "docs_assets",
    srcs = [":architecture"],
    prefix = "content/docs/projects/anki_grpc/assets",
)

mermaid_site_webp(
    name = "architecture_preview",
    src = "docs/architecture.mmd",
    out = "rendered/architecture.webp",
    aspect_ratio = [],
    color_scheme = "dark",
    tags = ["manual"],
)
