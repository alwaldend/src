load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg", "mermaid_site_webp")

package(transitive_visibility = "//projects:transitive_consumers")

alias(
    name = "anki_grpc",
    actual = "//projects/anki_grpc/cmd/anki_grpc",
    visibility = [":server_consumers"],
)

bool_flag(
    name = "cgo",
    build_setting_default = True,
    visibility = ["//:__subpackages__"],
)

config_setting(
    name = "with_cgo",
    flag_values = {":cgo": "true"},
    visibility = ["//:__subpackages__"],
)

bool_flag(
    name = "wasm",
    build_setting_default = False,
    visibility = ["//:__subpackages__"],
)

config_setting(
    name = "with_wasm",
    flag_values = {":wasm": "true"},
    visibility = ["//:__subpackages__"],
)

alias(
    name = "clippy",
    actual = "//projects/anki_grpc/cmd/anki_grpc:clippy",
    visibility = ["//:__subpackages__"],
)

package_group(
    name = "server_consumers",
    packages = [
        "//projects/anki_as_code/cmd/anki_as_code",
        "//projects/anki_as_code/internal/collection",
        "//projects/anki_as_code/internal/export",
        "//projects/anki_as_code/internal/plan",
        "//projects/anki_as_code/internal/rebuild",
        "//projects/anki_as_code/internal/reconcile",
        "//projects/anki_as_code/internal/resource",
        "//projects/anki_as_code/internal/state",
        "//projects/anki_as_code/pkg/ankiascode",
        "//projects/anki_grpc/pkg/ankiclient",
        "//projects/anki_grpc/releases",
        "//projects/anki_grpc/test/transport",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects:__pkg__"],
    deps = [
        ":docs_assets",
    ],
)

mermaid_site_svg(
    name = "architecture",
    src = "docs/architecture.mmd",
    out = "rendered/architecture.svg",
)

docs_filegroup(
    name = "docs_assets",
    srcs = [":architecture"],
    prefix = "content/docs/projects/anki_grpc/assets",
)

mermaid_site_webp(
    name = "architecture_preview",
    src = "docs/architecture.mmd",
    out = "rendered/architecture.webp",
    aspect_ratio = [],
    color_scheme = "dark",
    tags = ["manual"],
)
