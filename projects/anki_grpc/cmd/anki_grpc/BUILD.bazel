load("@rules_go//go:def.bzl", "go_binary")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy")

package(transitive_visibility = "//projects:transitive_consumers")

config_setting(
    name = "optimized",
    values = {"compilation_mode": "opt"},
)

rust_binary(
    name = "native",
    srcs = ["main.rs"],
    binary_name = "anki_grpc",
    crate_name = "anki_grpc",
    crate_root = "main.rs",
    edition = "2021",
    rustc_flags = ["-Cpanic=abort"] + select({
        ":optimized": ["-Cstrip=symbols"],
        "//conditions:default": [],
    }),
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//projects/anki_grpc:__subpackages__"],
    deps = ["//projects/anki_grpc/pkg/ankiserver:server_rust"],
)

rust_clippy(
    name = "command_clippy",
    visibility = ["//projects/anki_grpc:__pkg__"],
    deps = [
        ":native",
    ],
)

filegroup(
    name = "clippy",
    srcs = [
        ":command_clippy",
        "//projects/anki_grpc/internal/backend:clippy",
        "//projects/anki_grpc/pkg/ankigrpc/native:clippy",
        "//projects/anki_grpc/pkg/ankiserver:clippy",
    ],
    visibility = ["//projects/anki_grpc:__pkg__"],
)

go_binary(
    name = "wasm",
    srcs = [
        "doc.go",
        "main.go",
    ],
    basename = "anki_grpc",
    pure = "on",
    visibility = ["//projects/anki_grpc:__subpackages__"],
    deps = ["//projects/anki_grpc/pkg/ankigrpc/wasm"],
)

alias(
    name = "anki_grpc",
    actual = select({
        "//projects/anki_grpc:with_wasm": ":wasm",
        "//conditions:default": ":native",
    }),
    visibility = ["//projects/anki_grpc:__pkg__"],
)
