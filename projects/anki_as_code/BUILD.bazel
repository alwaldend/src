package_group(
    name = "config_consumers",
    packages = [
        "//projects/anki_as_code/cmd/anki_as_code",
        "//projects/anki_as_code/internal/collection",
        "//projects/anki_as_code/internal/export",
        "//projects/anki_as_code/internal/plan",
        "//projects/anki_as_code/internal/reconcile",
        "//projects/anki_as_code/internal/state",
        "//projects/anki_as_code/pkg/ankiascode",
    ],
)

bool_flag(
    name = "wasm",
    build_setting_default = False,
    visibility = ["//projects/anki_as_code:__subpackages__"],
)

config_setting(
    name = "with_wasm",
    flag_values = {":wasm": "true"},
)

alias(
    name = "anki_as_code",
    actual = select({
        ":with_wasm": "//projects/anki_as_code/cmd/anki_as_code:wasi",
        "//conditions:default": "//projects/anki_as_code/cmd/anki_as_code",
    }),
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects:__pkg__"],
    deps = [
        ":docs_assets",
        "//projects/anki_as_code/docs",
        "//projects/anki_as_code/docs:assets",
    ],
)

mermaid_site_svg(
    name = "backend_approaches",
    src = "backend-approaches.mmd",
    out = "rendered/backend-approaches.svg",
)

docs_filegroup(
    name = "docs_assets",
    srcs = [":backend_approaches"],
    prefix = "content/docs/projects/anki_as_code/assets",
)

mermaid_site_webp(
    name = "backend_approaches_preview",
    src = "backend-approaches.mmd",
    out = "rendered/backend-approaches.webp",
    aspect_ratio = [],
    color_scheme = "dark",
    tags = ["manual"],
)
