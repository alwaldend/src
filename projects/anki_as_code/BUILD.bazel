load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg", "mermaid_site_webp")

# gazelle:resolve go github.com/ankitects/anki/proto/anki/decks //third_party/com_github_ankitects_anki:decks
# gazelle:resolve go github.com/ankitects/anki/proto/anki/notetypes //third_party/com_github_ankitects_anki:notetypes

package_group(
    name = "config_consumers",
    packages = [
        "//projects/anki_as_code/cmd/anki_as_code",
        "//projects/anki_as_code/internal/app",
    ],
)

alias(
    name = "anki_as_code",
    actual = "//projects/anki_as_code/cmd/anki_as_code",
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects:__pkg__"],
    deps = [":docs_assets"],
)

mermaid_site_svg(
    name = "backend_approaches",
    src = "backend-approaches.mmd",
    out = "rendered/backend-approaches.svg",
)

docs_filegroup(
    name = "docs_assets",
    srcs = [":backend_approaches"],
    prefix = "content/docs/projects/anki_as_code/assets",
)

mermaid_site_webp(
    name = "backend_approaches_preview",
    src = "backend-approaches.mmd",
    out = "rendered/backend-approaches.webp",
    aspect_ratio = [],
    color_scheme = "dark",
    tags = ["manual"],
)
