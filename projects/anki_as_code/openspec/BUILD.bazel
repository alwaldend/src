load("@rules_openspec//main/bzl:workspace.bzl", "openspec_workspace")

openspec_workspace(
    name = "source",
    srcs = ["config.yaml"] + glob(
        [
            "specs/**/*.md",
            "changes/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//infra/src/openspec/validation"],
)
