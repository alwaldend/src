load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_java//java:defs.bzl", "java_library", "java_proto_library")

package(transitive_visibility = "//projects:transitive_consumers")

proto_library(
    name = "ankiascodepb_proto",
    srcs = ["ankiascode.proto"],
    visibility = ["//projects/anki_as_code:__subpackages__"],
    deps = ["//third_party/com_github_ankitects_anki:protos"],
)

go_proto_library(
    name = "ankiascodepb_go_proto",
    importpath = "git.alwaldend.com/alwaldend/src/projects/anki_as_code/api/ankiascodepb",
    proto = ":ankiascodepb_proto",
    visibility = ["//projects/anki_as_code:__subpackages__"],
    deps = [
        "//third_party/com_github_ankitects_anki:decks",
        "//third_party/com_github_ankitects_anki:notes",
        "//third_party/com_github_ankitects_anki:notetypes",
    ],
)

go_library(
    name = "ankiascodepb",
    srcs = ["doc.go"],
    embed = [":ankiascodepb_go_proto"],
    importpath = "git.alwaldend.com/alwaldend/src/projects/anki_as_code/api/ankiascodepb",
    visibility = ["//visibility:public"],
)

java_proto_library(
    name = "ankiascodepb_java_proto",
    deps = [":ankiascodepb_proto"],
)

java_library(
    name = "ankiascodepb_java_library",
    visibility = ["//:__subpackages__"],
    exports = [":ankiascodepb_java_proto"],
)

py_proto_library(
    name = "ankiascodepb_py_pb2",
    visibility = ["//:__subpackages__"],
    deps = [":ankiascodepb_proto"],
)
