load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ankiascode",
    srcs = [
        "app.go",
        "doc.go",
        "files.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/projects/anki_as_code/pkg/ankiascode",
    visibility = ["//visibility:public"],
    deps = [
        "//projects/anki_as_code/api/ankiascodeapi",
        "//projects/anki_as_code/api/ankiascodepb",
        "//projects/anki_as_code/internal/collection",
        "//projects/anki_as_code/internal/config",
        "//projects/anki_as_code/internal/export",
        "//projects/anki_as_code/internal/plan",
        "//projects/anki_as_code/internal/rebuild",
        "//projects/anki_as_code/internal/reconcile",
        "//projects/anki_as_code/internal/resource",
        "//projects/anki_as_code/internal/rpc",
        "//projects/anki_as_code/internal/state",
        "//projects/anki_grpc/pkg/ankigrpc",
        "@org_golang_google_grpc//:grpc",
    ],
)

[
    go_test(
        name = name,
        size = "large" if name == "wasm_workflow_test" else "medium",
        srcs = [
            "backend_workflow_test.go",
            "collection_build_test.go",
            "collection_test.go",
            "discovery_test.go",
            "export_workflow_test.go",
            "fixture_test.go",
            "identity_test.go",
            "large_collection_test.go",
            "main_test.go",
            "notetype_workflow_test.go",
            "source_workflow_test.go",
            "state_test.go",
            "workflow_test.go",
        ],
        data = [cli] + ([] if cli == "//projects/anki_as_code/cmd/anki_as_code:native" else ["//projects/anki_as_code/cmd/anki_as_code:native"]),
        embed = [":ankiascode"],
        env = {
            "ANKI_CLI": "$(rootpath {})".format(cli),
            "NATIVE_ANKI_CLI": "$(rootpath //projects/anki_as_code/cmd/anki_as_code:native)" if name == "wasm_workflow_test" else "",
        },
        deps = [
            "//projects/anki_as_code/api/ankiascodeapi",
            "//projects/anki_as_code/api/ankiascodepb",
            "//projects/anki_as_code/internal/codec",
            "//projects/anki_as_code/internal/collection",
            "//projects/anki_as_code/internal/config",
            "//projects/anki_as_code/internal/resource",
            "//projects/anki_as_code/internal/state",
            "//projects/anki_as_code/test/wasmcache",
            "//projects/anki_grpc/pkg/ankiclient",
            "//projects/anki_grpc/pkg/ankigrpc",
            "//projects/anki_grpc/pkg/ankigrpc/native",
            "//third_party/com_github_ankitects_anki:cards",
            "//third_party/com_github_ankitects_anki:collection",
            "//third_party/com_github_ankitects_anki:config",
            "//third_party/com_github_ankitects_anki:deck_config",
            "//third_party/com_github_ankitects_anki:decks",
            "//third_party/com_github_ankitects_anki:generic",
            "//third_party/com_github_ankitects_anki:import_export",
            "//third_party/com_github_ankitects_anki:media",
            "//third_party/com_github_ankitects_anki:notes",
            "//third_party/com_github_ankitects_anki:notetypes",
            "//third_party/com_github_ankitects_anki:scheduler",
            "//third_party/com_github_ankitects_anki:search",
            "//third_party/com_github_ankitects_anki:stats",
            "@com_github_burntsushi_toml//:toml",
            "@org_golang_google_grpc//:grpc",
            "@org_golang_google_protobuf//encoding/protojson",
            "@org_golang_google_protobuf//proto",
        ],
    )
    for name, cli in [
        ("ankiascode_test", "//projects/anki_as_code/cmd/anki_as_code:native"),
        ("wasm_workflow_test", "//projects/anki_as_code/cmd/anki_as_code:wasm"),
    ]
]
