flowchart TB
    subgraph Export["config.Store.Export"]
        direction TB
        e_start((Start))
        e_root(Write root config)
        e_more{More declarations?}
        e_encode(Next declaration:<br/>ProtoJSON → TOML)
        e_write(Write supplied relative path)
        e_finish(((End)))

        e_start --> e_root --> e_more
        e_more -->|Yes| e_encode --> e_write --> e_more
        e_more -->|No| e_finish
    end

    subgraph Dump["config.Store.Dump"]
        direction TB
        d_start((Start))
        d_load[[Store.Load]]
        d_json(Encode complete set<br/>using ProtoJSON)
        d_format{Output format}
        d_pretty(Indent JSON and add newline)
        d_toml(JSON values → TOML)
        d_output(Return bytes)
        d_finish(((End)))

        d_start --> d_load --> d_json --> d_format
        d_format -->|JSON: default| d_pretty --> d_output
        d_format -->|TOML| d_toml --> d_output
        d_output --> d_finish
    end

    subgraph Load["config.Store.Load"]
        direction TB
        l_start((Start))
        l_root(Resolve stored root path)
        l_declarations(Load root and declarations:<br/>note_types/, notes/, nested decks/)
        l_decode(Each file: TOML values → JSON<br/>→ protobuf via the schema)
        l_derived(Record paths and deck titles;<br/>inherit omitted card deck paths)
        l_output(Return CollectionConfigSet)
        l_finish(((End)))

        l_start --> l_root --> l_declarations --> l_decode --> l_derived --> l_output --> l_finish
    end
