flowchart LR
    subgraph application["anki_as_code"]
        app["ankiascode.App"]
        build["plan.Build"]

        app --->|"Configs, snapshot,<br/>state"| build

        subgraph prepare["Prepare"]
            entry(( ))
            collections["collection.Store"]
            configs["config.Store"]
            resources["resource.Store"]
            states["state.Store"]

            entry -->|"Get collection<br/>connection"| collections
            entry -->|Load| configs
            entry -->|Snapshot| resources
            entry -->|Dump| states
        end

        app --> entry
    end

    result["CollectionPlan<br/>Operations + report"]
    connection["anki_grpc<br/>connection"]
    files["Configs<br/>TOML files"]

    subgraph storage["Anki storage"]
        storedResources["Resources"]
        storedState["State"]
    end

    build --> result
    collections -.->|"Open / close"| connection
    configs --> files
    resources -->|gRPC| connection
    states -->|gRPC| connection
    connection --> storage
