load("@aspect_bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")

package(transitive_visibility = "//projects:transitive_consumers")

run_binary(
    name = "cli_reference",
    args = ["--output=$@"],
    out_dirs = ["cli"],
    tool = "//projects/anki_as_code/tools/generate_cli_docs",
)

docs_filegroup(
    name = "docs",
    srcs = [":cli_reference"],
    visibility = ["//projects/anki_as_code:__pkg__"],
)

mermaid_diagram(
    name = "architecture",
    src = "architecture.mmd",
    out = "rendered/architecture",
    webp_aspect_ratio = [],
    webp_scale = 2,
)

docs_filegroup(
    name = "assets",
    srcs = [
        ":architecture_svg",
        ":backend_strategies_svg",
        ":config_operations_svg",
        ":config_references_svg",
        ":export_svg",
        ":mcp_svg",
        ":package_dependencies_svg",
        ":planning_svg",
        ":state_store_svg",
    ],
    prefix = "content/docs/projects/anki_as_code/assets",
    visibility = ["//projects/anki_as_code:__pkg__"],
)

mermaid_diagram(
    name = "mcp",
