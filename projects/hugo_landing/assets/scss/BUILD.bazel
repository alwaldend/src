load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")

pkg_filegroup(
    name = "assets",
    srcs = [":assets_files"],
    prefix = "assets/scss",
    visibility = ["//projects:__subpackages__"],
)

# The apex site renders the same canvas as the landing sites but is built from
# its own source archive, so it consumes this shared style file rather than
# keeping a second copy of the rules.
pkg_files(
    name = "shared_theme",
    srcs = ["_shared_theme.scss"],
    strip_prefix = strip_prefix.files_only(),
    visibility = ["//projects/alwaldend.com/assets:__pkg__"],
)

pkg_files(
    name = "assets_files",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "README.md",
        ],
    ),
    strip_prefix = strip_prefix.from_pkg(),
)

docs_filegroup(
    name = "docs",
    srcs = glob(
        ["*.md"],
        allow_empty = True,
    ),
    visibility = ["//projects:__subpackages__"],
)
