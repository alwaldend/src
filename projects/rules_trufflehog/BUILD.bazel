load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")
load(":defs.bzl", "trufflehog_test")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
)

stardoc(
    name = "reference",
    out = "reference.md",
    input = "defs.bzl",
    deps = [":defs"],
)

build_test(
    name = "build_test",
    targets = [
        ":defs",
        "//cmd/scan:scan",
    ],
)

trufflehog_test(
    name = "rule_test",
    allowlist = "test/fixture_allowlist.json",
    git = "//test/fixture_scanner:scanner",
    repository_marker = "README.md",
    scanner = "//test/fixture_scanner:scanner",
)

docs_filegroup(
    name = "docs",
    srcs = [
        "README.md",
        ":reference",
    ],
    prefix = "content/docs/projects/rules_trufflehog",
    visibility = ["//visibility:public"],
    deps = ["//test/e2e:docs"],
)
