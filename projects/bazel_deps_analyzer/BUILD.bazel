load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

alias(
    name = "bazel_deps_analyzer",
    actual = "//projects/bazel_deps_analyzer/cmd/bazel_deps_analyzer",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects:__pkg__"],
    deps = [
        "//projects/bazel_deps_analyzer/docs",
        "//projects/bazel_deps_analyzer/openspec:docs",
    ],
)
