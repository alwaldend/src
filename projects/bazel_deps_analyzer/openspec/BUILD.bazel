load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_openspec//rules:openspec.bzl", "openspec_validation")
load("@rules_openspec//rules:workspace.bzl", "openspec_workspace")

package(transitive_visibility = "//projects:transitive_consumers")

openspec_workspace(
    name = "source",
    srcs = ["config.yaml"] + glob(
        [
            "specs/**/*.md",
            "changes/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//infra/src/openspec/validation"],
)

openspec_validation(
    name = "validate_test",
    source = ":source",
)

docs_filegroup(
    name = "docs",
    srcs = glob(
        [
            "*.md",
            "specs/**/*.md",
        ],
        allow_empty = True,
    ),
    preserve_paths = True,
    visibility = ["//projects/bazel_deps_analyzer:__pkg__"],
)
