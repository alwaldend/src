load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/transitive_visibility:defs.bzl", "artifact_boundary_test")

package(transitive_visibility = "//projects:transitive_consumers")

go_library(
    name = "bazel_deps_analyzer_lib",
    srcs = [
        "doc.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/projects/bazel_deps_analyzer/cmd/bazel_deps_analyzer",
    visibility = ["//visibility:private"],
    deps = [
        "//projects/bazel_deps_analyzer/internal/graph",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "bazel_deps_analyzer",
    embed = [":bazel_deps_analyzer_lib"],
    visibility = ["//projects/bazel_deps_analyzer:__subpackages__"],
)

artifact_boundary_test(
    name = "artifact_boundary_test",
    target = ":bazel_deps_analyzer",
)
