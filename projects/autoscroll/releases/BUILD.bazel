load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/release/main/bzl:al_release.bzl", "al_release")
load("//tools/release/main/bzl:al_release_files.bzl", "al_release_files")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/autoscroll:__pkg__"],
    deps = [
        ":head",
    ],
)

al_release_files(
    name = "files",
    srcs = [
        "//projects/autoscroll",
    ],
    deployments = ["//tools/release:deployment"],
)

al_release(
    name = "head",
    srcs = [
        ":files",
    ],
    project = "projects/autoscroll",
    release_name = "head",
    visibility = ["//projects:__pkg__"],
)
