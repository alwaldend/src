# gazelle:ignore

load("@rules_python//python:defs.bzl", "py_test")

package(transitive_visibility = "//projects:transitive_consumers")

py_test(
    name = "plugin_test",
    srcs = ["plugin_test.py"],
    tags = ["requires-network"],
    deps = [
        "//projects/mlflow_vastai_backend:plugin",
        "@com_alwaldend_src_projects_mlflow_vastai_backend_pip//grpcio",
        "@com_alwaldend_src_projects_mlflow_vastai_backend_pip//mlflow",
    ],
)

py_test(
    name = "worker_test",
    size = "medium",
    srcs = ["worker_test.py"],
    args = [
        "$(rootpath //projects/mlflow_vastai_backend/cmd/mlflow-vastai)",
        "$(rootpath //projects/mlflow_vastai_backend:mlflow)",
    ],
    data = [
        "//projects/mlflow_vastai_backend:mlflow",
        "//projects/mlflow_vastai_backend/cmd/mlflow-vastai",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//projects/mlflow_vastai_backend:plugin",
        "@com_alwaldend_src_projects_mlflow_vastai_backend_pip//mlflow",
    ],
)

py_test(
    name = "server_test",
    size = "medium",
    srcs = ["server_test.py"],
    args = ["$(rootpath //projects/mlflow_vastai_backend/cmd/mlflow-vastai)"],
    data = ["//projects/mlflow_vastai_backend/cmd/mlflow-vastai"],
    tags = ["requires-network"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//projects/mlflow_vastai_backend:plugin",
        "@com_alwaldend_src_projects_mlflow_vastai_backend_pip//grpcio",
    ],
)
