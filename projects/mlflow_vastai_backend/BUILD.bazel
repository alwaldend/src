load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("@rules_python//python/uv:lock.bzl", "lock")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

_DISTRIBUTION = "mlflow_vastai_backend"

_VERSION = "0.0.0"

py_wheel(
    name = "plugin_wheel",
    distribution = _DISTRIBUTION,
    entry_points = {
        "mlflow.project_backend": ["vastai = mlflow_vastai_backend:VastAIBackend"],
    },
    python_requires = ">=3.14,<3.15",
    python_tag = "py3",
    requires = [
        "grpcio>=1.85.3",
        "mlflow>=3.18,<3.19",
        "protobuf>=6.33.4",
        "pydantic>=2.14.4,<3",
    ],
    strip_path_prefixes = [
        "projects/mlflow_vastai_backend/pkg/",
        "projects/mlflow_vastai_backend/api/jobpb/",
    ],
    version = _VERSION,
    visibility = ["//projects/mlflow_vastai_backend:__subpackages__"],
    deps = [
        "//projects/mlflow_vastai_backend/api/jobpb:job_py_sources",
        "//projects/mlflow_vastai_backend/pkg:plugin_sources",
    ],
)

py_library(
    name = "plugin",
    data = [":plugin_wheel"],
    imports = ["{}-{}-py3-none-any.whl".format(_DISTRIBUTION, _VERSION)],
    visibility = ["//projects/mlflow_vastai_backend:__subpackages__"],
    deps = [
        "@com_alwaldend_src_projects_mlflow_vastai_backend_pip//grpcio",
        "@com_alwaldend_src_projects_mlflow_vastai_backend_pip//mlflow",
        "@com_alwaldend_src_projects_mlflow_vastai_backend_pip//protobuf",
        "@com_alwaldend_src_projects_mlflow_vastai_backend_pip//pydantic",
    ],
)

py_console_script_binary(
    name = "mlflow",
    pkg = "@com_alwaldend_src_projects_mlflow_vastai_backend_pip//mlflow:pkg",
    visibility = ["//projects/mlflow_vastai_backend/test/e2e:__pkg__"],
    deps = [":plugin"],
)

lock(
    name = "uv_lock",
    srcs = ["pyproject.toml"],
    out = "uv.lock",
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects:__pkg__"],
    deps = ["docs"],
)
