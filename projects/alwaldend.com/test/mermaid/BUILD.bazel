load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg")

package(transitive_visibility = "//projects:transitive_consumers")

mermaid_site_svg(
    name = "edge_semantics",
    testonly = True,
    src = "edge_semantics.mmd",
    out = "rendered/edge_semantics.svg",
    visibility = ["//visibility:private"],
)

js_test(
    name = "readability_test",
    size = "medium",
    args = [
        "$(rootpath @com_google_chrome_headless_shell//:chrome_headless_shell_binary)",
        "$(rootpaths //projects/alwaldend.com/docs/mermaid-theme:samples)",
        "$(rootpaths :edge_semantics)",
    ],
    data = [
        ":edge_semantics",
        "//projects/alwaldend.com/docs/mermaid-theme:samples",
        "//tools:node_modules/puppeteer",
        "@com_google_chrome_headless_shell//:chrome_headless_shell_binary",
    ],
    entry_point = "readability_test.mjs",
    visibility = ["//visibility:private"],
)

js_test(
    name = "mermaid_test",
    size = "medium",
    args = [
        "$(rootpath //projects/alwaldend.com:site)",
        "$(rootpath @com_google_chrome_headless_shell//:chrome_headless_shell_binary)",
    ],
    data = [
        "//projects/alwaldend.com:site",
        "//tools:node_modules/puppeteer",
        "@com_google_chrome_headless_shell//:chrome_headless_shell_binary",
    ],
    entry_point = "mermaid_test.mjs",
)
