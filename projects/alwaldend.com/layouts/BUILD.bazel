load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

pkg_filegroup(
    name = "layouts",
    srcs = [":layouts_files"],
    prefix = "layouts",
    visibility = ["//:__subpackages__"],
)

pkg_files(
    name = "layouts_files",
    srcs = glob(["*/**"]),
    strip_prefix = strip_prefix.from_pkg(),
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/alwaldend.com:__pkg__"],
)
