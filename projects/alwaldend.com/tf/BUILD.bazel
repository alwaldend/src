load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map", "al_terraform_target_binary_map", "al_terraform_test_map")

package(transitive_visibility = "//projects:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/alwaldend.com:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

genrule(
    name = "update_pve_disk",
    srcs = ["//projects/alwaldend.com/cmd/server:ops"],
    outs = ["update_pve_disk.sh"],
    cmd = """
target=/var/lib/vz/template/iso/alwaldend.com-server.iso
src=$(execpath //projects/alwaldend.com/cmd/server:ops)
pve=host1.pve1.dc1.alwaldend.com
cat - >$(@) <<EOF
#!/usr/bin/env sh
set -eu
scp "$${src}" "$${pve}:$${target}"
ssh "$${pve}" chmod 600 "$${target}"
for vmid in 900; do
    ssh "$${pve}" -- "
        sudo qm stop '\\$${vmid}'
        sudo qm set '\\$${vmid}' --scsi0 'local-lvm:0,import-from=$${target}'
        sudo qm start '\\$${vmid}'
    "
done
EOF
chmod u+x $(@)
""",
    executable = True,
)

_PROVIDERS = [
    "@terraform_provider_cloudflare_cloudflare//:provider",
    "@terraform_provider_telmate_proxmox//:provider",
]

_CONFIGS = ["//projects/alwaldend.com:al"]

_PLUGIN_LABELS = {"tf": "main"}

_DATA = glob(["*.tf"]) + [
    "//projects/alwaldend.com:dnsconfig",
    "//projects/tf_modules/dns_records/global:global",
]

al_terraform_binary_map(
    name = "tf",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = _PLUGIN_LABELS,
    providers = _PROVIDERS,
)

al_terraform_target_binary_map(
    name = "dns",
    configs = _CONFIGS,
    data = _DATA,
    plugin_labels = {"dns": "1"},
    providers = _PROVIDERS,
    target = "module.dns",
)

al_terraform_test_map(
    name = "tf_tests",
    configs = _CONFIGS,
    data = _DATA,
    providers = _PROVIDERS,
)
