load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

pkg_filegroup(
    name = "i18n",
    srcs = [":i18n_files"],
    prefix = "i18n",
    visibility = ["//:__subpackages__"],
)

pkg_files(
    name = "i18n_files",
    srcs = glob(["*.toml"]),
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/alwaldend.com:__pkg__"],
)
