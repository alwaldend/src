load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/drawio:defs.bzl", "drawio_svg")

package(transitive_visibility = "//projects:transitive_consumers")

_DIAGRAMS = [diagram.replace(".drawio", "") for diagram in glob(["*.drawio"])]

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]) + [":{}.gen_svg".format(diagram) for diagram in _DIAGRAMS],
    prefix = "content/docs/misc/old_diagrams",
    visibility = ["//projects/alwaldend.com/content/docs/misc:__pkg__"],
)

[
    drawio_svg(
        name = "{}.gen_svg".format(diagram),
        src = "{}.drawio".format(diagram),
        pages = {"Page-1": "{}.svg".format(diagram)},
    )
    for diagram in _DIAGRAMS
]
