load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    prefix = "content",
    visibility = ["//projects/alwaldend.com:__pkg__"],
    deps = [
        "//projects/alwaldend.com/content/blog:docs",
        "//projects/alwaldend.com/content/docs",
        "//projects/alwaldend.com/content/projects:docs",
    ],
)
