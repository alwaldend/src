load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects:projects.bzl", "PROJECTS", "PROJECT_MODULES")

package(transitive_visibility = "//projects:transitive_consumers")

# Landing membership comes from the project registry so a project is declared
# once; each project owns its own landing content package.
docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    prefix = "content/projects",
    visibility = ["//projects/alwaldend.com/content:__pkg__"],
    deps = [
        "@{}//site/content:docs".format(PROJECT_MODULES[project]) if project in PROJECT_MODULES else "//projects/{}/site/content:docs".format(project)
        for project in PROJECTS
    ],
)
