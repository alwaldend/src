load("@rules_docs//docs:defs.bzl", "docs_filegroup")

# Each post is its own package so the post bundle and its resources are
# independently owned; the section index lives in this package.
docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    prefix = "content/blog",
    visibility = ["//projects/alwaldend.com/content:__pkg__"],
    deps = [
        "//{}/{}:docs".format(
            package_name(),
            subpackage,
        )
        for subpackage in subpackages(
            include = ["*"],
            allow_empty = True,
        )
    ],
)

# The uploader's end-to-end checks read the real posts and their images from the
# build graph. This exposes the same bundle under a target scoped to that
# consumer instead of widening the docs target's visibility.
filegroup(
    name = "test_data",
    srcs = [":docs"],
    visibility = ["//projects/x_article_uploader/test/e2e:__pkg__"],
)
