# gazelle:exclude site.go

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_hugo//pkg/bzl:al_hugo_binary.bzl", "al_hugo_binary")
load("@rules_pkg//pkg:mappings.bzl", "REMOVE_BASE_DIRECTORY", "pkg_filegroup", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//projects/al/rules/al:al_config.bzl", "al_config")
load("//projects/alwaldend.com/internal/content:prepare.bzl", "prepare_content")
load("//projects/alwaldend.com/internal/search:defs.bzl", "indexed_hugo_site")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg", "mermaid_site_webp")
load("//projects/bazel_deps_analyzer:defs.bzl", "bazel_deps_mermaid", "bazel_deps_mermaid_from_json")
load("//tools/http_server/rules:al_http_server_binary.bzl", "al_http_server_binary")
load("//tools/pkg/rules:al_pkg_rename_files.bzl", "al_pkg_rename_files")
load("//tools/release/rules:al_release_bundle.bzl", "al_release_bundle")
load("//tools/toml/rules:al_toml_data.bzl", "al_toml_data")
load("//tools/vault:defs.bzl", "vault_binary_map")

package(transitive_visibility = "//projects:transitive_consumers")

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

al_config(
    name = "al",
    srcs = ["al.lua"],
    visibility = ["//projects/alwaldend.com:__subpackages__"],
    deps = ["//infra:al"],
)

go_library(
    name = "site_lib",
    srcs = ["site.go"],
    embedsrcs = [
        ":site_archive",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/projects/alwaldend.com",
    visibility = ["//:__subpackages__"],
)

build_test(
    name = "site_test",
    targets = [
        ":site",
    ],
)

# Keep these artifacts outside :site's inputs to avoid a genquery scope cycle.
bazel_deps_mermaid(
    name = "deps_mermaid",
    out = "dependencies.mmd",
    depth = 8,
    target = ":site",
)

mermaid_site_svg(
    name = "deps_svg",
    src = ":deps_mermaid",
    out = "dependencies.svg",
)

mermaid_site_webp(
    name = "deps_webp",
    src = ":deps_mermaid",
    out = "dependencies.webp",
    aspect_ratio = [],
    scale = 2,
)

mermaid_site_webp(
    name = "deps_dark_webp",
    src = ":deps_mermaid",
    out = "dependencies.dark.webp",
    aspect_ratio = [],
    color_scheme = "dark",
    scale = 2,
)

bazel_deps_mermaid_from_json(
    name = "deps_mindmap",
    src = ":deps_mermaid.query.ndjson",
    out = "dependencies.mindmap.mmd",
    depth = 8,
    diagram_type = "mindmap",
    group_by_package = True,
    root = "//projects/alwaldend.com:site",
)

mermaid_site_svg(
    name = "deps_mindmap_svg",
    src = ":deps_mindmap",
    out = "dependencies.mindmap.svg",
)

mermaid_site_webp(
    name = "deps_mindmap_dark_webp",
    src = ":deps_mindmap",
    out = "dependencies.mindmap.dark.webp",
    aspect_ratio = [],
    color_scheme = "dark",
)

_BUILD_FLAGS = [
    "build",
    "--logLevel",
    "debug",
    "--panicOnWarning",
    "--buildExpired",
    "--buildFuture",
    "--printI18nWarnings",
    "--printPathWarnings",
    # "--printUnusedTemplates", /404.html is unused
]

# Local builds render drafts so an author can inspect work in progress. The
# release build must not, so a post whose front matter still says
# `draft: true` cannot reach the deployed site.
_PREVIEW_FLAGS = [
    "--buildDrafts",
]

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = [
        "//projects:__pkg__",
    ],
    deps = [
        "//projects/alwaldend.com/docs",
        "//projects/alwaldend.com/tf:docs",
    ],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
        "//projects/alwaldend.com:__subpackages__",
    ],
)

al_hugo_binary(
    name = "site_hugo",
    site = ":site_site",
)

indexed_hugo_site(
    name = "site",
    arguments = select({
        "//tools/bazel_configs:release": _BUILD_FLAGS + [
            "--minify",
            "--baseURL",
            "https://alwaldend.com",
        ],
        "//conditions:default": _BUILD_FLAGS + _PREVIEW_FLAGS,
    }),
    source = ":site_source_archive",
    visibility = ["//:__subpackages__"],
)

indexed_hugo_site(
    name = "site_staging",
    arguments = _BUILD_FLAGS + [
        "--baseURL",
        "https://www-staging.alwaldend.com",
    ],
    source = ":site_source_archive",
    visibility = ["//:__subpackages__"],
)

pkg_tar(
    name = "site_archive",
    srcs = [
        ":project_cname",
        ":site",
    ],
)

# Keep the deployable archive outside release documentation: the site renders
# that documentation, so making it depend on this archive would form a cycle.
pkg_files(
    name = "release_content",
    srcs = [":site"],
    renames = {":site": REMOVE_BASE_DIRECTORY},
)

pkg_tar(
    name = "release_archive",
    srcs = [":release_content"],
    out = "website.tar.gz",
    extension = "tar.gz",
    target_compatible_with = select({
        "//tools/bazel_configs:release": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

al_release_bundle(
    name = "release",
    srcs = [":release_archive"],
    project = "projects/alwaldend.com",
    target_compatible_with = select({
        "//tools/bazel_configs:release": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

prepare_content(
    name = "site_source_archive",
    src = ":site_source_raw_archive",
)

pkg_tar(
    name = "site_source_raw_archive",
    srcs = [":site_source_filegroup_renamed"],
    strip_prefix = ".",
)

al_pkg_rename_files(
    name = "site_source_filegroup_renamed",
    src = ":site_source_filegroup",
    basenames = {
        "README.md": "_index.md",
    },
)

pkg_filegroup(
    name = "site_source_filegroup",
    srcs = [
        ":repo_docs",
        ":site_config",
        "//projects/alwaldend.com/assets",
        "//projects/alwaldend.com/content:docs",
        "//projects/alwaldend.com/data",
        "//projects/alwaldend.com/i18n",
        "//projects/alwaldend.com/layouts",
        "@com_alwaldend_src_hugo",
    ],
)

# The deploy wipes the pages branch contents, so the archive must carry the
# CNAME file binding the apex custom domain; without it the next deploy
# unbinds alwaldend.com from GitHub Pages.
write_file(
    name = "project_cname",
    out = "CNAME",
    content = ["alwaldend.com"],
)

sh_binary(
    name = "deploy",
    srcs = ["deploy.sh"],
    args = [
        "$(rootpath :site_archive)",
        "alwaldend/alwaldend.github.io",
        "pages",
    ],
    data = [":site_archive"],
)

# The staging site is the same rendered source with the staging base URL, so
# an evaluation on it exercises the deployed content. Its archive carries the
# staging CNAME because the deploy replaces the published branch contents.
write_file(
    name = "staging_cname_src",
    out = "CNAME.staging",
    content = ["www-staging.alwaldend.com"],
)

pkg_files(
    name = "staging_cname",
    srcs = [":staging_cname_src"],
    renames = {":staging_cname_src": "CNAME"},
)

pkg_tar(
    name = "site_staging_archive",
    srcs = [
        ":site_staging",
        ":staging_cname",
    ],
)

sh_binary(
    name = "deploy_staging",
    srcs = ["deploy.sh"],
    args = [
        "$(rootpath :site_staging_archive)",
        "alwaldend/www-staging",
        "pages",
    ],
    data = [":site_staging_archive"],
)

pkg_filegroup(
    name = "site_filegroup",
    srcs = [":site_files"],
)

pkg_files(
    name = "site_files",
    srcs = [":site"],
    renames = {":site": "src"},
)

al_http_server_binary(
    name = "site_serve",
    srcs = [":site_filegroup"],
    arguments = [
        "--bind",
        "127.0.0.1",
        "--directory",
        "src",
        "1313",
    ],
)

pkg_files(
    name = "site_config",
    srcs = [":site_config_src"],
    renames = {"hugo.toml": "config/_default/hugo.toml"},
)

al_toml_data(
    name = "site_config_src",
    srcs = ["hugo.toml"],
)

# Preserve the repository documentation tree while keeping root package loading
# independent of the documentation rules.
pkg_files(
    name = "repo_docs_empty",
    srcs = [],
    prefix = "content/docs/",
    visibility = ["//:__pkg__"],
)

docs_filegroup(
    name = "repo_docs",
    srcs = [],
    prefix = "content/docs/",
    visibility = ["//:__pkg__"],
    deps = [
        "//data:docs",
        "//infra:docs",
        "//internal:docs",
        "//projects:docs",
        "//third_party:docs",
        "//tools:docs",
        "//users:docs",
    ],
)
