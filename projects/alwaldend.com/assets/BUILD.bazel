load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("@rules_template//main/bzl:template_run_binary.bzl", "template_run_binary")

package(transitive_visibility = "//projects:transitive_consumers")

template_run_binary(
    name = "shared_theme_variables",
    srcs = ["scss/_shared_accent.scss.tmpl"],
    outs = ["_shared_accent.scss"],
    data = ["//data/alwaldend:assets/theme.json"],
)

# Site-specific Docsy styling maps shared identity data to the home page
# and project landings through one generated Sass projection.
pkg_filegroup(
    name = "assets",
    srcs = [
        ":assets_files",
    ],
    prefix = "assets",
    visibility = ["//projects/alwaldend.com:__pkg__"],
)

pkg_files(
    name = "assets_files",
    srcs = glob(
        ["**"],
        exclude = [
            "README.md",
            "BUILD.bazel",
            "**/*.tmpl",
        ],
    ) + [
        ":shared_theme_variables",
        "//data/alwaldend:monogram",
    ],
    renames = {
        ":shared_theme_variables": "scss/_shared_accent.scss",
        "//data/alwaldend:monogram": "icons/favicon.svg",
    },
    strip_prefix = strip_prefix.from_pkg(),
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/alwaldend.com:__pkg__"],
)
