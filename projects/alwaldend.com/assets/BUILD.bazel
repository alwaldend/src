load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("@rules_template//rules:template_run_binary.bzl", "template_run_binary")
load(":defs.bzl", "site_stylesheet")

package(transitive_visibility = "//projects:transitive_consumers")

exports_files(["scss/application.scss"])

filegroup(
    name = "application_theme_sources",
    srcs = [
        "scss/_shared_controls.scss",
        "scss/_shared_palette.scss",
        ":shared_theme_variables",
    ],
    visibility = [
        "//projects:__subpackages__",
        "//tools/code_screenshot:__pkg__",
    ],
)

template_run_binary(
    name = "shared_theme_variables",
    srcs = ["scss/_shared_accent.scss.tmpl"],
    outs = ["scss/_shared_accent.scss"],
    data = ["//data/alwaldend:assets/theme.json"],
)

# Preserve the site palette API for spatial rendering consumers.
site_stylesheet(
    name = "mermaid_palette",
    src = "scss/mermaid.scss",
    out = "mermaid-palette.css",
    visibility = ["//:__subpackages__"],
    deps = [":shared_theme_variables"],
)

# The shared Docsy canvas and accent live in this site's own assets tree now
# that the reusable landing project is retired, so both the home page and the
# project landings render one palette from one implementation.
pkg_filegroup(
    name = "assets",
    srcs = [
        ":assets_files",
    ],
    prefix = "assets",
    visibility = ["//projects/alwaldend.com:__pkg__"],
)

pkg_files(
    name = "assets_files",
    srcs = glob(
        ["**"],
        exclude = [
            "README.md",
            "BUILD.bazel",
            "defs.bzl",
            "**/*.tmpl",
        ],
    ) + [
        ":shared_theme_variables",
        "//data/alwaldend:monogram",
    ],
    renames = {
        ":shared_theme_variables": "scss/_shared_accent.scss",
        "//data/alwaldend:monogram": "icons/favicon.svg",
    },
    strip_prefix = strip_prefix.from_pkg(),
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/alwaldend.com:__pkg__"],
)
