load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

pkg_filegroup(
    name = "assets",
    srcs = [
        ":assets_files",
        ":navbar_logo",
        ":theme_stylesheets",
    ],
    prefix = "assets",
    visibility = ["//projects/alwaldend.com:__pkg__"],
)

pkg_files(
    name = "theme_stylesheets",
    srcs = ["//internal/assets/web:hugo_stylesheets"],
    prefix = "scss",
    strip_prefix = strip_prefix.from_root("internal/assets/web"),
)

pkg_files(
    name = "navbar_logo",
    srcs = ["//internal/assets:monogram"],
    renames = {"//internal/assets:monogram": "icons/logo.svg"},
)

pkg_files(
    name = "assets_files",
    srcs = glob(
        ["**"],
        exclude = [
            "README.md",
            "BUILD.bazel",
            "**/*.tmpl",
        ],
    ) + ["//internal/assets:monogram"],
    renames = {"//internal/assets:monogram": "icons/favicon.svg"},
    strip_prefix = strip_prefix.from_pkg(),
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/alwaldend.com:__pkg__"],
)
