load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_diagram")

package(transitive_visibility = "//projects:transitive_consumers")

mermaid_diagram(
    name = "legacy_www",
    src = "legacy-www.mmd",
    out = "rendered/legacy-www",
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.mmd"]),
    visibility = ["//projects/alwaldend.com:__pkg__"],
    deps = [
        ":docs_assets",
        "//projects/alwaldend.com/docs/mermaid-theme:docs",
    ],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":legacy_www_svg",
    ],
    prefix = "content/docs/projects/alwaldend.com/docs/assets",
)
