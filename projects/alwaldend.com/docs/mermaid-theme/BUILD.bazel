load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg")

package(transitive_visibility = "//projects:transitive_consumers")

_SAMPLES = [
    "class",
    "entity-relationship",
    "flowchart",
    "mindmap",
    "sequence",
    "state",
]

exports_files(
    [sample + ".mmd" for sample in _SAMPLES],
    visibility = ["//projects/mermaid_3d/samples:__pkg__"],
)

[
    mermaid_site_svg(
        name = sample,
        src = sample + ".mmd",
        out = "rendered/" + sample + ".svg",
    )
    for sample in _SAMPLES
]

filegroup(
    name = "samples",
    srcs = [":" + sample for sample in _SAMPLES],
    visibility = ["//projects/alwaldend.com/test/mermaid:__pkg__"],
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":samples",
        "//projects/mermaid_3d/samples:snapshots",
    ],
    prefix = "content/docs/projects/alwaldend.com/docs/mermaid-theme/assets",
)

docs_filegroup(
    name = "docs",
    srcs = glob([
        "*.md",
        "*.mmd",
    ]),
    visibility = ["//projects/alwaldend.com/docs:__pkg__"],
    deps = [
        ":docs_assets",
        ":spatial_assets",
    ],
)

docs_filegroup(
    name = "spatial_assets",
    srcs = ["//projects/mermaid_3d/samples:html"],
    prefix = "static/docs/projects/alwaldend.com/docs/mermaid-theme/assets",
)
