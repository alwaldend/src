        Package["Assemble scene payload<br/>Package HTML assets"]

        Read ~~~ Layout
        Layout --> Route
        Route --> Package
    end

    Read -->|"Puppeteer calls"| Setup
    Measure -->|"graph + font metrics"| Layout
    Package --> HTML[/"HTML<br/>Viewer + embedded assets"/]
    Package -. optional .-> JSON[/"JSON<br/>Scene + metadata"/]
