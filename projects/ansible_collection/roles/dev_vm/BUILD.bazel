load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/ansible/rules:al_ansible_role.bzl", "al_ansible_role")

package(transitive_visibility = "//projects:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/ansible_collection/roles:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ) + [":role.docs"],
)

al_ansible_role(
    name = "role",
    srcs = glob(["**"]) + [
        "@com_github_bazelbuild_bazelisk_linux_x86_64//:bazelisk_filegroup",
        "@rules_al//:al",
    ],
    renames = {
        "@rules_al//:al": "files/al",
        "@com_github_bazelbuild_bazelisk_linux_x86_64//:bazelisk_filegroup": "files/bazelisk",
    },
    visibility = ["//:__subpackages__"],
)
