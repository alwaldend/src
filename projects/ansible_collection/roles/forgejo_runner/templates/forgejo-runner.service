[Unit]
Description=Forgejo Actions runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ forgejo_runner_user }}
Group={{ forgejo_runner_user }}
WorkingDirectory={{ forgejo_runner_dir }}/work
Environment=HOME={{ forgejo_runner_dir }}/home
Environment=PATH={{ forgejo_runner_dir }}/home/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart={{ forgejo_runner_dir }}/forgejo-runner --config {{ forgejo_runner_dir }}/config.yaml daemon
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=5s
TimeoutStopSec={{ forgejo_runner_service_stop_timeout }}

[Install]
WantedBy=multi-user.target
