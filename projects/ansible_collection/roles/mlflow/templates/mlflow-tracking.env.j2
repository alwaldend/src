AUTH_PROVIDERS_FILE=/etc/mlflow-oidc-providers.json
OIDC_CLIENT_SECRET={{ lookup('ansible.builtin.file', mlflow_oidc_client_secret_src) | to_json }}
OIDC_USERS_DB_URI=sqlite:////var/lib/mlflow-tracking/auth.db
OIDC_REDIRECT_URI={{ mlflow_tracking_uri }}/callback
OIDC_SCOPE="openid email groups"
OIDC_GROUP_NAME={{ mlflow_oidc_groups | join(",") }}
OIDC_ADMIN_GROUP_NAME={{ mlflow_oidc_admin_groups | join(",") }}
TRUSTED_PROXIES=127.0.0.1
SESSION_COOKIE_SECURE=true
SECRET_KEY={{ lookup('ansible.builtin.file', mlflow_oidc_session_key_src) }}
