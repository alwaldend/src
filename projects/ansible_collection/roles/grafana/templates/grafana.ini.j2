[server]
http_addr = 127.0.0.1
http_port = {{ grafana_http_port }}
domain = {{ grafana_hostname }}
enforce_domain = true
root_url = https://{{ grafana_hostname }}/

[database]
type = sqlite3

[security]
admin_password = $__file{/etc/grafana/admin-password}
secret_key = $__file{/etc/grafana/secret-key}
cookie_secure = true

[users]
allow_sign_up = false

[auth.anonymous]
enabled = false

[auth.generic_oauth]
enabled = true
name = {{ grafana_oidc_name }}
allow_sign_up = true
client_id = {{ grafana_oidc_client_id }}
client_secret = $__file{/etc/grafana/oidc-client-secret}
scopes = {{ grafana_oidc_scopes }}
auth_url = {{ grafana_oidc_auth_url }}
token_url = {{ grafana_oidc_token_url }}
api_url = {{ grafana_oidc_userinfo_url }}
login_attribute_path = {{ grafana_oidc_login_attribute }}
groups_attribute_path = groups
allowed_groups = {{ grafana_oidc_admin_group }}
role_attribute_path = "'GrafanaAdmin'"
role_attribute_strict = true
allow_assign_grafana_admin = true
use_pkce = true

{% if grafana_feature_toggles %}
[feature_toggles]
enable = {{ grafana_feature_toggles | join(' ') }}
{% endif %}
