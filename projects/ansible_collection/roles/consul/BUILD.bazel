load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/ansible/main/bzl:al_ansible_role.bzl", "al_ansible_role")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/ansible_collection/roles:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ) + [":role.docs"],
)

al_ansible_role(
    name = "role",
    srcs = glob(["**"]) + [
        "//data/ssl/alwaldend.com:ica_servers",
        "@com_hashicorp_consul_linux_x86_64//:consul_filegroup",
        "@com_hashicorp_vault_linux_x86_64//:vault_filegroup",
    ],
    renames = {
        "@com_hashicorp_consul_linux_x86_64//:consul_filegroup": "files/consul",
        "@com_hashicorp_vault_linux_x86_64//:vault_filegroup": "files/vault",
        "//data/ssl/alwaldend.com:ica_servers": "files/pki_ca_servers.crt",
    },
    visibility = ["//:__subpackages__"],
)
