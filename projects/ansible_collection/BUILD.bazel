load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]) + ["galaxy.yml"],
    visibility = [
        "//projects:__pkg__",
        "//projects/ansible_collection/landing:__pkg__",
    ],
    deps = [
        "//projects/ansible_collection/playbooks:docs",
        "//projects/ansible_collection/roles:docs",
    ],
)

pkg_files(
    name = "galaxy",
    srcs = [":galaxy.yml"],
)

pkg_filegroup(
    name = "collection",
    srcs = [
        ":galaxy",
        "//projects/ansible_collection/playbooks",
        "//projects/ansible_collection/roles",
    ],
    prefix = "alwaldend/main",
    visibility = ["//:__subpackages__"],
)

pkg_filegroup(
    name = "collection_prefix",
    srcs = [":collection"],
    prefix = "collections/ansible_collections",
)

pkg_filegroup(
    name = "collections",
    srcs = [
        ":collection_prefix",
        "@com_ansible_galaxy",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
        "//projects/alwaldend.com:__subpackages__",
    ],
)
