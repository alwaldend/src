# Ansible loads these filters from the packaged collection at runtime.
# gazelle:exclude filter

load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")

pkg_files(
    name = "plugins",
    srcs = glob(["**/*.py"]),
    prefix = "plugins",
    strip_prefix = strip_prefix.from_pkg(),
    visibility = ["//projects/ansible_collection:__pkg__"],
)
