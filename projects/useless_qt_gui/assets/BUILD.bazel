load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

filegroup(
    name = "images",
    srcs = glob(["*.png"]),
    visibility = ["//projects/useless_qt_gui:__pkg__"],
)

pkg_files(
    name = "res",
    srcs = glob(["*.png"]),
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/useless_qt_gui:__pkg__"],
)
