load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load(
    "@rules_qt//:qt.bzl",
    "qt_cc_binary",
    "qt_cc_library",
    "qt_resource_via_qrc",
    "qt_ui_library",
)
load("//projects/al/rules/al:al_config.bzl", "al_config")
load("//tools/vault:defs.bzl", "vault_binary_map")

build_test(
    name = "build_test",
    targets = [
        ":useless_qt_gui",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = [
        "//projects:__pkg__",
        "//projects/useless_qt_gui/landing:__pkg__",
    ],
    deps = ["//projects/useless_qt_gui/tf:docs"],
)

qt_resource_via_qrc(
    name = "resources",
    files = ["//projects/useless_qt_gui/main/res:images"],
    qrc_file = "resources.qrc",
)

qt_ui_library(
    name = "mainwindow_ui",
    includes = ["."],
    ui = "mainwindow.ui",
    deps = ["@rules_qt//:qt_widgets"],
)

qt_cc_library(
    name = "application",
    srcs = [
        "main/cpp/mainwindow.cpp",
        "main/cpp/menubutton.cpp",
        "main/cpp/systembutton.cpp",
    ],
    hdrs = [
        "main/cpp/mainwindow.h",
        "main/cpp/menubutton.h",
        "main/cpp/systembutton.h",
    ],
    includes = ["main/cpp"],
    deps = [
        ":mainwindow_ui",
        "@rules_qt//:qt_widgets",
    ],
)

qt_cc_binary(
    name = "useless_qt_gui",
    srcs = ["main/cpp/main.cpp"],
    deps = [
        ":application",
        ":resources",
        "@rules_qt//:qt_widgets",
    ],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
        "//projects/alwaldend.com:__subpackages__",
        "//projects/useless_qt_gui/tf:__pkg__",
    ],
)

al_config(
    name = "al",
    srcs = ["al.lua"],
    visibility = ["//projects/useless_qt_gui/tf:__pkg__"],
    deps = ["//infra:al"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)
