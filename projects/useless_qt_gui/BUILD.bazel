load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load(
    "@rules_qt//:qt.bzl",
    "qt_cc_binary",
    "qt_cc_library",
    "qt_resource_via_qrc",
    "qt_ui_library",
)

package(transitive_visibility = "//projects:transitive_consumers")

build_test(
    name = "build_test",
    targets = [
        ":useless_qt_gui",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = [
        "//projects:__pkg__",
    ],
)

qt_resource_via_qrc(
    name = "resources",
    files = ["//projects/useless_qt_gui/assets:images"],
    qrc_file = "resources.qrc",
)

qt_ui_library(
    name = "mainwindow_ui",
    includes = ["."],
    ui = "mainwindow.ui",
    deps = ["@rules_qt//:qt_widgets"],
)

qt_cc_library(
    name = "application",
    srcs = [
        "internal/application/mainwindow.cpp",
        "internal/application/menubutton.cpp",
        "internal/application/systembutton.cpp",
    ],
    hdrs = [
        "internal/application/mainwindow.h",
        "internal/application/menubutton.h",
        "internal/application/systembutton.h",
    ],
    includes = ["internal/application"],
    deps = [
        ":mainwindow_ui",
        "@rules_qt//:qt_widgets",
    ],
)

qt_cc_binary(
    name = "useless_qt_gui",
    srcs = ["cmd/useless_qt_gui/main.cpp"],
    deps = [
        ":application",
        ":resources",
        "@rules_qt//:qt_widgets",
    ],
)
