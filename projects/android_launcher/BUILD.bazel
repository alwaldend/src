# gazelle:java_extension disabled

load("@rules_docs//docs:defs.bzl", "docs_filegroup")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = [
        "//projects:__pkg__",
    ],
    deps = [
        "//projects/android_launcher/releases:docs",
    ],
)

exports_files(
    ["maven_lock.json"],
    visibility = [
        "//projects/android_launcher:__subpackages__",
    ],
)

filegroup(
    name = "manifest",
    srcs = ["AndroidManifest.xml"],
    visibility = [":__subpackages__"],
)

filegroup(
    name = "proguard",
    srcs = ["proguard_rules.pro"],
    visibility = [":__subpackages__"],
)
