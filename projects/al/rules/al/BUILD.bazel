load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/al/rules/al:al_toolchain.bzl", "al_toolchain")
load("//projects/al/rules/al:al_toolchain_resolved.bzl", "al_toolchain_resolved")
load("//tools/bzl/main/bzl:al_bzl_library_map.bzl", "al_bzl_library_map")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/al/rules:__pkg__"],
    deps = [
        ":libs.stardoc",
    ],
)

toolchain_type(
    name = "toolchain_type",
    visibility = ["//:__subpackages__"],
)

al_toolchain(
    name = "toolchain_impl",
    al = "//projects/al/cmd/al",
    visibility = ["//:__subpackages__"],
)

toolchain(
    name = "toolchain",
    toolchain = ":toolchain_impl",
    toolchain_type = ":toolchain_type",
    visibility = ["//:__subpackages__"],
)

al_toolchain_resolved(
    name = "toolchain_resolved",
    visibility = ["//:__subpackages__"],
)

al_bzl_library_map(
    name = "libs",
    libs = {
        "al_config": [],
        "al_toolchain": [],
        "al_toolchain_resolved": [
            "//tools/resolved_toolchain/main/bzl:al_resolved_toolchain",
        ],
    },
    visibility = ["//:__subpackages__"],
)
