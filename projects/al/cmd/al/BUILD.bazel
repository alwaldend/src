load("@rules_go//go:def.bzl", "go_binary", "go_test")

go_binary(
    name = "al",
    srcs = [
        "doc.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/projects/al/cmd/al",
    pure = "on",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/cli",
        "//pkg/al",
    ],
)

go_test(
    name = "lifecycle_e2e_test",
    srcs = [
        "bazel_e2e_test.go",
        "lifecycle_e2e_test.go",
        "mcp_e2e_test.go",
        "run_e2e_test.go",
    ],
    data = [":al"],
    env = {"AL_BINARY": "$(rlocationpath :al)"},
    deps = [
        "//api/al_proto",
        "//pkg/al",
        "//pkg/al_plugin",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_x_sys//unix",
        "@rules_go//go/runfiles",
    ],
)

exports_files(
    ["al.sh"],
    visibility = ["//visibility:public"],
)
