load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(transitive_visibility = "//projects:transitive_consumers")

go_binary(
    name = "al",
    embed = [":al_lib"],
    importpath = "git.alwaldend.com/alwaldend/src/projects/al/cmd/al",
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "lifecycle_e2e_test",
    srcs = [
        "bazel_e2e_test.go",
        "lifecycle_e2e_test.go",
        "run_e2e_test.go",
    ],
    data = [":al"],
    env = {"AL_BINARY": "$(rlocationpath :al)"},
    deps = [
        "//projects/al/api/al_proto",
        "//projects/al/pkg/al",
        "//projects/al/pkg/al_plugin",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_x_sys//unix",
        "@rules_go//go/runfiles",
    ],
)

exports_files(
    ["al.sh"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "al_lib",
    srcs = [
        "doc.go",
        "main.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/projects/al/cmd/al",
    visibility = ["//visibility:private"],
    deps = [
        "//projects/al/internal/cli",
        "//projects/al/pkg/al",
    ],
)
