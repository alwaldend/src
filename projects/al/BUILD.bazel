load("@rules_docs//docs:defs.bzl", "docs_filegroup")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = [
        "//projects:__pkg__",
        "//projects/al/landing:__pkg__",
    ],
    deps = [
        "//projects/al/releases:docs",
        "//projects/al/rules:docs",
    ],
)

alias(
    name = "al",
    actual = "//projects/al/cmd/al",
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
        "//projects/alwaldend.com:__subpackages__",
    ],
)
