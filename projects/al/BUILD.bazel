load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//projects/al:defs.bzl", "al_git_binary")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

alias(
    name = "al",
    actual = "//projects/al/cmd/al:al",
    visibility = ["//visibility:public"],
)

al_git_binary(
    name = "git",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//projects/al/rules",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//projects/al/rules"],
)

exports_files(
    [
        "defs.bzl",
        "extensions.bzl",
    ],
    visibility = ["//visibility:public"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    prefix = "content/docs/projects/al",
    visibility = ["//visibility:public"],
    deps = [
        "//projects/al/api:docs",
        "//projects/al/docs",
        "//projects/al/internal/release:docs",
        "//projects/al/openspec:docs",
        "//projects/al/pkg/injector:docs",
        "//projects/al/plugins/vault:docs",
        "//projects/al/rules:docs",
    ],
)

exports_files(["agent_operations.json"])
