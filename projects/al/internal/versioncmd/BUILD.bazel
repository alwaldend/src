load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "versioncmd",
    srcs = [
        "cobra.go",
        "command.go",
        "doc.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/projects/al/internal/versioncmd",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/versioning",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_test(
    name = "versioncmd_test",
    srcs = ["command_test.go"],
    data = [
        "//cmd/al",
        "//cmd/workspace_status:workspace_status.sh",
    ],
    embed = [":versioncmd"],
    env = {
        "AL_BINARY": "$(rlocationpath //cmd/al:al)",
        "WORKSPACE_STATUS_SCRIPT": "$(rlocationpath //cmd/workspace_status:workspace_status.sh)",
    },
    deps = ["@rules_go//go/runfiles"],
)
