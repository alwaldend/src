load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")
load("//tools/rules_promptfoo/promptfoo:defs.bzl", "promptfoo_validate_test")
load("//tools/rules_skills/skill:defs.bzl", "skill_library")

skill_library(
    name = "skill",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD",
            "BUILD.bazel",
            "evals/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

docs_filegroup(
    name = "docs",
    srcs = ["SKILL.md"],
    visibility = ["//projects/al:__pkg__"],
)

promptfoo_validate_test(
    name = "eval_config_test",
    config = "evals/promptfooconfig.yaml",
    data = [
        "evals/README.md",
        "evals/cases.yaml",
    ],
    skills = [":skill"],
)
