load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_go//go:def.bzl", "go_test")
load("//:defs.bzl", "al_release", "al_release_bundle", "al_release_files")

al_release_files(
    name = "payloads",
    srcs = ["payload.txt"],
)

al_release_bundle(
    name = "bundle",
    project = "projects/fixture",
    status_file = "status.txt",
    deps = [":payloads"],
)

al_release_bundle(
    name = "development_bundle",
    project = "projects/fixture",
    deps = [":payloads"],
)

al_release(
    name = "page",
    srcs = [":payloads"],
    project = "projects/fixture",
    release_name = "fixture",
)

build_test(
    name = "rules_test",
    targets = [
        ":bundle",
        ":page",
    ],
)

go_test(
    name = "bundle_test",
    srcs = [
        "bundle_test.go",
        "doc.go",
    ],
    data = [
        ":bundle",
        ":development_bundle",
    ],
    env = {
        "BUNDLE_PATH": "$(rlocationpath :bundle)",
        "DEVELOPMENT_BUNDLE_PATH": "$(rlocationpath :development_bundle)",
    },
    deps = ["@rules_go//go/runfiles"],
)
