load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

go_binary(
    name = "check",
    embed = [":consumer_lib"],
    importpath = "git.alwaldend.com/alwaldend/src/projects/al/tests/consumer",
    visibility = ["//visibility:public"],
)

go_library(
    name = "consumer_lib",
    srcs = [
        "check.go",
        "doc.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/projects/al/tests/consumer",
    visibility = ["//visibility:private"],
    deps = [
        "//projects/al/api/al_proto",
        "//projects/al/api/contracts",
        "//projects/al/pkg/al",
        "@com_github_spf13_cobra//:cobra",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/al/tests:__pkg__"],
)
