load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("//:defs.bzl", "al_config", "al_injector_call", "al_plugin", "al_vault_auth", "al_vault_conn")
load(":test/defs.bzl", "al_injector_fixture_selected")

exports_files(
    ["defs.bzl"],
    visibility = ["//visibility:public"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//visibility:public"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

go_library(
    name = "injector_lib",
    srcs = [
        "cleaner.go",
        "doc.go",
        "env.go",
        "file.go",
        "main.go",
        "oidc.go",
        "op.go",
        "plugin.go",
        "process.go",
        "resource.go",
        "secret.go",
        "templater.go",
        "vault_env.go",
        "vault_ssh.go",
    ],
    importpath = "git.alwaldend.com/alwaldend/src/projects/al/plugins/injector",
    visibility = ["//visibility:public"],
    deps = [
        ":injector_proto",
        "//api/al_proto",
        "//pkg/al",
        "//pkg/al_plugin",
        "//pkg/fp",
        "//pkg/lifecycle",
        "@com_github_google_uuid//:uuid",
        "@com_github_hashicorp_vault_api//:api",
    ],
)

go_binary(
    name = "injector",
    embed = [":injector_lib"],
    visibility = ["//visibility:public"],
)

al_plugin(
    name = "config",
    config_name = "injector",
    executable = ":injector",
    visibility = ["//visibility:public"],
)

go_test(
    name = "cleanup_test",
    srcs = [
        "cleanup_test.go",
        "oidc_test.go",
    ],
    embed = [":injector_lib"],
    deps = [
        ":injector_proto",
        "//api/al_proto",
        "//pkg/al",
    ],
)

proto_library(
    name = "injector_proto_proto",
    srcs = ["api.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "injector_proto_go_proto",
    importpath = "git.alwaldend.com/alwaldend/src/projects/al/plugins/injector/injector_proto",
    proto = ":injector_proto_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "injector_proto",
    embed = [":injector_proto_go_proto"],
    importpath = "git.alwaldend.com/alwaldend/src/projects/al/plugins/injector/injector_proto",
    visibility = ["//visibility:public"],
)

al_vault_auth(
    name = "auth",
    testonly = True,
    no_auth = True,
)

al_vault_conn(
    name = "connection",
    testonly = True,
    address = "http://127.0.0.1:1",
)

al_injector_fixture_selected(
    name = "selected",
    testonly = True,
    labels = {"dictionary": "selected"},
)

al_injector_call(
    name = "selected_override",
    testonly = True,
    extends = ":selected",
    labels = {"dictionary": "selected"},
    res_kv = {"credentials": {
        "mount": "secrets",
        "path": "fixture/credentials_override",
    }},
)

al_injector_call(
    name = "missing",
    testonly = True,
    labels = {"dictionary": "missing"},
    res_env = {"missing": {
        "value": "unused",
        "deps": ["absent"],
    }},
)

al_injector_call(
    name = "cycle",
    testonly = True,
    labels = {"dictionary": "cycle"},
    res_env = {"cycle": {
        "value": "unused",
        "deps": ["cycle"],
    }},
)

al_injector_call(
    name = "unselected",
    testonly = True,
    labels = {"dictionary": "unselected"},
    res_kv = {"unused": {
        "mount": "secrets",
        "path": "fixture/unused",
    }},
)

al_config(
    name = "dictionary_config",
    testonly = True,
    configs = [
        ":auth",
        ":config",
        ":connection",
        ":cycle",
        ":missing",
        ":selected",
        ":selected_override",
        ":unselected",
    ],
)

go_test(
    name = "dictionary_e2e_test",
    srcs = ["dictionary_e2e_test.go"],
    data = [
        ":dictionary_config",
        "//:al",
    ],
    env = {
        "DICTIONARY_CONFIG": "$(rlocationpath :dictionary_config)",
        "AL_BINARY": "$(rlocationpath //:al)",
    },
    deps = [
        "//pkg/al",
        "@org_golang_google_protobuf//encoding/protojson",
        "@rules_go//go/runfiles",
    ],
)

exports_files(
    ["dev_server_test.go"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//rules"],
)
