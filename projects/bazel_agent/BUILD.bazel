load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

alias(
    name = "bazel_agent",
    actual = "//projects/bazel_agent/cmd/bazel_agent",
    visibility = ["//:__subpackages__"],
)

native_binary(
    name = "install",
    src = "//tools/file_installer/cmd/install_binary",
    args = [
        "--source",
        "$(rootpath :bazel_agent)",
        "--name",
        "bazel_agent",
    ],
    data = [":bazel_agent"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = [
        "//projects:__pkg__",
    ],
)
