load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//projects/al/rules/al:al_config.bzl", "al_config")
load("//tools/vault:defs.bzl", "vault_binary_map")

alias(
    name = "bazel_agent",
    actual = "//projects/bazel_agent/cmd/bazel_agent",
    visibility = ["//:__subpackages__"],
)

sh_binary(
    name = "install",
    srcs = ["install.sh"],
    args = ["$(rootpath //projects/bazel_agent/cmd/bazel_agent)"],
    data = ["//projects/bazel_agent/cmd/bazel_agent"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = [
        "//projects:__pkg__",
        "//projects/bazel_agent/landing:__pkg__",
    ],
    deps = ["//projects/bazel_agent/tf:docs"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
        "//projects/alwaldend.com:__subpackages__",
        "//projects/bazel_agent/tf:__pkg__",
    ],
)

al_config(
    name = "al",
    srcs = ["al.lua"],
    visibility = ["//projects/bazel_agent/tf:__pkg__"],
    deps = ["//infra:al"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)
