load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    prefix = "content/docs/projects/rules_binary_toolchain",
    visibility = ["//visibility:public"],
    deps = subpackages(
        include = ["**"],
        allow_empty = True,
        exclude = [
            "bazel-*",
            "test/**",
        ],
    ),
)

build_test(
    name = "build_test",
    targets = [
        "//main/bzl:bzl_library",
        "//test/runtime_files:filegroup_runfiles_test",
        "//test/runtime_files:native_binary_runfiles_test",
        "//test/runtime_files:toolchain_binary_runfiles_environment_test",
    ],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = ["//visibility:public"],
)
