module(
    name = "rules_binary_toolchain",
    version = "0.0.0",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_docs", version = "0.0.0")

bazel_dep(name = "rules_docs_gazelle", version = "0.0.0", dev_dependency = True)

bazel_dep(name = "rules_shell", version = "0.6.1")

local_path_override(
    module_name = "rules_docs",
    path = "../rules_docs",
)

local_path_override(
    module_name = "rules_docs_gazelle",
    path = "../rules_docs_gazelle",
)

include("//examples:example.MODULE.bazel")
