{
    "toolchains": [
        {
            "name": "buf",
            "version": "1.67.0"
        },
        {
            "name": "trufflehog",
            "version": "3.94.2"
        },
        {
            "name": "runtime_files_fixture",
            "version": "0.0.0"
        }
    ],
    "archives": [
        {
            "toolchain_name": "buf",
            "toolchain_version": "1.67.0",
            "archive_name": "linux_x86_64",
            "binaries": [
                {
                    "name": "buf",
                    "path": "out/buf/bin/buf"
                }
            ],
            "actions": [
                {
                    "download_and_extract": {
                        "url": "https://github.com/bufbuild/buf/releases/download/v1.67.0/buf-Linux-x86_64.tar.gz",
                        "output": "out",
                        "integrity": "sha256-uGgsLqbzd88UQeT7xU7R7My7ny2IdWDEMgz3gH8BVRk="
                    }
                }
            ],
            "toolchain": {
                "exec_compatible_with": [
                    "@platforms//os:linux",
                    "@platforms//cpu:x86_64"
                ]
            }
        },
        {
            "toolchain_name": "trufflehog",
            "toolchain_version": "3.94.2",
            "archive_name": "linux_x86_64",
            "binaries": [
                {
                    "name": "trufflehog",
                    "path": "out/trufflehog"
                }
            ],
            "actions": [
                {
                    "download_and_extract": {
                        "url": "https://github.com/trufflesecurity/trufflehog/releases/download/v3.94.2/trufflehog_3.94.2_linux_amd64.tar.gz",
                        "output": "out",
                        "integrity": "sha256-b/aFT39mPCCMI6PZvjfSMz0VhXwoy+fwCKf8kQqIdo0="
                    }
                }
            ],
            "toolchain": {
                "exec_compatible_with": [
                    "@platforms//os:linux",
                    "@platforms//cpu:x86_64"
                ]
            }
        },
        {
            "toolchain_name": "runtime_files_fixture",
            "toolchain_version": "0.0.0",
            "archive_name": "local",
            "binaries": [
                {
                    "name": "fixture_native",
                    "path": "bin/fixture_native",
                    "runtime_files": [
                        "**"
                    ]
                },
                {
                    "name": "fixture_filegroup",
                    "path": "bin/fixture_filegroup",
                    "runtime_files": [
                        "**"
                    ]
                }
            ],
            "actions": [
                {
                    "execute": {
                        "arguments": [
                            "/bin/sh",
                            "-c",
                            "mkdir -p bin runtime && printf '#!/bin/sh\\nset -eu\\nruntime_file=$(find -L \"${RUNFILES_DIR:?}\" -type f -name native-runtime.txt -print -quit)\\ntest -n \"$runtime_file\"\\ntest \"$(cat \"$runtime_file\")\" = native-runtime\\n' > bin/fixture_native && chmod +x bin/fixture_native && printf '#!/bin/sh\\nexit 0\\n' > bin/fixture_filegroup && chmod +x bin/fixture_filegroup && printf 'native-runtime\\n' > runtime/native-runtime.txt && printf 'filegroup-runtime\\n' > runtime/filegroup-runtime.txt"
                        ]
                    }
                }
            ],
            "toolchain": {
                "exec_compatible_with": [
                    "@platforms//os:linux",
                    "@platforms//cpu:x86_64"
                ]
            }
        }
    ]
}
