load("@rules_al//:defs.bzl", "release_bundle", "release_files")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/release_pages:defs.bzl", "release_page")

package(transitive_visibility = "//projects:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/leetcode_downloader:__pkg__"],
    deps = [
        ":head",
    ],
)

release_files(
    name = "files",
    srcs = [
        # do not sort
        "//projects/leetcode_downloader/api/contracts:contracts.proto",
        "//projects/leetcode_downloader/cmd/download_submissions",
        "//projects/leetcode_downloader/cmd/leetcode_downloader:go_crossbinary",
    ],
    deployments = ["//projects:release_deployment"],
)

release_page(
    name = "head",
    srcs = [
        ":files",
    ],
    project = "projects/leetcode_downloader",
    release_name = "head",
    visibility = ["//projects:__pkg__"],
)

# Build this project independently with the shared release bootstrap.
release_bundle(
    name = "bundle",
    project = "projects/leetcode_downloader",
    visibility = ["//:__subpackages__"],
    deps = [":files"],
)
