load("@rules_al//:defs.bzl", "al_config", "al_injector_call", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("@rules_terraform//terraform:providers.bzl", "terraform_provider")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg", "mermaid_site_webp")
load("//tools/vault:defs.bzl", "vault_binary_map")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//projects:transitive_consumers")

mermaid_site_svg(
    name = "architecture",
    src = "docs/architecture.mmd",
    out = "rendered/architecture.svg",
)

docs_filegroup(
    name = "docs_assets",
    srcs = [":architecture"],
    prefix = "content/docs/projects/vastai_terraform_provider/assets",
    visibility = ["//projects/vastai_terraform_provider/site/content:__pkg__"],
)

mermaid_site_webp(
    name = "architecture_preview",
    src = "docs/architecture.mmd",
    out = "rendered/architecture.webp",
    aspect_ratio = [],
    color_scheme = "dark",
    scale = 2,
    tags = ["manual"],
)

package_group(
    name = "registration_consumers",
    packages = ["//projects/vastai_terraform_provider/internal/provider"],
)

package_group(
    name = "credential_consumers",
    packages = [
        "//projects/vastai_terraform_provider",
    ],
)

al_vault_auth(
    name = "auth",
    approle = "src_projects_vastai_terraform_provider",
    extends = "//tools/al:auth",
)

vault_tf_backend(
    name = "tf_backend_test",
    labels = {"tf": "test"},
    path = "alwaldend.com/vault1/approles/src_projects_vastai_terraform_provider/tf_backend/test",
)

al_injector_call(
    name = "vastai",
    labels = {"vastai": "1"},
    res_env = {"VAST_API_KEY": {
        "value": "{{ .Last.Data.api_key }}",
        "deps": ["vastai"],
    }},
    res_kv = {
        "vastai": {
            "mount": "secrets",
            "path": "alwaldend.com/vault1/approles/src_projects_vastai_terraform_provider/vastai",
        },
    },
)

al_config(
    name = "al",
    configs = [
        ":auth",
        ":tf_backend_test",
        ":vastai",
        "//infra:al",
    ],
    visibility = ["//projects/vastai_terraform_provider:__subpackages__"],
)

vault_binary_map(
    name = "vault",
    configs = [":al"],
)

alias(
    name = "vastai_terraform_provider",
    actual = "//projects/vastai_terraform_provider/cmd/terraform-provider-vastai",
    visibility = ["//:__subpackages__"],
)

pkg_files(
    name = "provider_files",
    srcs = ["//projects/vastai_terraform_provider/cmd/terraform-provider-vastai"],
    attributes = pkg_attributes(mode = "0755"),
    renames = {"//projects/vastai_terraform_provider/cmd/terraform-provider-vastai": "terraform-provider-vastai_v0.0.0-dev"},
)

pkg_zip(
    name = "provider_archive",
    srcs = [":provider_files"],
)

terraform_provider(
    name = "provider",
    src = ":provider_archive",
    platform = "linux_amd64",
    source = "registry.terraform.io/alwaldend/vastai",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    version = "0.0.0-dev",
    visibility = ["//:__subpackages__"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects:__pkg__"],
    deps = [
        ":docs_assets",
        "//projects/vastai_terraform_provider/openspec:docs",
    ],
)
