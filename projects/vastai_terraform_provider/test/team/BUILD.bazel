load("@rules_al//:defs.bzl", "al_binary_run")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary_map", "terraform_test_map")

package(transitive_visibility = "//projects:transitive_consumers")

_INPUTS = glob(["*.tf"]) + ["test_public_key.pub"]

terraform_binary_map(
    name = "tf",
    args = {
        "plan": ["plan"],
        "show": ["show"],
        "apply": [
            "--require-saved-plan",
            "apply",
        ],
        "destroy_plan": [
            "plan",
            "-destroy",
        ],
        "state": ["state"],
        "import": ["import"],
    },
    data = _INPUTS + [
        "//tools/vault/injector",
        "//tools/vault/tf_backend",
    ],
    providers = ["//projects/vastai_terraform_provider:provider"],
    wrapper = al_binary_run,
    wrapper_kwargs = {
        "configs": ["//projects/vastai_terraform_provider:al"],
        "run_args": [
            "--plugin_label",
            "tf=test",
            "--plugin_label",
            "vastai=1",
        ],
    },
)

terraform_test_map(
    name = "tf_tests",
    data = _INPUTS,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects/vastai_terraform_provider:__pkg__"],
)
