load("@rules_al//:defs.bzl", "release_binary", "release_bundle", "release_files")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/release_pages:defs.bzl", "release_page")

package(transitive_visibility = "//projects:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/nexus_security_plugin:__pkg__"],
    deps = [
        ":head",
    ],
)

release_files(
    name = "files",
    srcs = [
        "//projects/nexus_security_plugin/internal/plugin:java_lib",
    ],
    deployments = ["//projects:release_deployment"],
)

release_page(
    name = "head",
    srcs = [
        ":files",
    ],
    project = "projects/nexus_security_plugin",
    release_name = "head",
    visibility = ["//projects:__pkg__"],
)

release_binary(
    name = "head_deploy",
    srcs = [":head"],
)

# Build this project independently with the shared release bootstrap.
release_bundle(
    name = "bundle",
    project = "projects/nexus_security_plugin",
    visibility = ["//:__subpackages__"],
    deps = [":files"],
)
