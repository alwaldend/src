load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/terraform:defs.bzl", "terraform_test_map")

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects/tf_modules/dns_records:__pkg__"],
)

filegroup(
    name = "normalize",
    srcs = ["main.tf"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "test_sources",
    testonly = True,
    srcs = glob(["tests/*.tftest.hcl"]) + [":normalize"],
    visibility = ["//projects/tf_modules/dns_records:__subpackages__"],
)

terraform_test_map(
    name = "tf_tests",
    testonly = True,
    args = {
        "fmt": [
            "--direct",
            "fmt",
            "--check",
            "--recursive",
        ],
        "normalize": [
            "--direct",
            "test",
            "-no-color",
        ],
    },
    data = [":test_sources"],
)
