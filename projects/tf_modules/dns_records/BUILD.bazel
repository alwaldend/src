load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_binary_map", "terraform_test_map")

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects/tf_modules:__pkg__"],
    deps = [
        "//projects/tf_modules/dns_records/global:docs",
        "//projects/tf_modules/dns_records/normalize:docs",
        "//projects/tf_modules/dns_records/test/providers:docs",
    ],
)

filegroup(
    name = "dns_records",
    srcs = [
        "main.tf",
        "//projects/tf_modules/dns_records/dc1",
        "//projects/tf_modules/dns_records/global",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "test_sources",
    testonly = True,
    srcs = glob(["tests/*.tftest.hcl"]) + [
        ":dns_records",
        "//projects/tf_modules/dns_records/global:test_sources",
    ],
    visibility = ["//projects/tf_modules/dns_records:__subpackages__"],
)

_PROVIDERS = [
    "@terraform_provider_cloudflare_cloudflare//:provider",
    "@terraform_provider_terraform_routeros_routeros//:provider",
]

terraform_binary_map(
    name = "tf",
    testonly = True,
    args = {"fmt": [
        "--direct",
        "fmt",
        "--write",
        "--recursive",
    ]},
    data = [
        ":dns_records",
        ":test_sources",
        "//projects/tf_modules/dns_records/normalize:test_sources",
    ],
    providers = _PROVIDERS,
)

terraform_test_map(
    name = "tf_tests",
    testonly = True,
    data = [
        ":dns_records",
        ":test_sources",
        "//projects/tf_modules/dns_records/normalize:test_sources",
    ],
    providers = _PROVIDERS,
)
