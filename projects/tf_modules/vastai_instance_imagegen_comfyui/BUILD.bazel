load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_test_map")

package(transitive_visibility = "//projects:transitive_consumers")

filegroup(
    name = "vastai_instance_imagegen_comfyui",
    srcs = [
        "main.tf",
        "runtime.json",
    ],
    data = ["//projects/tf_modules/vastai_instance_imagegen"],
    visibility = ["//:__subpackages__"],
)

exports_files(
    ["runtime.json"],
    visibility = ["//projects/comfyui_tools:asset_consumers"],
)

filegroup(
    name = "entry",
    srcs = ["main.tf"],
    visibility = ["//projects/tf_modules:imagegen_acceptance_consumers"],
)

copy_file(
    name = "test_provider_override",
    testonly = True,
    src = "tests/provider_constraints.tf",
    out = "provider_test_override.tf",
)

terraform_test_map(
    name = "tf_tests",
    args = {
        "fmt": [
            "--direct",
            "fmt",
            "-check",
            "-recursive",
        ],
        "validate": ["validate"],
        "test": [
            "test",
            "-no-color",
        ],
    },
    data = [
        ":test_provider_override",
        ":vastai_instance_imagegen_comfyui",
    ] + glob(["tests/*.tftest.hcl"]),
    providers = ["//projects/vastai_terraform_provider:provider"],
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//projects/tf_modules:__pkg__"],
)
