terraform {
  required_providers {
    vastai = { source = "alwaldend/vastai" }
  }
}

variable "access_mode" {
  type        = string
  default     = "ssh_only"
  nullable    = false
  description = "ssh_only uses local forwarding; exposed publishes only the password-protected image-generation HTTPS proxy."
}

variable "web_username" {
  type        = string
  default     = "imagegen"
  nullable    = false
  description = "HTTPS Basic authentication username."
}

variable "web_password" {
  type        = string
  default     = null
  sensitive   = true
  description = "Required in exposed mode: 32 to 64 alphanumeric characters, generated by the caller and stored in its secret manager."
}

variable "image" {
  type        = string
  nullable    = false
  description = "Vast-native image reference selected by the caller."
}

variable "model_downloads" {
  type = list(object({
    url      = string
    filename = string
    kind     = optional(string, "checkpoint")
  }))
  default     = []
  nullable    = false
  description = "Public HTTPS model files for the native first-boot provisioner. URLs must not contain credentials."
}

variable "workflows" {
  type        = map(string)
  default     = {}
  nullable    = false
  description = "Named native ComfyUI workflow JSON documents staged after workspace initialization."
  validation {
    condition = alltrue([for name, content in var.workflows :
      can(regex("^[A-Za-z0-9][A-Za-z0-9_-]*$", name)) &&
      can(jsondecode(content).nodes) && can(jsondecode(content).links)
    ])
    error_message = "Workflows require safe basenames and native JSON with nodes and links."
  }
}

variable "custom_nodes" {
  type        = map(object({ url = string, ref = string }))
  default     = {}
  nullable    = false
  description = "Explicitly approved node packs fetched at immutable commits by Vast's native provisioner."
  validation {
    condition = alltrue([for name, node in var.custom_nodes :
      can(regex("^[A-Za-z0-9][A-Za-z0-9_-]*$", name)) &&
      can(regex("^https://github[.]com/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$", node.url)) &&
      can(regex("^[0-9a-f]{40}$", node.ref))
    ])
    error_message = "Node packs need a safe directory name, public GitHub repository URL and full immutable commit."
  }
}

variable "python_requirements" {
  type        = string
  default     = null
  description = "Approved, version-pinned and hash-locked requirements for the selected node packs."
}

variable "offer_id" {
  type        = number
  default     = null
  description = "Optional reviewed on-demand offer ID; otherwise select the cheapest matching datacenter offer."

}

variable "min_gpu_ram_gb" {
  type        = number
  default     = 32
  description = "Minimum VRAM per GPU for automatic offer selection, in GiB."
  nullable    = false

}

variable "max_hourly_price" {
  type        = number
  default     = 1
  description = "Maximum API-reported hourly USD price for automatic selection, including the requested disk allocation. This is not a total spending limit."
  nullable    = false

}

variable "gpu_name" {
  type        = string
  default     = null
  description = "Optional exact GPU model filter for automatic selection, for example RTX 4090."
}

variable "template_hash_id" {
  type        = string
  default     = null
  description = "Optional reviewed Vast template hash with environment-only options. Omit to use the selected image without inheriting any template configuration."
}

variable "disk_gb" {
  type        = number
  default     = 100
  description = "Local storage in GB. Vast recommends at least 50 GB, or 100 GB for multiple models."
  nullable    = false

}

variable "label" {
  type        = string
  default     = "imagegen"
  description = "Mutable instance label."
  nullable    = false
}

variable "state" {
  type        = string
  default     = "running"
  description = "Desired power state. Stopped instances still incur storage charges."
  nullable    = false

}

variable "local_port" {
  type        = number
  default     = 7860
  description = "Local loopback port used by the SSH forwarding command; no remote port is published."
  nullable    = false

}

module "imagegen" {
  source           = "../vastai_instance_imagegen"
  access_mode      = var.access_mode
  web_username     = var.web_username
  web_password     = var.web_password
  image            = var.image
  model_downloads  = var.model_downloads
  offer_id         = var.offer_id
  min_gpu_ram_gb   = var.min_gpu_ram_gb
  max_hourly_price = var.max_hourly_price
  gpu_name         = var.gpu_name
  template_hash_id = var.template_hash_id
  disk_gb          = var.disk_gb
  label            = var.label
  state            = var.state
  local_port       = var.local_port
  runtime_files    = { for name, content in var.workflows : "/workspace/ComfyUI/user/default/workflows/${name}.json" => jsonencode(jsondecode(content)) }
  runtime = {
    service            = "comfyui"
    port               = 18188
    arguments_variable = "COMFYUI_ARGS"
    arguments          = "--listen 127.0.0.1 --port 18188 --disable-auto-launch --disable-all-custom-nodes --offline${length(var.custom_nodes) == 0 ? "" : " --whitelist-custom-nodes ${join(" ", sort(keys(var.custom_nodes)))}"}"
    model_root         = "/workspace/ComfyUI"
    model_directories = {
      checkpoint   = "models/diffusion_models"
      lora         = "models/loras"
      vae          = "models/vae"
      embedding    = "models/embeddings"
      text_encoder = "models/text_encoders"
    }
    portal_entries = ["localhost:8288:18288:/:API Wrapper"]
  }
  provisioning = {
    git_repos    = [for name, node in var.custom_nodes : { url = node.url, ref = node.ref, dest = "/workspace/ComfyUI/custom_nodes/${name}" }]
    write_files  = var.python_requirements == null ? [] : [{ path = "/etc/imagegen-python-requirements.txt", content = var.python_requirements, permissions = "0600" }]
    pip_packages = var.python_requirements == null ? [] : [{ venv = "/venv/main", requirements = ["/etc/imagegen-python-requirements.txt"], args = "--require-hashes --no-deps" }]
  }
}

output "instance_id" {
  value = module.imagegen.instance_id
}

output "ssh_host" {
  value = module.imagegen.ssh_host
}

output "ssh_port" {
  value = module.imagegen.ssh_port
}

output "ssh_forward_command" {
  value = module.imagegen.ssh_forward_command
}

output "local_url" {
  value = module.imagegen.local_url
}

output "https_url" {
  value = module.imagegen.https_url
}
