load("@rules_al//:defs.bzl", "release_files")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/alwaldend.com/pkg/release_pages:defs.bzl", "release_page")

package(transitive_visibility = "//projects:transitive_consumers")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//projects/tf_modules:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ) + [":head"],
)

release_files(
    name = "files",
    srcs = [],
    deployments = ["//projects:release_deployment"],
)

release_page(
    name = "head",
    srcs = [":files"],
    project = "projects/tf_modules",
    release_name = "head",
    visibility = ["//projects:__pkg__"],
)
