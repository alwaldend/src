terraform {
  required_providers {
    vastai = { source = "alwaldend/vastai" }
  }
}

variable "access_mode" {
  type        = string
  default     = "ssh_only"
  nullable    = false
  description = "ssh_only uses local forwarding; exposed publishes only the password-protected image-generation HTTPS proxy."
}

variable "web_username" {
  type        = string
  default     = "imagegen"
  nullable    = false
  description = "HTTPS Basic authentication username."
}

variable "web_password" {
  type        = string
  default     = null
  sensitive   = true
  description = "Required in exposed mode: 32 to 64 alphanumeric characters, generated by the caller and stored in its secret manager."
}

variable "image" {
  type        = string
  nullable    = false
  description = "Vast-native image reference selected by the caller."
}

variable "model_downloads" {
  type = list(object({
    url      = string
    filename = string
    kind     = optional(string, "checkpoint")
  }))
  default     = []
  nullable    = false
  description = "Public HTTPS model files for the native first-boot provisioner. URLs must not contain credentials."
}

variable "offer_id" {
  type        = number
  default     = null
  description = "Optional reviewed on-demand offer ID; otherwise select the cheapest matching datacenter offer."

}

variable "min_gpu_ram_gb" {
  type        = number
  default     = 32
  description = "Minimum VRAM per GPU for automatic offer selection, in GiB."
  nullable    = false

}

variable "max_hourly_price" {
  type        = number
  default     = 1
  description = "Maximum API-reported hourly USD price for automatic selection, including the requested disk allocation. This is not a total spending limit."
  nullable    = false

}

variable "gpu_name" {
  type        = string
  default     = null
  description = "Optional exact GPU model filter for automatic selection, for example RTX 4090."
}

variable "template_hash_id" {
  type        = string
  default     = null
  description = "Optional reviewed Vast template hash with environment-only options. Omit to use the selected image without inheriting any template configuration."
}

variable "disk_gb" {
  type        = number
  default     = 100
  description = "Local storage in GB. Vast recommends at least 50 GB, or 100 GB for multiple models."
  nullable    = false

}

variable "label" {
  type        = string
  default     = "imagegen"
  description = "Mutable instance label."
  nullable    = false
}

variable "state" {
  type        = string
  default     = "running"
  description = "Desired power state. Stopped instances still incur storage charges."
  nullable    = false

}

variable "local_port" {
  type        = number
  default     = 7860
  description = "Local loopback port used by the SSH forwarding command; no remote port is published."
  nullable    = false

}

variable "model_selection" {
  type = object({
    checkpoint = string
    preset     = string
    modules    = list(string)
    steps      = number
    cfg_scale  = number
  })
  default     = null
  description = "Optional native Forge selection for a downloaded checkpoint and its external encoder/VAE files."
  validation {
    condition = var.model_selection == null ? true : (
      can(regex("^[a-z][a-z0-9_]*$", var.model_selection.preset)) &&
      var.model_selection.steps >= 1 && var.model_selection.steps <= 150 && floor(var.model_selection.steps) == var.model_selection.steps &&
      var.model_selection.cfg_scale >= 1 && var.model_selection.cfg_scale <= 30
    )
    error_message = "Model selection needs a plain preset identifier, 1–150 integer steps, and CFG scale 1–30."
  }
  validation {
    condition = var.model_selection == null ? true : (
      contains([for model in var.model_downloads : model.filename if model.kind == "checkpoint"], var.model_selection.checkpoint) &&
      alltrue([for filename in var.model_selection.modules : contains([for model in var.model_downloads : model.filename if contains(["vae", "text_encoder"], model.kind)], filename)])
    )
    error_message = "Selected checkpoint and encoder/VAE modules must be declared in model_downloads with their corresponding kinds."
  }
}

locals {
  model_directories = {
    checkpoint   = "models/Stable-diffusion"
    lora         = "models/Lora"
    vae          = "models/VAE"
    embedding    = "embeddings"
    text_encoder = "models/text_encoder"
  }
  model_paths      = { for model in var.model_downloads : model.filename => "/workspace/stable-diffusion-webui-forge/${lookup(local.model_directories, model.kind, "invalid")}/${model.filename}" }
  selected_modules = var.model_selection == null ? [] : [for filename in var.model_selection.modules : lookup(local.model_paths, filename, "")]
  model_settings = var.model_selection == null ? "" : jsonencode({
    forge_preset                                             = var.model_selection.preset
    sd_model_checkpoint                                      = var.model_selection.checkpoint
    "forge_checkpoint_${var.model_selection.preset}"         = var.model_selection.checkpoint
    forge_additional_modules                                 = local.selected_modules
    "forge_additional_modules_${var.model_selection.preset}" = local.selected_modules
    "${var.model_selection.preset}_t2i_step"                 = var.model_selection.steps
    "${var.model_selection.preset}_i2i_step"                 = var.model_selection.steps
    "${var.model_selection.preset}_t2i_cfg"                  = var.model_selection.cfg_scale
    "${var.model_selection.preset}_i2i_cfg"                  = var.model_selection.cfg_scale
  })
}

module "imagegen" {
  source           = "../vastai_instance_imagegen"
  access_mode      = var.access_mode
  web_username     = var.web_username
  web_password     = var.web_password
  image            = var.image
  model_downloads  = var.model_downloads
  offer_id         = var.offer_id
  min_gpu_ram_gb   = var.min_gpu_ram_gb
  max_hourly_price = var.max_hourly_price
  gpu_name         = var.gpu_name
  template_hash_id = var.template_hash_id
  disk_gb          = var.disk_gb
  label            = var.label
  state            = var.state
  local_port       = var.local_port
  runtime = {
    service            = "forge"
    port               = 17860
    arguments_variable = "FORGE_ARGS"
    arguments          = "--port 17860 --server-name 127.0.0.1${var.model_selection == null ? "" : " --ui-settings-file /etc/imagegen-forge.json"}"
    model_root         = "/workspace/stable-diffusion-webui-forge"
    model_directories  = local.model_directories
  }
  runtime_files = var.model_selection == null ? {} : { "/etc/imagegen-forge.json" = local.model_settings }
}

output "instance_id" {
  value = module.imagegen.instance_id
}

output "ssh_host" {
  value = module.imagegen.ssh_host
}

output "ssh_port" {
  value = module.imagegen.ssh_port
}

output "ssh_forward_command" {
  value = module.imagegen.ssh_forward_command
}

output "local_url" {
  value = module.imagegen.local_url
}

output "https_url" {
  value = module.imagegen.https_url
}
