load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//projects:transitive_consumers")

package_group(
    name = "imagegen_acceptance_consumers",
    packages = ["//projects/vastai_terraform_provider/test/acceptance"],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = [
        "//projects:__pkg__",
    ],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
        exclude = ["releases"],
    ),
)
