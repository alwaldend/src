terraform {
  required_providers {
    vastai = {
      source = "alwaldend/vastai"
    }
  }
}

variable "access_mode" {
  type        = string
  default     = "ssh_only"
  nullable    = false
  description = "ssh_only uses local forwarding; exposed publishes only the password-protected image-generation HTTPS proxy."
  validation {
    condition     = contains(["ssh_only", "exposed"], var.access_mode)
    error_message = "access_mode must be ssh_only or exposed."
  }
}

variable "web_username" {
  type        = string
  default     = "imagegen"
  nullable    = false
  description = "HTTPS Basic authentication username."
  validation {
    condition     = can(regex("^[a-zA-Z][a-zA-Z0-9_]{0,63}$", var.web_username))
    error_message = "web_username must begin with a letter and contain only letters, digits, and underscores, up to 64 characters."
  }
}

variable "web_password" {
  type        = string
  default     = null
  sensitive   = true
  description = "Required in exposed mode: 32 to 64 alphanumeric characters, generated by the caller and stored in its secret manager."
  validation {
    condition     = var.web_password == null ? true : can(regex("^[a-zA-Z0-9]{32,64}$", var.web_password))
    error_message = "web_password must contain 32 to 64 alphanumeric characters."
  }
}

variable "image" {
  type        = string
  nullable    = false
  description = "Vast-native image reference selected by the caller."
  validation {
    condition     = can(regex("^[a-zA-Z0-9./_:@-]+$", var.image))
    error_message = "image must be a container image reference without whitespace or shell syntax."
  }
}

variable "model_downloads" {
  type = list(object({
    url      = string
    filename = string
    kind     = optional(string, "checkpoint")
  }))
  default     = []
  nullable    = false
  description = "Public HTTPS model files for the native first-boot provisioner. URLs must not contain credentials."
  validation {
    condition = alltrue([for model in var.model_downloads :
      can(regex("^https://[A-Za-z0-9.-]+/[^?#[:space:]]+$", model.url)) &&
      can(regex("^[A-Za-z0-9][A-Za-z0-9._-]*[.]safetensors$", model.filename)) &&
      contains(["checkpoint", "lora", "vae", "embedding", "text_encoder"], model.kind)
    ])
    error_message = "Models need a public HTTPS URL, a plain .safetensors filename, and checkpoint/lora/vae/embedding/text_encoder kind."
  }
  validation {
    condition     = length(distinct([for model in var.model_downloads : model.filename])) == length(var.model_downloads)
    error_message = "Model filenames must be unique."
  }
}

variable "runtime" {
  type = object({
    service            = string
    port               = number
    arguments_variable = string
    arguments          = string
    model_root         = string
    model_directories  = map(string)
    portal_entries     = optional(list(string), [])
  })
  nullable    = false
  description = "Native runtime contract supplied by a runtime-specific module. All services bind to loopback."
  validation {
    condition = (
      can(regex("^[a-z][a-z0-9_-]*$", var.runtime.service)) &&
      var.runtime.port >= 1024 && var.runtime.port <= 65535 && floor(var.runtime.port) == var.runtime.port && var.runtime.port != 7860 &&
      can(regex("^[A-Z][A-Z0-9_]*$", var.runtime.arguments_variable)) &&
      can(regex("^[A-Za-z0-9 /_.=-]+$", var.runtime.arguments)) &&
      can(regex("^/workspace/[A-Za-z0-9_-]+$", var.runtime.model_root)) &&
      alltrue([for directory in values(var.runtime.model_directories) : can(regex("^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$", directory))]) &&
      alltrue([for entry in var.runtime.portal_entries : can(regex("^localhost:[0-9]+:[0-9]+:/:[A-Za-z0-9 ]+$", entry))])
    )
    error_message = "Runtime needs plain service/argument identifiers, a non-proxy integer port, and safe workspace-relative model directories."
  }
}

variable "runtime_files" {
  type        = map(string)
  default     = {}
  nullable    = false
  description = "Native configuration files staged by the runtime wrapper after workspace initialization."
  validation {
    condition = alltrue([for path in keys(var.runtime_files) :
      can(regex("^/(etc|workspace)/[A-Za-z0-9_/-]+[.]json$", path)) && !strcontains(path, "..")
    ])
    error_message = "Runtime configuration files must have safe absolute JSON paths beneath /etc or /workspace."
  }
}

locals {
  model_manifest = jsonencode({
    version = 1
    downloads = [for model in var.model_downloads : {
      url  = model.url
      dest = "${var.runtime.model_root}/${lookup(var.runtime.model_directories, model.kind, "invalid")}/${model.filename}"
    }]
  })
}

variable "offer_id" {
  type        = number
  default     = null
  description = "Optional reviewed on-demand offer ID; otherwise select the cheapest matching datacenter offer."

  validation {
    condition     = var.offer_id == null ? true : var.offer_id > 0 && floor(var.offer_id) == var.offer_id
    error_message = "offer_id must be a positive integer."
  }
}

variable "min_gpu_ram_gb" {
  type        = number
  default     = 32
  description = "Minimum VRAM per GPU for automatic offer selection, in GiB."
  nullable    = false

  validation {
    condition     = var.min_gpu_ram_gb >= 32
    error_message = "min_gpu_ram_gb must be at least 32."
  }
}

variable "max_hourly_price" {
  type        = number
  default     = 1
  description = "Maximum API-reported hourly USD price for automatic selection, including the requested disk allocation. This is not a total spending limit."
  nullable    = false

  validation {
    condition     = var.max_hourly_price > 0
    error_message = "max_hourly_price must be positive."
  }
}

variable "gpu_name" {
  type        = string
  default     = null
  description = "Optional exact GPU model filter for automatic selection, for example RTX 4090."
}

data "vastai_offers" "imagegen" {
  query = jsonencode(merge({
    datacenter        = { eq = true }
    gpu_arch          = { eq = "nvidia" }
    cpu_arch          = { eq = "amd64" }
    cuda_max_good     = { gte = 12.9 }
    verified          = { eq = true }
    rentable          = { eq = true }
    rented            = { eq = false }
    num_gpus          = { eq = 1 }
    gpu_ram           = { gte = var.min_gpu_ram_gb * 1024 }
    reliability       = { gte = 0.99 }
    direct_port_count = { gte = var.access_mode == "exposed" ? 2 : 1 }
    disk_space        = { gte = var.disk_gb }
    allocated_storage = var.disk_gb
    dph_total         = { lte = var.max_hourly_price }
    type              = "on-demand"
    order             = [["dph_total", "asc"]]
    limit             = 1
  }, var.gpu_name == null ? {} : { gpu_name = { eq = var.gpu_name } }, var.offer_id == null ? {} : { id = { eq = var.offer_id } }))

  lifecycle {
    postcondition {
      condition     = length(self.offers) > 0
      error_message = "No verified datacenter GPU offer matches the requested memory, storage, connectivity, and hourly price limit."
    }
    postcondition {
      condition     = alltrue([for offer in self.offers : offer.hourly_price <= var.max_hourly_price && offer.gpu_ram_mb >= var.min_gpu_ram_gb * 1024 && offer.num_gpus == 1])
      error_message = "The returned offer exceeds the hourly price limit or does not meet GPU requirements."
    }
    postcondition {
      condition     = alltrue([for offer in self.offers : offer.hosting_type == 1 && offer.verification == "verified"])
      error_message = "The returned offer must confirm certified datacenter hosting_type=1 and verified status; missing tier metadata is rejected."
    }
    postcondition {
      condition     = var.offer_id == null ? true : alltrue([for offer in self.offers : offer.id == var.offer_id])
      error_message = "The returned offer does not match the requested offer ID."
    }
  }
}

variable "template_hash_id" {
  type        = string
  default     = null
  description = "Optional reviewed Vast template hash with environment-only options. Omit to use the selected image without inheriting any template configuration."
  validation {
    condition     = var.template_hash_id == null ? true : can(regex("^[0-9a-f]{32}$", var.template_hash_id))
    error_message = "template_hash_id must be a 32-character lowercase hexadecimal hash."
  }
}

variable "disk_gb" {
  type        = number
  default     = 100
  description = "Local storage in GB. Vast recommends at least 50 GB, or 100 GB for multiple models."
  nullable    = false

  validation {
    condition     = var.disk_gb > 0
    error_message = "disk_gb must be positive."
  }
}

variable "label" {
  type        = string
  default     = "imagegen"
  description = "Mutable instance label."
  nullable    = false
}

variable "state" {
  type        = string
  default     = "running"
  description = "Desired power state. Stopped instances still incur storage charges."
  nullable    = false

  validation {
    condition     = contains(["running", "stopped"], var.state)
    error_message = "state must be running or stopped."
  }
}

variable "local_port" {
  type        = number
  default     = 7860
  description = "Local loopback port used by the SSH forwarding command; no remote port is published."
  nullable    = false

  validation {
    condition     = var.local_port >= 1024 && var.local_port <= 65535 && floor(var.local_port) == var.local_port
    error_message = "local_port must be an integer from 1024 to 65535."
  }
}

data "vastai_template" "imagegen" {
  count   = var.template_hash_id == null ? 0 : 1
  hash_id = var.template_hash_id
}

resource "vastai_instance" "imagegen" {
  offer_id         = data.vastai_offers.imagegen.offers[0].id
  template_hash_id = var.template_hash_id == null ? "" : var.template_hash_id
  image            = var.image
  disk_gb          = var.disk_gb
  label            = var.label
  state            = var.state
  runtype          = "ssh_direct"

  docker_options = var.access_mode == "exposed" ? "-p 7860:7860" : ""
  onstart = templatefile("${path.module}/startup.sh.tftpl", {
    model_manifest_b64 = base64encode(local.model_manifest)
    runtime            = var.runtime
    runtime_files      = { for path, content in var.runtime_files : path => base64encode(content) }
    exposed            = var.access_mode == "exposed"
    web_username       = var.web_username
    web_password       = var.web_password == null ? "" : var.web_password
  })

  lifecycle {
    # Marketplace changes must not replace an existing paid contract.
    ignore_changes = [offer_id]

    precondition {
      condition     = alltrue([for model in var.model_downloads : contains(keys(var.runtime.model_directories), model.kind)])
      error_message = "The selected runtime must define a destination for each model kind."
    }

    precondition {
      condition     = var.access_mode != "exposed" || var.web_password != null
      error_message = "exposed mode requires a generated web_password."
    }

    precondition {
      condition     = var.template_hash_id == null ? true : data.vastai_template.imagegen[0].environment_only
      error_message = "Template Docker options must contain only environment assignments. Remove all -p, -P, --publish, networking, and other Docker flags from a reviewed copy of the template."
    }
  }
}

output "instance_id" {
  value       = vastai_instance.imagegen.id
  description = "Rental contract ID."
}

output "ssh_host" {
  value       = vastai_instance.imagegen.ssh_host
  description = "SSH host; null until observed by a refresh."
}

output "ssh_port" {
  value       = vastai_instance.imagegen.ssh_port
  description = "Mapped SSH port; null until observed by a refresh."
}

output "ssh_forward_command" {
  value = (vastai_instance.imagegen.ssh_host == null || vastai_instance.imagegen.ssh_port == null) ? null : format(
    "ssh -N -o ExitOnForwardFailure=yes -L 127.0.0.1:%d:127.0.0.1:%d -p %d root@'%s'",
    var.local_port, var.runtime.port, vastai_instance.imagegen.ssh_port, replace(vastai_instance.imagegen.ssh_host, "'", "'\"'\"'"),
  )
  description = "Run locally after SSH is ready, then open local_url. Uses the caller's SSH agent or normal SSH identity configuration."
}

output "local_url" {
  value       = "http://127.0.0.1:${var.local_port}"
  description = "Application URL available only while the SSH forwarding command is running."
}

output "https_url" {
  value = var.access_mode != "exposed" ? null : (
    vastai_instance.imagegen.public_ip == null ? null : (
      lookup(vastai_instance.imagegen.mapped_ports, "7860/tcp", null) == null ? null :
      "https://${vastai_instance.imagegen.public_ip}:${vastai_instance.imagegen.mapped_ports["7860/tcp"]}"
    )
  )
  description = "Direct application HTTPS URL after refresh observes the public IP and mapped 7860/tcp port. Verify the instance certificate before sending credentials."
}
