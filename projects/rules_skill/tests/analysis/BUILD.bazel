load("//skill:defs.bzl", "skill_discovery_links", "skill_library")
load(
    "//skill/internal:skill_discovery_links.bzl",
    "skill_discovery_links_updater",
)
load(
    ":analysis_test.bzl",
    "skill_discovery_links_failure_test",
    "skill_discovery_links_test",
    "skill_library_aspect_test",
    "skill_library_failure_test",
    "skill_library_files_test",
    "skill_library_generated_files_test",
    "skill_library_without_openai_test",
)
load(":discovery_test.bzl", "skill_discovery_updater_test")

skill_library(
    name = "library",
    testonly = True,
    srcs = [
        "SKILL.md",
        "agents/openai.yaml",
        "reference.txt",
    ],
)

skill_discovery_links(
    name = "fixture_links",
    testonly = True,
    discovery_dir = "tests/discovery",
    skills = [":library"],
    tags = ["manual"],
)

skill_discovery_links_updater(
    name = "duplicate_links",
    testonly = True,
    discovery_dir = "tests/discovery",
    skills = [
        ":library",
        ":without_openai",
    ],
    tags = ["manual"],
)

skill_discovery_links_updater(
    name = "generated_links",
    testonly = True,
    discovery_dir = "tests/discovery",
    skills = ["//tests/analysis/generated:library"],
    tags = ["manual"],
)

skill_discovery_links_updater(
    name = "unsafe_discovery_links",
    testonly = True,
    discovery_dir = "../discovery",
    skills = [":library"],
    tags = ["manual"],
)

skill_library(
    name = "without_openai",
    testonly = True,
    srcs = [
        "SKILL.md",
        "reference.txt",
    ],
)

skill_library(
    name = "missing_skill",
    testonly = True,
    srcs = ["reference.txt"],
    tags = ["manual"],
)

filegroup(
    name = "skill_alias",
    srcs = ["SKILL.md"],
    tags = ["manual"],
)

skill_library(
    name = "duplicate_path",
    testonly = True,
    srcs = [
        "SKILL.md",
        ":skill_alias",
    ],
    tags = ["manual"],
)

skill_library_files_test(
    name = "skill_library_files_test",
    target_under_test = ":library",
)

skill_library_without_openai_test(
    name = "skill_library_without_openai_test",
    target_under_test = ":without_openai",
)

skill_library_generated_files_test(
    name = "skill_library_generated_files_test",
    target_under_test = "//tests/analysis/generated:library",
)

skill_library_failure_test(
    name = "duplicate_path_test",
    expected_message = "skill_library has duplicate logical path SKILL.md",
    target_under_test = ":duplicate_path",
)

skill_discovery_links_test(
    name = "skill_discovery_links_analysis_test",
    expected_basename = "fixture_links.sh",
    target_under_test = ":fixture_links",
)

skill_discovery_links_test(
    name = "skill_discovery_links_checker_analysis_test",
    expected_basename = "fixture_links_test.sh",
    target_under_test = ":fixture_links_test",
)

skill_discovery_links_failure_test(
    name = "skill_discovery_duplicate_name_test",
    expected_message = "skill discovery links have duplicate name analysis",
    target_under_test = ":duplicate_links",
)

skill_discovery_links_failure_test(
    name = "skill_discovery_generated_skill_test",
    expected_message = "skill discovery links require a source SKILL.md",
    target_under_test = ":generated_links",
)

skill_discovery_links_failure_test(
    name = "skill_discovery_unsafe_directory_test",
    expected_message = (
        "discovery_dir must be normalized and must not contain empty, '.' " +
        "or '..' segments"
    ),
    target_under_test = ":unsafe_discovery_links",
)

skill_discovery_updater_test(
    name = "skill_discovery_updater_test",
    updater = ":fixture_links",
)

skill_library_failure_test(
    name = "missing_skill_test",
    expected_message = "skill_library requires exactly one SKILL.md in srcs",
    target_under_test = ":missing_skill",
)

skill_library_failure_test(
    name = "nested_skill_test",
    expected_message = "skill_library requires exactly one SKILL.md in srcs",
    target_under_test = "//tests/analysis/nested-skill:library",
)

skill_library_failure_test(
    name = "root_package_test",
    expected_message = (
        "skill_library cannot be declared in a repository root package; " +
        "move the skill to a named subpackage"
    ),
    target_under_test = "//:root_skill_fixture",
)

skill_library_aspect_test(
    name = "skill_library_aspect_test",
    target_under_test = ":library",
)

test_suite(
    name = "tests",
    tests = [
        ":duplicate_path_test",
        ":missing_skill_test",
        ":nested_skill_test",
        ":root_package_test",
        ":skill_discovery_duplicate_name_test",
        ":skill_discovery_generated_skill_test",
        ":skill_discovery_links_analysis_test",
        ":skill_discovery_links_checker_analysis_test",
        ":skill_discovery_unsafe_directory_test",
        ":skill_discovery_updater_test",
        ":skill_library_aspect_test",
        ":skill_library_files_test",
        ":skill_library_generated_files_test",
        ":skill_library_without_openai_test",
    ],
)
