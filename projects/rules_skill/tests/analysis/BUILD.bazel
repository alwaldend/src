load("//skill:defs.bzl", "skill_library")
load(
    ":analysis_test.bzl",
    "skill_library_aspect_test",
    "skill_library_failure_test",
    "skill_library_files_test",
    "skill_library_generated_files_test",
    "skill_library_without_openai_test",
)

skill_library(
    name = "library",
    testonly = True,
    srcs = [
        "SKILL.md",
        "agents/openai.yaml",
        "reference.txt",
    ],
)

skill_library(
    name = "without_openai",
    testonly = True,
    srcs = [
        "SKILL.md",
        "reference.txt",
    ],
)

skill_library(
    name = "missing_skill",
    testonly = True,
    srcs = ["reference.txt"],
    tags = ["manual"],
)

filegroup(
    name = "skill_alias",
    srcs = ["SKILL.md"],
    tags = ["manual"],
)

skill_library(
    name = "duplicate_path",
    testonly = True,
    srcs = [
        "SKILL.md",
        ":skill_alias",
    ],
    tags = ["manual"],
)

skill_library_files_test(
    name = "skill_library_files_test",
    target_under_test = ":library",
)

skill_library_without_openai_test(
    name = "skill_library_without_openai_test",
    target_under_test = ":without_openai",
)

skill_library_generated_files_test(
    name = "skill_library_generated_files_test",
    target_under_test = "//tests/analysis/generated:library",
)

skill_library_failure_test(
    name = "duplicate_path_test",
    expected_message = "skill_library has duplicate logical path SKILL.md",
    target_under_test = ":duplicate_path",
)

skill_library_failure_test(
    name = "missing_skill_test",
    expected_message = "skill_library requires exactly one SKILL.md in srcs",
    target_under_test = ":missing_skill",
)

skill_library_failure_test(
    name = "nested_skill_test",
    expected_message = "skill_library requires exactly one SKILL.md in srcs",
    target_under_test = "//tests/analysis/nested-skill:library",
)

skill_library_failure_test(
    name = "root_package_test",
    expected_message = (
        "skill_library cannot be declared in a repository root package; " +
        "move the skill to a named subpackage"
    ),
    target_under_test = "//:root_skill_fixture",
)

skill_library_aspect_test(
    name = "skill_library_aspect_test",
    target_under_test = ":library",
)

test_suite(
    name = "tests",
    tests = [
        ":duplicate_path_test",
        ":missing_skill_test",
        ":nested_skill_test",
        ":root_package_test",
        ":skill_library_aspect_test",
        ":skill_library_files_test",
        ":skill_library_generated_files_test",
        ":skill_library_without_openai_test",
    ],
)
