module(
    name = "rules_promptfoo",
    version = "0.0.0",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "aspect_rules_js", version = "2.8.3")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_docs", version = "0.0.0")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_skill", version = "0.0.0")

local_path_override(
    module_name = "rules_docs",
    path = "../rules_docs",
)

local_path_override(
    module_name = "rules_skill",
    path = "../rules_skill",
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    node_version = "24.13.0",
)

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "rules_promptfoo_npm",
    data = [
        "//:patches/promptfoo@0.122.2.patch",
        "//:pnpm-workspace.yaml",
    ],
    no_optional = True,
    pnpm_lock = "//:pnpm-lock.yaml",
    run_lifecycle_hooks = False,
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "rules_promptfoo_npm")
