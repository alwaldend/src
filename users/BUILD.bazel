load("@rules_docs//docs:defs.bzl", "docs_filegroup")

package(transitive_visibility = "//users:transitive_consumers")

package_group(
    name = "transitive_consumers",
    packages = [
        "//",
        "//.agents/...",
        "//infra/...",
        "//third_party/...",
        "//tools/...",
        "//users/...",
        # Website documentation and explicit documentation update commands.
        "//projects/alwaldend.com/...",
    ],
)

filegroup(
    name = "dnsconfig",
    srcs = ["//users/simeonwarren:dnsconfig"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
