load("@rules_docs//docs:defs.bzl", "docs_filegroup")

filegroup(
    name = "dnsconfig",
    srcs = ["//users/simeonwarren:dnsconfig"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//:repository_docs_consumers"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)
