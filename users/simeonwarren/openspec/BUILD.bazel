load("//tools/rules_docs/docs:defs.bzl", "docs_filegroup")
load("//tools/rules_openspec/rules:defs.bzl", "openspec_validate_test", "openspec_workspace")

package(transitive_visibility = "//users:transitive_consumers")

openspec_workspace(
    name = "source",
    srcs = glob(
        [
            "specs/**/*.md",
            "changes/**",
        ],
        allow_empty = True,
    ),
    config = "config.yaml",
)

docs_filegroup(
    name = "docs",
    srcs = glob(
        ["specs/**/*.md"],
        allow_empty = True,
    ),
    preserve_paths = True,
    visibility = ["//users/simeonwarren:__pkg__"],
)

openspec_validate_test(
    name = "validate_test",
    source = ":source",
)
