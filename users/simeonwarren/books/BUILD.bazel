load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//tools/toml/rules:al_toml_data.bzl", "al_toml_data")

package(transitive_visibility = "//users:transitive_consumers")

filegroup(
    name = "covers",
    srcs = glob([
        "*.jpeg",
        "*.jpg",
        "*.png",
    ]),
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]) + [
        ":authors",
        ":books",
        ":covers",
    ],
    visibility = ["//users/simeonwarren:__pkg__"],
)

al_toml_data(
    name = "authors",
    srcs = ["authors.toml"],
)

al_toml_data(
    name = "books",
    srcs = ["books.toml"],
)
