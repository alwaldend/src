load("//tools/docs:defs.bzl", "docs_filegroup")
load("//tools/terraform:defs.bzl", "terraform_binary_map", "terraform_test_map")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//users/simeonwarren/hermes:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

_CONFIGS = ["//users/simeonwarren/hermes:al"]

_RUN_ARGS = [
    "--plugin_label",
    "tf=setup",
]

_DATA = glob(["*.tf"]) + [
    ".terraform.lock.hcl",
    "//users/simeonwarren/hermes:dnsconfig",
    "//users/simeonwarren/hermes/ansible:inventory",
    "//infra/pve/ansible:cloud_init",
    "//tools/vault/tf_backend",
    "//tools/vault/injector",
]

terraform_binary_map(
    name = "tf_setup",
    configs = _CONFIGS,
    data = _DATA,
    run_args = _RUN_ARGS,
)

terraform_test_map(
    name = "tf_tests",
    configs = _CONFIGS,
    data = _DATA,
)
