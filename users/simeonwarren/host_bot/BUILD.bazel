load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/al/rules/al:al_config.bzl", "al_config")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg")
load("//tools/mermaid:defs.bzl", "mermaid_svg")

al_config(
    name = "al",
    srcs = ["al.lua"],
    visibility = ["//users/simeonwarren/host_bot:__subpackages__"],
    deps = ["//infra:al"],
)

al_config(
    name = "dns_al",
    srcs = ["dns.al.lua"],
    visibility = ["//users/simeonwarren/host_bot/tf:__pkg__"],
    deps = ["//infra:al"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
        "//users/simeonwarren/host_bot/tf:__pkg__",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]) + ["t3code-architecture.mmd"],
    visibility = ["//users/simeonwarren:__pkg__"],
    deps = [":docs_assets"] + subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

mermaid_svg(
    name = "rendered",
    src = "t3code-architecture.mmd",
    out = "rendered/t3code-architecture.svg",
    visibility = [
        # The blog post that documents this migration publishes the same
        # diagram, so the post depends on the target that renders it rather
        # than on a hand-written URL that can drift.
        "//projects/alwaldend.com/content/blog/diagrams-in-ac-era:__pkg__",
    ],
)

# Mermaid's own defaults, for comparing the themed diagram against upstream.
# Not published and not hermetic; see tools/mermaid/README.md.
mermaid_svg(
    name = "rendered_plain",
    src = "t3code-architecture.mmd",
    out = "rendered/plain/t3code-architecture.svg",
    plain = True,
)

mermaid_site_svg(
    name = "rendered_site",
    src = "t3code-architecture.mmd",
    out = "rendered/site/t3code-architecture.svg",
)

docs_filegroup(
    name = "docs_assets",
    srcs = [":rendered_site"],
    prefix = "content/docs/users/simeonwarren/host_bot/assets",
)
