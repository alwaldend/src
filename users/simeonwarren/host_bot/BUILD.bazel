load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//projects/al/rules/al:al_config.bzl", "al_config")
load("//tools/mermaid:defs.bzl", "mermaid_svg")

al_config(
    name = "al",
    srcs = ["al.lua"],
    visibility = ["//users/simeonwarren/host_bot:__subpackages__"],
    deps = ["//infra:al"],
)

al_config(
    name = "dns_al",
    srcs = ["dns.al.lua"],
    visibility = ["//users/simeonwarren/host_bot/tf:__pkg__"],
    deps = ["//infra:al"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
        "//users/simeonwarren/host_bot/tf:__pkg__",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]) + ["t3code-architecture.mmd"],
    visibility = ["//users/simeonwarren:__pkg__"],
    deps = [":docs_assets"] + subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

docs_filegroup(
    name = "docs_assets",
    srcs = glob(
        ["assets/*.svg"],
        allow_empty = True,
    ),
    prefix = "content/docs/users/simeonwarren/host_bot/assets",
)

mermaid_svg(
    name = "rendered",
    src = "t3code-architecture.mmd",
    out = "rendered/t3code-architecture.svg",
)

write_source_files(
    name = "update",
    files = {
        "assets/t3code-architecture.svg": ":rendered/t3code-architecture.svg",
    },
)
