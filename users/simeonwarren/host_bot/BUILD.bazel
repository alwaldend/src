load("@rules_al//:defs.bzl", "al_config", "al_inject", "al_vault_auth")
load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("//infra:al_config.bzl", "infra_ansible_keys", "infra_dns")
load("//projects/alwaldend.com/pkg/mermaid:defs.bzl", "mermaid_site_svg")
load("//tools/mermaid:defs.bzl", "mermaid_svg")
load("//tools/vault/tf_backend:defs.bzl", "vault_tf_backend")

package(transitive_visibility = "//users:transitive_consumers")

al_vault_auth(
    name = "auth",
    approle = "user_simeonwarren",
    extends = "//tools/al:auth",
)

infra_ansible_keys(
    name = "ansible_keys",
    labels = {"ansible": "1"},
    vault_ssh = {
        "backend": "ssh/clients/sign/admins",
        "ttl": 7200,
    },
)

al_inject(
    name = "openhands",
    labels = {"ansible": "1"},
    res_env = {"OPENHANDS_SERVER_SECRET_KEY": {
        "value": "{{ .Last.Data.secret_key }}",
        "deps": ["openhands"],
    }},
    res_kv = {"openhands": {
        "mount": "secrets",
        "path": "alwaldend.com/vault1/approles/user_simeonwarren/openhands",
    }},
)

al_config(
    name = "al",
    configs = [
        ":ansible_keys",
        ":auth",
        ":openhands",
        "//infra:al",
    ],
    visibility = ["//users/simeonwarren/host_bot:__subpackages__"],
)

al_vault_auth(
    name = "dns_al.vault_auth.default",
    approle = "src_users_simeonwarren_host_bot",
    extends = "//tools/al:auth",
)

vault_tf_backend(
    name = "tf_backend",
    labels = {"tf": "main"},
    path = "alwaldend.com/vault1/approles/src_users_simeonwarren_host_bot/tf_backend/tf",
)

infra_dns(
    name = "dns_providers",
    dc1 = True,
    labels = {"tf": "main"},
)

al_config(
    name = "dns_al",
    configs = [
        ":dns_al.vault_auth.default",
        ":dns_providers",
        ":tf_backend",
        "//infra:al",
    ],
    visibility = ["//users/simeonwarren/host_bot/tf:__pkg__"],
)

filegroup(
    name = "dnsconfig",
    srcs = ["dnsconfig.json"],
    visibility = [
        "//infra:__pkg__",
        "//infra/dns:__pkg__",
        "//users/simeonwarren/host_bot/tf:__pkg__",
    ],
)

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]) + [
        "docs/comfyui-architecture.mmd",
        "t3code-architecture.mmd",
    ],
    visibility = ["//users/simeonwarren:__pkg__"],
    deps = [":docs_assets"] + subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

mermaid_site_svg(
    name = "rendered",
    src = "t3code-architecture.mmd",
    out = "rendered/t3code-architecture.svg",
)

mermaid_svg(
    name = "rendered_historical",
    src = "t3code-architecture.mmd",
    out = "rendered/historical/t3code-architecture.svg",
    visibility = [
        # Preserve the original image published by the diagram-migration post.
        "//projects/alwaldend.com/content/blog/diagrams-in-ac-era:__pkg__",
    ],
)

# Mermaid's own defaults, for comparing the themed diagram against upstream.
# Not published and not hermetic; see tools/mermaid/README.md.
mermaid_svg(
    name = "rendered_plain",
    src = "t3code-architecture.mmd",
    out = "rendered/plain/t3code-architecture.svg",
    plain = True,
)

alias(
    name = "rendered_site",
    actual = ":rendered",
)

mermaid_site_svg(
    name = "rendered_comfyui",
    src = "docs/comfyui-architecture.mmd",
    out = "rendered/comfyui-architecture.svg",
)

alias(
    name = "rendered_comfyui_site",
    actual = ":rendered_comfyui",
)

docs_filegroup(
    name = "docs_assets",
    srcs = [
        ":rendered",
        ":rendered_comfyui",
    ],
    prefix = "content/docs/users/simeonwarren/host_bot/assets",
)
