load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_terraform//terraform:defs.bzl", "terraform_test_map")
load("//tools/al:al_terraform.bzl", "al_terraform_binary_map")

package(transitive_visibility = "//users:transitive_consumers")

_PROVIDERS = [
    "@terraform_provider_cloudflare_cloudflare//:provider",
    "@terraform_provider_terraform_routeros_routeros//:provider",
]

_DATA = glob(["*.tf"]) + [
    "//users/simeonwarren/host_bot:dnsconfig",
    "//projects/tf_modules/dns_records:dns_records",
]

al_terraform_binary_map(
    name = "tf",
    configs = ["//users/simeonwarren/host_bot:dns_al"],
    data = _DATA,
    plugin_labels = {"tf": "main"},
    providers = _PROVIDERS,
)

terraform_test_map(
    name = "tf_tests",
    data = _DATA,
    providers = _PROVIDERS,
)

docs_filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//users/simeonwarren/host_bot:__pkg__"],
)
