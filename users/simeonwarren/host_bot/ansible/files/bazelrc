startup --output_user_root=/var/cache/bazel/output_user_root
common --repo_env=ANDROID_HOME=/var/home/simeonwarrenbot/Android/Sdk
common --repo_env=ANDROID_NDK_HOME=/var/home/simeonwarrenbot/Android/Sdk/ndk/29.0.14206865
common --disk_cache=/var/cache/bazel/disk_cache
common --experimental_disk_cache_gc_max_size=700G
# Share materialized external repositories across output bases so a new
# worktree does not re-extract large toolchains such as the pinned LLVM
# distribution. The repository cache still avoids the network download.
common --repo_contents_cache=/var/cache/bazel/repo_contents_cache
# Keep only the completed Go repositories in Bazel's shared contents cache;
# discard Gazelle's temporary module downloads after each repository fetch.
common --repo_env=GO_REPOSITORY_EPHEMERAL_MODCACHE=1
build --local_resources=cpu=HOST_CPUS*0.25
build --jobs=4

# Agent output defaults. This block is portable to another user's ~/.bazelrc.
common --color=no
common --curses=no
build --experimental_ui_max_stdouterr_bytes=1048576
build --show_progress
build --show_progress_rate_limit=5
build --show_timestamps
test --max_test_output_bytes=1048576
test --test_summary=terse
test --test_output=errors
