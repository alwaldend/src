load("@rules_docs//docs:defs.bzl", "docs_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//projects/al/rules/al:al_binary.bzl", "al_binary_run_map")
load("//tools/ansible/main/bzl:al_ansible_binary.bzl", "al_ansible_binary")

docs_filegroup(
    name = "docs",
    srcs = glob(["*.md"]),
    visibility = ["//users/simeonwarren/host_bot:__pkg__"],
    deps = subpackages(
        include = ["*"],
        allow_empty = True,
    ),
)

al_binary_run_map(
    name = "ansible",
    args = {"": [
        "$(rootpath :ansible_bin)",
        "--inventory",
        "inventory.yaml",
        "playbook_deploy.yaml",
    ]},
    configs = ["//users/simeonwarren/host_bot:al"],
    data = [
        ":ansible_bin",
        "//tools/vault/injector",
    ],
    run_args = [
        "--plugin_label",
        "vault_env=default_default",
        "--plugin_label",
        "ansible",
    ],
)

al_ansible_binary(
    name = "ansible_bin",
    data = [
        ":srcs",
        "//infra:ansible_cfg",
        "//projects/ansible_collection:collections",
    ],
    process_name = "ansible_playbook",
)

pkg_filegroup(
    name = "srcs",
    srcs = [":srcs_files"],
)

pkg_files(
    name = "srcs_files",
    srcs = [
        "inventory.yaml",
        "//projects/bazel_agent",
        "@com_github_bazelbuild_bazelisk_linux_x86_64//:bazelisk_filegroup",
    ] + glob([
        "group_vars/**/*.yaml",
        "files/**",
        "playbook_*.yaml",
    ]),
    renames = {
        "@com_github_bazelbuild_bazelisk_linux_x86_64//:bazelisk_filegroup": "files/bazelisk",
        "//projects/bazel_agent": "files/bazel_agent",
    },
    strip_prefix = strip_prefix.from_pkg(),
)
